заметка Игровые правила Лексики, столкновения, карта и поиск пути.
заметка Подключайте так, подключить игры. Встроенные действия (синус, вектор,
заметка холст, треугольник) даёт сам исполнитель, здесь только логика на Лексике.

правило прямоугольники(аикс, аигрек, аширина, авысота, бикс, бигрек, бширина, бвысота) {
    если (аикс + аширина не больше бикс) {
        вернуть(ложь).
    }
    если (бикс + бширина не больше аикс) {
        вернуть(ложь).
    }
    если (аигрек + авысота не больше бигрек) {
        вернуть(ложь).
    }
    если (бигрек + бширина не больше аигрек) {
        вернуть(ложь).
    }
    вернуть(истина).
}

правило круги(аикс, аигрек, арадиус, бикс, бигрек, брадиус) {
    пусть разницаикс = аикс - бикс.
    пусть разницаигрек = аигрек - бигрек.
    пусть предел = арадиус + брадиус.
    вернуть(разницаикс * разницаикс + разницаигрек * разницаигрек не больше предел * предел).
}

правило точкав(пикс, пигрек, икс, игрек, ширина, высота) {
    если (пикс меньше икс) {
        вернуть(ложь).
    }
    если (пигрек меньше игрек) {
        вернуть(ложь).
    }
    если (пикс не меньше икс + ширина) {
        вернуть(ложь).
    }
    если (пигрек не меньше игрек + высота) {
        вернуть(ложь).
    }
    вернуть(истина).
}

правило проходимо(карта, ширина, высота, место, стена) {
    если (место меньше нуля) {
        вернуть(ложь).
    }
    если (место не меньше ширина * высота) {
        вернуть(ложь).
    }
    пусть значение = взять из перечня карта номер место.
    вернуть(значение не равно стена).
}

правило соседи(место, ширина, высота) {
    пусть собранные = перечень().
    пусть клеткаикс = остаток(место, ширина).
    пусть клеткаигрек = целое(место / ширина).
    если (клеткаикс больше нуля) {
        добавить в собранные место - 1.
    }
    если (клеткаикс меньше ширина - 1) {
        добавить в собранные место + 1.
    }
    если (клеткаигрек больше нуля) {
        добавить в собранные место - ширина.
    }
    если (клеткаигрек меньше высота - 1) {
        добавить в собранные место + ширина.
    }
    вернуть(собранные).
}

правило путьпокарте(карта, ширина, высота, старт, цель, стена) {
    заметка Поиск в ширину, без весов и эвристик, зато без сортировок и словарей-оценок.
    пусть пустой = перечень().
    если (старт равно цель) {
        добавить в пустой старт.
        вернуть(пустой).
    }
    если (не проходимо(карта, ширина, высота, цель, стена)) {
        вернуть(пустой).
    }
    пусть откуда = словарь().
    пусть очередь = перечень().
    добавить в очередь старт.
    пусть найдено = ложь.
    пока (длина очередь больше нуля) {
        пусть текущая = взять из перечня очередь номер 0.
        убрать из перечня очередь номер 0.
        если (текущая равно цель) {
            найдено = истина.
            прервать.
        }
        для каждого гость из соседи(текущая, ширина, высота) {
            если (не проходимо(карта, ширина, высота, гость, стена)) {
                продолжить.
            }
            если (откуда содержит гость) {
                продолжить.
            }
            записать в откуда по ключу гость текущая.
            добавить в очередь гость.
        }
    }
    пусть дорога = перечень().
    если (не найдено) {
        вернуть(дорога).
    }
    пусть шаг = цель.
    добавить в дорога шаг.
    пока (шаг не равно старт) {
        шаг = прочитать из откуда по ключу шаг.
        добавить в дорога шаг.
    }
    заметка Разворачиваем путь, чтобы он шёл от старта к цели.
    пусть прямой = перечень().
    пусть номер = длина дорога - 1.
    пока (номер не меньше нуля) {
        добавить в прямой взять из перечня дорога номер номер.
        номер = номер - 1.
    }
    вернуть(прямой).
}

правило вэкран(место, ширина, клетка) {
    заметка Номер клетки карты в левый верхний угол экрана.
    пусть клеткаикс = остаток(место, ширина).
    пусть клеткаигрек = целое(место / ширина).
    пусть пара = перечень().
    добавить в пара клеткаикс * клетка.
    добавить в пара клеткаигрек * клетка.
    вернуть(пара).
}

правило камера(местоикс, местоигрек, камераикс, камераигрек, ширинаэкрана, высотаэкрана) {
    заметка Куда попадёт точка мира на экране, если камера смотрит по центру.
    пусть пара = перечень().
    добавить в пара местоикс - камераикс + ширинаэкрана / 2.
    добавить в пара местоигрек - камераигрек + высотаэкрана / 2.
    вернуть(пара).
}
