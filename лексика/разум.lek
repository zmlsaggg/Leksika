import math

from . import файлы, морфология

РАЗМЕР = 8192
ГЛАСНЫЕ = "аеёиоуыэюя"
ЗВОНКИЕ = "бвгджзлмнрй"
ШИПЯЩИЕ = "жчшщ"
СВОИ_ВЕСА = "разум.веса"

_ОБЩЕЕ = {}


def признаки(слово):
    слово = (слово or "").lower().strip(".,!?()")
    if not слово:
        return ["пусто"]
    итог = []
    for длина in (1, 2, 3, 4, 5):
        if len(слово) >= длина:
            итог.append("к" + str(длина) + слово[-длина:])
    итог.append("д" + str(min(len(слово), 14)))
    итог.append("п" + слово[0])
    гласная = ""
    отступ = 0
    for знак in reversed(слово):
        if знак in ГЛАСНЫЕ:
            гласная = знак
            break
        отступ += 1
    итог.append("г" + гласная + str(min(отступ, 4)))
    последняя = слово[-1]
    if последняя in ГЛАСНЫЕ:
        итог.append("гласная")
    elif последняя in ШИПЯЩИЕ:
        итог.append("шипящая")
    elif последняя in ЗВОНКИЕ:
        итог.append("звонкая")
    else:
        итог.append("глухая")
    if слово.endswith(("ость", "есть", "адь", "ель", "ыль", "знь", "сть")):
        итог.append("мягкий_женский")
    if слово.endswith(("ение", "ание", "ние", "ие", "ье")):
        итог.append("средний_ние")
    if слово.endswith(("мя",)):
        итог.append("средний_мя")
    return итог


def номер(признак):
    хеш = 0xCBF29CE484222325
    for байт in признак.encode("utf-8"):
        хеш = ((хеш ^ байт) * 0x100000001B3) & 0xFFFFFFFFFFFFFFFF
    return хеш % РАЗМЕР


def _мягкое(значения):
    самое = max(значения)
    степени = [math.exp(значение - самое) for значение in значения]
    сумма = sum(степени)
    return [степень / сумма for степень in степени]


class Разум:
    def __init__(self, классы, перекос, веса, роды, род_перекос, род_веса, путь=""):
        self.классы = list(классы)
        self.перекос = list(перекос)
        self.веса = веса
        self.роды = list(роды)
        self.род_перекос = list(род_перекос)
        self.род_веса = род_веса
        self.путь = путь
        self.память = {}

    def разобрать(self, слово, контекст=""):
        ключ = (слово, контекст)
        if ключ in self.память:
            return self.память[ключ]
        итог = self._разобрать(слово, контекст)
        self.память[ключ] = итог
        return итог

    def _разобрать(self, слово, контекст):
        значения = list(self.перекос)
        for признак in признаки(слово):
            строка = self.веса.get(номер(признак))
            if not строка:
                continue
            for позиция, вес in enumerate(строка):
                значения[позиция] += вес
        if контекст:
            for признак in self._от_предлога(контекст):
                строка = self.веса.get(номер(признак))
                if not строка:
                    continue
                for позиция, вес in enumerate(строка):
                    значения[позиция] += 0.5 * вес
        вероятности = _мягкое(значения)
        порядок = sorted(range(len(self.классы)), key=lambda i: -вероятности[i])
        итог = []
        for позиция in порядок:
            падеж, число = self.классы[позиция].split(":")
            итог.append(((слово, падеж, число), вероятности[позиция]))
        return итог

    def _от_предлога(self, контекст):
        наречия = морфология.ПАДЕЖИ
        подсказки = {
            "в": ["к2в", "предлог_в"],
            "во": ["к3во", "предлог_в"],
            "на": ["к3на", "предлог_на"],
            "из": ["к3из", "предлог_из"],
            "от": ["к3от", "предлог_от"],
            "к": ["к2к", "предлог_к"],
            "по": ["к3по", "предлог_по"],
            "с": ["к2с", "предлог_с"],
            "до": ["к3до", "предлог_до"],
        }
        слово = (контекст or "").strip().lower()
        if слово not in подсказки:
            return []
        return подсказки[слово]

    def род(self, слово):
        if not self.роды:
            return "м"
        значения = list(self.род_перекос)
        for признак in признаки(слово):
            строка = self.род_веса.get(номер(признак))
            if not строка:
                continue
            for позиция, вес in enumerate(строка):
                значения[позиция] += вес
        вероятности = _мягкое(значения)
        лучший = max(range(len(self.роды)), key=lambda i: вероятности[i])
        return self.роды[лучший]

    def вес(self):
        return len(self.веса) + len(self.род_веса)


def читать(путь):
    классы, роды = [], []
    перекос, род_перекос = [], []
    веса, род_веса = {}, {}
    раздел = ""
    текст = файлы.прочитать(путь)
    for строка in текст.split("\n"):
        строка = строка.strip()
        if not строка:
            continue
        части = строка.split(" ")
        голова = части[0]
        if голова == "классы":
            классы = части[1:]
            раздел = "веса"
        elif голова == "роды":
            роды = части[1:]
            раздел = "роды"
        elif голова == "перекос":
            перекос = [float(значение) for значение in части[1:]]
        elif голова == "род_перекос":
            род_перекос = [float(значение) for значение in части[1:]]
        elif голова == "вес":
            веса[int(части[1])] = [float(значение) for значение in части[2:]]
        elif голова == "род_вес":
            род_веса[int(части[1])] = [float(значение) for значение in части[2:]]
        elif голова in ("разум", "признаков"):
            continue
        elif раздел == "веса" and голова.isdigit():
            веса[int(голова)] = [float(значение) for значение in части[1:]]
        elif раздел == "роды" and голова.isdigit():
            род_веса[int(голова)] = [float(значение) for значение in части[1:]]
    return Разум(классы, перекос, веса, роды, род_перекос, род_веса, путь)


def путь_к_весам():
    основа = файлы.папка(файлы.папка(файлы.полный(__file__)))
    свой = файлы.соединить(основа, "словари", СВОИ_ВЕСА)
    if файлы.файл(свой):
        return свой
    return None


def загрузить():
    if "разум" in _ОБЩЕЕ:
        return _ОБЩЕЕ["разум"]
    путь = путь_к_весам()
    разум = читать(путь) if путь else Разум([], [], [], [], [], [])
    _ОБЩЕЕ["разум"] = разум
    return разум


def сбросить():
    _ОБЩЕЕ.pop("разум", None)
