import os

ТАБЛИЦА = [
    ("зип", "zip", "сжатый набор файлов"),
    ("7з", "7z", "плотный сжатый набор"),
    ("рар", "rar", "сжатый набор"),
    ("тар", "tar", "набор файлов без сжатия"),
    ("гз", "gz", "одиночный сжатый файл"),
    ("трек3", "mp3", "звук"),
    ("волна", "wav", "звук без сжатия"),
    ("огг", "ogg", "звук"),
    ("флак", "flac", "звук без потерь"),
    ("вид4", "mp4", "видео"),
    ("вебм", "webm", "видео для сети"),
    ("матрешка", "mkv", "видео в оболочке"),
    ("пнг", "png", "картинка без потерь"),
    ("жпег", "jpg", "фотокартинка"),
    ("гиф", "gif", "подвижная картинка"),
    ("вебп", "webp", "картинка для сети"),
    ("вект", "svg", "векторная картинка"),
    ("значок", "ico", "значок приложения"),
    ("текст", "txt", "простой текст"),
    ("разметка", "md", "текст с разметкой"),
    ("страница", "html", "веб страница"),
    ("таблица", "csv", "таблица строками"),
    ("пдф", "pdf", "страница для печати"),
    ("жаба", "java", "исходник жабы"),
    ("запуск", "exe", "программа для окон"),
    ("патч", "патч", "наша заплатка"),
    ("настр", "настр", "наши настройки"),
]

_РУССКИЕ = {}
_ЧУЖИЕ = {}
for русское, чужое, толк in ТАБЛИЦА:
    _РУССКИЕ[чужое] = (русское, толк)
    _ЧУЖИЕ[русское] = (чужое, толк)


def расширение(имя):
    основа, точка, конец = имя.rpartition(".")
    if not точка or not основа:
        return ""
    return конец.lower()


def сменить(имя, конец):
    основа = имя.rpartition(".")[0] if "." in имя else имя
    return основа + "." + конец


def перевод(имя):
    конец = расширение(имя)
    запись = _РУССКИЕ.get(конец)
    if запись is None:
        return имя
    return сменить(имя, запись[0])


def обратно(имя):
    конец = расширение(имя)
    запись = _ЧУЖИЕ.get(конец)
    if запись is None:
        return имя
    return сменить(имя, запись[0])


def толк(имя):
    конец = расширение(имя)
    запись = _РУССКИЕ.get(конец) or _ЧУЖИЕ.get(конец)
    return запись[1] if запись else ""


def русское(имя):
    конец = расширение(имя)
    if конец in _ЧУЖИЕ:
        return конец
    запись = _РУССКИЕ.get(конец)
    return запись[0] if запись else ""


def настоящее(имя):
    конец = расширение(имя)
    if конец in _РУССКИЕ:
        return конец
    запись = _ЧУЖИЕ.get(конец)
    return запись[0] if запись else ""


def наш(имя):
    запись = _ЧУЖИЕ.get(расширение(имя))
    return bool(запись) and запись[0] == расширение(имя)


def таблица():
    return list(ТАБЛИЦА)


def переименовать(путь):
    новое = перевод(os.path.basename(путь))
    if новое == os.path.basename(путь):
        return путь, False
    цель = os.path.join(os.path.dirname(путь), новое)
    os.rename(путь, цель)
    return цель, True
