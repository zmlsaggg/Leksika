
ГЛАСНЫЕ = "аеёиоуыэюя"

ПАДЕЖИ = ("им", "рд", "дт", "вн", "тв", "пр")

ПАДЕЖ_ИМЯ = {
    "им": "именительный",
    "рд": "родительный",
    "дт": "дательный",
    "вн": "винительный",
    "тв": "творительный",
    "пр": "предложный",
}

НЕСКЛОНЯЕМЫЕ = {
    "метро", "пальто", "кофе", "такси", "кино", "радио", "шоссе", "депо",
    "жюри", "интервью", "меню", "резюме", "кенгуру", "ателье", "драже",
    "желе", "пианино", "домино", "салями", "бордо", "танго", "манго",
}

ШИПЯЩИЕ = ("ж", "ч", "ш", "щ", "ц")
ГУБНЫЕ_КА = ("г", "к", "х", "ж", "ч", "ш", "щ")



def склонять(лемма, род=None, одушевлённое=False):
    формы = {}

    def доб(word, падеж, число):
        if not word:
            return
        список = формы.setdefault(word, [])
        метка = (падеж, число)
        if метка not in список:
            список.append(метка)

    if not лемма:
        return формы
    if лемма in ("число", "числа"):
        for форма, падеж in zip(("число", "числа", "числу", "число", "числом", "числе"), ПАДЕЖИ):
            доб(форма, падеж, "ед")
        for форма, падеж in zip(("числа", "чисел", "числам", "числа", "числами", "числах"), ПАДЕЖИ):
            доб(форма, падеж, "мн")
        return формы
    if лемма in НЕСКЛОНЯЕМЫЕ:
        for падеж in ПАДЕЖИ:
            доб(лемма, падеж, "ед")
            доб(лемма, падеж, "мн")
        return формы

    множественное_имя = False
    кандидаты = [лемма]
    if len(лемма) > 3 and лемма.endswith(("ы", "и")) and not лемма.endswith(
        ("ий", "ия", "ие", "ье", "ья", "ии", "ые")
    ):
        множественное_имя = True
        основа = лемма[:-1]
        кандидаты = [основа, основа + "а"]

    for единственное in кандидаты:
        _единица(единственное, род, одушевлённое, доб)
        _множество(единственное, род, одушевлённое, доб)

    if множественное_имя:
        доб(лемма, "им", "мн")
        доб(лемма, "вн", "мн")
    return формы


def родительный_множественного(единственное):
    слово = единственное
    if слово.endswith("ка"):
        основа = слово[:-1]
        перед = основа[-2] if len(основа) >= 2 else ""
        if перед in ГЛАСНЫЕ or not перед:
            return основа
        return основа[:-1] + ("ек" if перед in "жчшщ" else "ок")
    if слово.endswith(("га", "ха", "жа", "ша", "ча", "ща")):
        основа = слово[:-1]
        перед = основа[-2] if len(основа) >= 2 else ""
        if перед in ГЛАСНЫЕ or not перед:
            return основа
        return основа[:-1] + "ек"
    if слово.endswith(("а", "я")):
        return слово[:-1]
    if слово.endswith(("о", "е")):
        return слово[:-1]
    if слово.endswith("ь"):
        return слово[:-1] + "ей"
    if слово.endswith("й"):
        return слово[:-1] + "ев"
    if слово.endswith("ец"):
        return слово[:-2] + "цев"
    основа = слово
    if основа.endswith(ШИПЯЩИЕ):
        return основа + "ей"
    return основа + "ов"


def _единица(слово, род, одушевлённое, доб):
    if not слово:
        return
    if слово.endswith(("а", "я")) and len(слово) > 2:
        мягк = слово.endswith(("я", "ия"))
        if слово.endswith("ия"):
            основа = слово[:-1]
            for п, w in (("им", слово), ("рд", основа + "и"), ("дт", основа + "и"),
                         ("вн", основа + "ю"), ("тв", основа + "ей"), ("пр", основа + "и")):
                доб(w, п, "ед")
            return
        основа = слово[:-1]
        if мягк:
            for п, w in (("им", слово), ("рд", основа + "и"), ("дт", основа + "е"),
                         ("вн", основа + "ю"), ("тв", основа + "ей"), ("пр", основа + "е")):
                доб(w, п, "ед")
        else:
            рд_ед = основа + ("и" if основа.endswith(ГУБНЫЕ_КА) else "ы")
            for п, w in (("им", слово), ("рд", рд_ед), ("дт", основа + "е"),
                         ("вн", основа + "у"), ("тв", основа + "ой"), ("пр", основа + "е")):
                доб(w, п, "ед")
        return

    if слово.endswith(("о", "е", "ё")):
        мягк = not слово.endswith("о")
        основа = слово[:-1]
        тв = основа + ("ем" if мягк else "ом")
        for п, w in (("им", слово), ("рд", слово), ("дт", слово), ("вн", слово),
                     ("тв", тв), ("пр", основа + "е")):
            доб(w, п, "ед")
        return

    if слово.endswith("ь"):
        основа = слово[:-1]
        if род == "ж":
            for п, w in (("им", слово), ("рд", основа + "и"), ("дт", основа + "и"),
                         ("вн", слово), ("тв", основа + "ью"), ("пр", основа + "и")):
                доб(w, п, "ед")
        else:
            if слово.endswith("ень") and len(слово) >= 4:
                основа = слово[:-3] + "н"
                тв = основа + "ем"
            elif слово.endswith("ец") and len(слово) > 3:
                основа = слово[:-2] + "ц"
                тв = основа + "ем"
            else:
                тв = основа + "ём"
            for п, w in (("им", слово), ("рд", основа + "я"), ("дт", основа + "ю"),
                         ("вн", слово), ("тв", тв), ("пр", основа + "е")):
                доб(w, п, "ед")
        return

    if слово.endswith("й"):
        основа = слово[:-1]
        for п, w in (("им", слово), ("рд", основа + "я"), ("дт", основа + "ю"),
                     ("вн", слово), ("тв", основа + "ем"), ("пр", основа + "е")):
            доб(w, п, "ед")
        return

    основа = слово
    if слово.endswith("ень") and len(слово) > 4:
        основа = слово[:-3] + "н"
    elif слово.endswith("ец") and len(слово) > 3:
        основа = слово[:-2] + "ц"
    винительный = основа + "а" if одушевлённое else слово
    for п, w in (("им", слово), ("рд", основа + "а"), ("дт", основа + "у"),
                 ("вн", винительный), ("тв", основа + "ом"), ("пр", основа + "е")):
        доб(w, п, "ед")


def _множество(слово, род, одушевлённое, доб):
    if not слово:
        return
    if слово.endswith("ия"):
        основа = слово[:-2]
        for п, w in (("им", основа + "ии"), ("рд", основа + "ий"), ("дт", основа + "иям"),
                     ("вн", основа + "ии"), ("тв", основа + "иями"), ("пр", основа + "иях")):
            доб(w, п, "мн")
        return
    if слово.endswith(("а", "я")):
        основа = слово[:-1]
        мягк = слово.endswith(("я", "ья"))
        им = основа + ("и" if мягк or основа.endswith(ГУБНЫЕ_КА) else "ы")
        рд = родительный_множественного(слово)
        for п, w in (("им", им), ("рд", рд), ("дт", основа + ("ям" if мягк else "ам")),
                     ("вн", им), ("тв", основа + ("ями" if мягк else "ами")),
                     ("пр", основа + ("ях" if мягк else "ах"))):
            доб(w, п, "мн")
        return
    if слово.endswith(("о", "е", "ё")):
        основа = слово[:-1]
        мягк = not слово.endswith("о")
        им = основа + ("я" if мягк else "а")
        for п, w in (("им", им), ("рд", родительный_множественного(слово)),
                     ("дт", основа + ("ям" if мягк else "ам")), ("вн", им),
                     ("тв", основа + ("ями" if мягк else "ами")),
                     ("пр", основа + ("ях" if мягк else "ах"))):
            доб(w, п, "мн")
        return
    if слово.endswith("ь"):
        основа = слово[:-1]
        for п, w in (("им", основа + "и"), ("рд", основа + ("ей" if род == "ж" else "ей")),
                     ("дт", основа + "ям"), ("вн", основа + "и"),
                     ("тв", основа + "ями"), ("пр", основа + "ях")):
            доб(w, п, "мн")
        return
    if слово.endswith("й"):
        основа = слово[:-1]
        for п, w in (("им", основа + "и"), ("рд", основа + "ев"), ("дт", основа + "ям"),
                     ("вн", основа + "и"), ("тв", основа + "ями"), ("пр", основа + "ях")):
            доб(w, п, "мн")
        return
    основа = слово
    им = основа + ("и" if основа.endswith(ГУБНЫЕ_КА) else "ы")
    for п, w in (("им", им), ("рд", родительный_множественного(слово)),
                 ("дт", основа + "ам"), ("вн", им), ("тв", основа + "ами"),
                 ("пр", основа + "ах")):
        доб(w, п, "мн")


ОКОНЧАНИЯ_РАЗБОРА = (
    ("ами", "тв", "мн"), ("ями", "тв", "мн"), ("ах", "пр", "мн"), ("ях", "пр", "мн"),
    ("ам", "дт", "мн"), ("ям", "дт", "мн"), ("ов", "рд", "мн"), ("ев", "рд", "мн"),
    ("ей", "рд", "мн"), ("ой", "тв", "ед"), ("ей", "тв", "ед"), ("ом", "тв", "ед"),
    ("ем", "тв", "ед"), ("ём", "тв", "ед"), ("ью", "тв", "ед"),
    ("а", "рд", "ед"), ("я", "рд", "ед"), ("у", "дт", "ед"), ("ю", "дт", "ед"),
    ("е", "пр", "ед"), ("и", "пр", "ед"), ("ы", "им", "мн"), ("и", "им", "мн"),
    ("ь", "им", "ед"),
)


def разобрать(слово):
    слово = слово.lower()
    итог = []
    for окончание, падеж, число in ОКОНЧАНИЯ_РАЗБОРА:
        if слово.endswith(окончание) and len(слово) - len(окончание) >= 2:
            итог.append((слово[: len(слово) - len(окончание)], падеж, число))
    итог.append((слово, "им", "ед"))
    видели, чисто = set(), []
    for к in итог:
        if к not in видели:
            видели.add(к)
            чисто.append(к)
    return чисто


def лемма_из(слово, падеж="им"):
    if падеж == "им":
        return слово.lower()
    for кандидат in разобрать(слово):
        if кандидат[1] == падеж and кандидат[2] == "ед":
            return кандидат[0]
    return слово.lower()


def лемма(слово):
    разбор = разобрать(слово)
    for кандидат in разбор:
        if кандидат[1] == "им" and кандидат[2] == "ед":
            return кандидат[0]
    return разбор[0][0]



