    "увеличить": ["увеличу", "увеличишь", "увеличит", "увеличим", "увеличьте", "увеличение"],
    "уменьшить": ["уменьшу", "уменьшишь", "уменьшит", "уменьшим", "уменьшите"],
    "умножить": ["умножу", "умножишь", "умножит", "умножим", "умножьте"],
    "разделить": ["разделю", "разделишь", "разделит", "разделим", "разделите"],
}


def формы_глагола(инфинитив):
    if инфинитив in НЕПРАВИЛЬНЫЕ_ГЛАГОЛЫ:
        return set(НЕПРАВИЛЬНЫЕ_ГЛАГОЛЫ[инфинитив]) | {инфинитив}

    слово = инфинитив
    if слово.endswith("ться") or слово.endswith("тись"):
        возврат = "ся"
        слово = слово[:-2]
    else:
        возврат = ""

    итог = {инфинитив}
    if слово.endswith("чь"):
        return итог
    if not слово.endswith(("ть", "ти")):
        return итог

    осн = слово[:-2] if слово.endswith("ть") else слово[:-2]
    if слово.endswith("ти"):
        осн = слово[:-2]

    второе = осн.endswith(("и", "е")) and слово.endswith("ить")
    гласн = осн[-1] if осн else "а"

    if второе:
        оконч = ["ю", "ишь", "ит", "им", "ите", "ят"]
    else:
        if гласн in "жшчщ":
            оконч = ["у", "ешь", "ет", "ем", "ете", "ут"]
        else:
            оконч = ["ю", "ешь", "ет", "ем", "ете", "ют"]

    basе = осн
    for о in оконч:
        итог.add(basе + о)
        if возврат:
            итог.add(basе + о + возврат)

    for о in ("л", "ла", "ло", "ли"):
        итог.add(basе + о)
        if возврат:
            итог.add(basе + о + возврат)

    итог.add(basе + ("и" if второе else "й"))
    итог.add(basе + ("и" if второе else "й") + "те")
    return итог



