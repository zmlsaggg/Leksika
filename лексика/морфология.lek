СЛОВО_ДРОБИ = "запятая"


def числительное(слова):
    if not слова:
        return None
    всего, ток = 0, 0
    нашли = False
    for слово in слова:
        слово = слово.lower()
        if слово in МНОЖИТЕЛИ:
            ток = ток or 1
            всего += ток * МНОЖИТЕЛИ[слово]
            ток = 0
            нашли = True
        elif слово in ЧИСЛИТЕЛЬНЫЕ:
            значение = ЧИСЛИТЕЛЬНЫЕ[слово]
            if значение >= 100:
                ток += значение
            else:
                ток += значение
            нашли = True
        else:
            return None
    if not нашли:
        return None
    return всего + ток


def прописью(число):
    единицы = ["ноль", "один", "два", "три", "четыре", "пять", "шесть", "семь",
               "восемь", "девять", "десять", "одиннадцать", "двенадцать",
               "тринадцать", "четырнадцать", "пятнадцать", "шестнадцать",
               "семнадцать", "восемнадцать", "девятнадцать"]
    десятки = ["", "", "двадцать", "тридцать", "сорок", "пятьдесят", "шестьдесят",
               "семьдесят", "восемьдесят", "девяносто"]
    сотни = ["", "сто", "двести", "триста", "четыреста", "пятьсот", "шестьсот",
             "семьсот", "восемьсот", "девятьсот"]
    число = int(число)
    if число < 0:
        return "минус " + прописью(-число)
    if число < 20:
        return единицы[число]
    if число < 100:
        итог = десятки[число // 10]
        if число % 10:
            итог += " " + единицы[число % 10]
        return итог
    if число < 1000:
        итог = сотни[число // 100]
        if число % 100:
            итог += " " + прописью(число % 100)
        return итог
    if число < 10 ** 6:
        итог = прописью(число // 1000) + " тысяч"
        if число % 1000:
            итог += " " + прописью(число % 1000)
        return итог
    return str(число)
