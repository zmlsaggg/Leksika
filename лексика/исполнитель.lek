
import math
import random
import time

from . import морфология, словарь, безопасность
from .ошибки import ОшибкаСмысла, ОшибкаПадежа
from . import грамматика as гр


class Вернуться(Exception):
    def __init__(self, значение):
        self.значение = значение


class ПрерватьЦикл(Exception):
    pass


class ПродолжитьЦикл(Exception):
    pass


class Область:

    def __init__(self, родитель=None, название="главная"):
        self.родитель = родитель
        self.название = название
        self.имена = {}

    def завести(self, имя, значение):
        self.имена[имя] = значение

    def есть(self, имя):
        return имя in self.имена



def как_речь(значение):
    if значение is None:
        return "ничто"
    if значение is True:
        return "да"
    if значение is False:
        return "нет"
    if isinstance(значение, float):
        if значение.is_integer():
            return str(int(значение))
        текст = f"{значение:.10g}"
        return текст.replace(".", ",")
    if isinstance(значение, list):
        return "перечень(" + ", ".join(как_речь(з) for з in значение) + ")"
    if isinstance(значение, dict):
        части = []
        for ключ, зн in значение.items():
            части.append(f"{как_речь(ключ)} значит {как_речь(зн)}")
        return "словарь(" + ", ".join(части) + ")"
    return str(значение)


def имя_вида(значение):
    if значение is None:
        return "ничто"
    if isinstance(значение, bool):
        return "истина или ложь"
    if isinstance(значение, (int, float)):
        return "число"
    if isinstance(значение, str):
        return "речь"
    if isinstance(значение, list):
        return "перечень"
    if isinstance(значение, dict):
        return "словарь"
    return "неведомое"



class Исполнитель:
    def __init__(self, вывод=None, ввод=None, модель=None, поиск_модулей=None,
                 лексические_имена=None):
        self.вывод = вывод or (lambda текст: print(текст))
        self.ввод = ввод or (lambda подсказка="": input(подсказка))
        self.модель = модель
        self.лексические_имена = dict(лексические_имена or {})
        self.главная = Область(None, "главная")
        self.области = [self.главная]
        self.правила = {}
        self._склонения = {}
        self.поиск_модулей = поиск_модулей or []
        self.подключённые = set()
        self.глубина_вызовов = 0

    def склонение(self, имя):
        if имя in self._склонения:
            return self._склонения[имя]
        данные = self.лексические_имена.get(имя, {})
        if данные.get("неизменяемое"):
            формы = {
                имя: [(падеж, число) for число in ("ед", "мн")
                      for падеж in морфология.ПАДЕЖИ]
            }
            self._склонения[имя] = формы
            return формы
        формы = dict(морфология.склонять(
            имя, данные.get("род"), данные.get("одушевлённое", False)
        ))
        if имя.endswith(("а", "я", "у", "ю", "ы", "и", "е", "о")):
            основа = имя[:-1]
            for вариант in {основа, основа + "а", основа + "о", основа + "я",
                            основа + "е", основа + "ь"}:
                if вариант == имя:
                    continue
                for слово, метки in морфология.склонять(вариант).items():
                    формы.setdefault(слово, метки)
        self._склонения[имя] = формы
        return формы

    def найти_имя(self, поверхность, падеж=None):
        слово = поверхность.lower()
        спорные = []
        for область in reversed(self.области):
            for имя in reversed(list(область.имена)):
                формы = self.склонение(имя)
                if слово in формы:
                    if падеж is None:
                        return имя
                    метки = [(п, ч) for п, ч in формы[слово]]
                    if any(п == падеж for п, _ in метки):
                        if len(list(область.имена)) > 0:
                            спорные.append((имя, падеж, метки[0][1]))
                        else:
                            return имя
        if len(спорные) == 1:
            return спорные[0][0]
        if len(спорные) > 1 and self.модель is not None:
            выбор, _ = self.модель.выбрать(слово, спорные, "")
            if выбор:
                return выбор[0]
        if падеж is not None:
            try:
                return self.найти_имя(поверхность, None)
            except ОшибкаСмысла:
                pass
        начальная = морфология.лемма(слово)
        for область in reversed(self.области):
            if область.есть(начальная):
                return начальная
        подсказка = ""
        if self.области and self.области[-1].имена:
            подсказка = "заведённые имена: " + ", ".join(sorted(self.области[-1].имена))
        raise ОшибкаСмысла(
            f"неизвестное имя «{поверхность}»",
            0, 0,
            подсказка or "заведите имя словом «пусть»: пусть счёт равно нулю.",
        )

    def значение_имени(self, узел, падеж=None):
        if isinstance(узел, str):
            имя = self.найти_имя(узел, падеж)
        else:
            имя = self.найти_имя(узел.слово, падеж)
        for область in reversed(self.области):
            if область.есть(имя):
                return имя, область.имена[имя]
        raise ОшибкаСмысла(f"неизвестное имя «{узел.слово if not isinstance(узел, str) else узел}»")

    def записать_имя(self, поверхность, значение):
        слово = поверхность.lower()
        for область in reversed(self.области):
            for имя in reversed(list(область.имена)):
                формы = self.склонение(имя)
                if слово in формы:
                    область.имена[имя] = значение
                    return имя
        начальная = морфология.лемма(слово)
        for область in reversed(self.области):
            if область.есть(начальная):
                область.имена[начальная] = значение
                return начальная
        self.области[-1].завести(слово, значение)
        return слово

    def исполнить(self, операторы):
        for узел in операторы:
            if isinstance(узел, гр.Правило):
                self.правила[узел.имя] = узел
        for узел in операторы:
            self.шаг(узел)

    def шаг(self, узел):
        обработчик = getattr(self, "_" + type(узел).__name__, None)
        if обработчик is None:
            raise ОшибкаСмысла(f"движок не знает, что делать с {type(узел).__name__}")
        return обработчик(узел)

    def _Объявить(self, узел):
        значение = self.считать(узел.значение)
        self.области[-1].завести(узел.имя, значение)

    def _Присвоить(self, узел):
        значение = self.считать(узел.значение)
        self.записать_имя(узел.имя, значение)

    def _Изменить(self, узел):
        _, старое = self.значение_имени(узел.имя)
        прибавка = self.считать(узел.значение)
        знаки = {"+": "плюс", "-": "минус", "*": "умножить", "/": "разделить"}
        новое = self.действие(знаки.get(узел.знак, узел.знак), старое, прибавка)
        self.записать_имя(узел.имя, новое)

    def _Сказать(self, узел):
        self.вывод(как_речь(self.считать(узел.значение)))

    def _Спросить(self, узел):
        try:
            ответ = self.ввод("")
        except EOFError:
            raise ОшибкаСмысла(
                "ввод закончился, а программа ждёт ответа",
                0, 0, "передайте данные в программу или уберите «спросить»",
            )
        self.области[-1].завести(узел.имя, ответ)

    def _Если(self, узел):
        for условие, тело in узел.ветви:
            if self.правда(self.считать(условие)):
                for шаг in тело:
                    self.шаг(шаг)
                return
        if узел.иначе:
            for шаг in узел.иначе:
                self.шаг(шаг)

    def _Пока(self, узел):
        витков = 0
        while self.правда(self.считать(узел.условие)):
            витков += 1
            if витков > 10_000_000:
                raise ОшибкаСмысла("замысел «пока» крутится слишком долго", 0, 0,
                                   "проверьте, меняется ли условие")
            try:
                for шаг in узел.тело:
                    self.шаг(шаг)
            except ПрерватьЦикл:
                break
            except ПродолжитьЦикл:
                continue

    def _Повторить(self, узел):
        сколько = self.считать(узел.сколько)
        if not isinstance(сколько, (int, float)) or isinstance(сколько, bool):
            raise ОшибкаСмысла(
                f"повторить можно только число, а получено {имя_вида(сколько)}")
        for _ in range(int(сколько)):
            try:
                for шаг in узел.тело:
                    self.шаг(шаг)
            except ПрерватьЦикл:
                break
            except ПродолжитьЦикл:
                continue

    def _ДляКаждого(self, узел):
        перечень = self.считать(узел.перечень)
        if isinstance(перечень, dict):
            перечень = list(перечень.keys())
        if isinstance(перечень, str):
            перечень = list(перечень)
        if not isinstance(перечень, list):
            raise ОшибкаСмысла(
                f"перебрать можно перечень, словарь или речь, а получено {имя_вида(перечень)}")
        имя = узел.имя
        область = Область(self.области[-1], "перебор")
        self.области.append(область)
        try:
            for предмет in перечень:
                область.завести(имя, предмет)
                try:
                    for шаг in узел.тело:
                        self.шаг(шаг)
                except ПрерватьЦикл:
                    break
                except ПродолжитьЦикл:
                    continue
        finally:
            self.области.pop()

    def _Правило(self, узел):
        return None

    def _Вернуть(self, узел):
        raise Вернуться(self.считать(узел.значение) if узел.значение is not None else None)

    def _Прервать(self, узел):
        raise ПрерватьЦикл()

    def _Продолжить(self, узел):
        raise ПродолжитьЦикл()

    def _Подключить(self, узел):
        self.подключить(узел.имя)

    def _Вызов(self, узел):
        self.вызвать(узел)
        return None

    def подключить(self, имя):
        if имя in self.подключённые:
            return
        import os
        пути = []
        for основа in self.поиск_модулей:
            пути.append(os.path.join(основа, имя + ".lek"))
            пути.append(os.path.join(основа, имя, "главное.lek"))
            пути.append(os.path.join(основа, имя, имя + ".lek"))
        for путь in пути:
            if os.path.isfile(путь):
                if not безопасность.разрешить_файл(путь, "подключение"):
                    raise ОшибкаСмысла(f"подключение словаря «{имя}» запрещено политикой безопасности")
                with open(путь, encoding="utf-8") as файл:
                    текст = файл.read()
                дерево = гр.разобрать(текст, путь)
                for узел in дерево:
                    if isinstance(узел, гр.Правило):
                        self.правила[узел.имя] = узел
                self.подключённые.add(имя)
                for узел in дерево:
                    if not isinstance(узел, гр.Правило):
                        self.шаг(узел)
                return
        raise ОшибкаСмысла(
            f"словарь «{имя}» не найден",
            0, 0,
            "положите файл в библиотеку или укажите путь запуска",
        )

    def вызвать(self, узел):
        имя = узел.имя
        значения = [self.считать(аргумент) for аргумент in узел.аргументы]

        if имя in self.правила:
            правило = self.правила[имя]
            if len(значения) != len(правило.параметры):
                raise ОшибкаСмысла(
                    f"правило «{имя}» ждёт {len(правило.параметры)} значений, "
                    f"а получило {len(значения)}",
                    узел.строка, узел.столбец,
                )
            область = Область(self.области[-1], "правило " + имя)
            for параметр, значение in zip(правило.параметры, значения):
                область.завести(параметр, значение)
            self.области.append(область)
            self.глубина_вызовов += 1
            if self.глубина_вызовов > 2000:
                raise ОшибкаСмысла("слишком глубокая вложенность правил", узел.строка, узел.столбец)
            try:
                for шаг in правило.тело:
                    self.шаг(шаг)
            except Вернуться as возврат:
                return возврат.значение
            finally:
                self.области.pop()
                self.глубина_вызовов -= 1
            return None

        return self.встроенная(имя, значения, узел)

    def встроенная(self, имя, значения, узел=None, строка=0, столбец=0):
        def ждём(сколько):
            if len(значения) != сколько:
                raise ОшибкаСмысла(
                    f"встроенное действие «{имя}» ждёт {сколько} значений, "
                    f"а получило {len(значения)}")

        if имя == "перечень":
            return list(значения)
        if имя == "словарь":
            return {}
        if имя == "остаток":
            ждём(2)
            делитель = self.в_число(значения[1], "остаток")
            if делитель == 0:
                raise ОшибкаСмысла("остаток от деления на ноль не существует")
            return self.в_число(значения[0], "остаток") % делитель
        if имя == "молча":
            ждём(1)
            return значения[0]
        if имя == "число":
            ждём(1)
            return self.в_число(значения[0])
        if имя == "строка":
            ждём(1)
            return как_речь(значения[0])
        if имя == "модуль":
            ждём(1)
            return abs(self.в_число(значения[0], "модуль"))
        if имя == "корень":
            ждём(1)
            return math.sqrt(self.в_число(значения[0], "корень"))
        if имя == "округлить":
            ждём(1)
            return round(self.в_число(значения[0], "округлить"))
        if имя == "целое":
            ждём(1)
            return int(self.в_число(значения[0], "целое"))
        if имя == "случайное":
            ждём(2)
            от = int(self.в_число(значения[0], "случайное"))
            до = int(self.в_число(значения[1], "случайное"))
            return random.randint(от, до)
        if имя == "ключи":
            ждём(1)
            if not isinstance(значения[0], dict):
                raise ОшибкаСмысла("ключи берутся только у словаря")
            return list(значения[0].keys())
        if имя == "буквы":
            ждём(1)
            return list(как_речь(значения[0]))
        if имя == "время":
            return time.strftime("%H:%M:%S")
        raise ОшибкаСмысла(
            f"неизвестное правило «{имя}»",
            узел.строка if узел else строка,
            узел.столбец if узел else столбец,
            "объявите его словом «правило» или подключите словарь",
        )

    def _Команда(self, узел):
        имя = узел.имя
        if имя == "длина":
            _, значение = self.значение_имени(узел.слоты[0][2], "рд")
            if isinstance(значение, (str, list, dict)):
                return len(значение)
            raise ОшибкаСмысла(
                f"у {имя_вида(значение)} нет длины",
                0, 0, "длина берётся у речи, перечня или словаря",
            )
        if имя == "взять":
            _, перечень = self.значение_имени(узел.слоты[0][2], "рд")
            номер = self.считать(узел.слоты[1][2])
            return self.по_номеру(перечень, номер)
        if имя == "прочитать":
            _, словарь_зн = self.значение_имени(узел.слоты[0][2], "рд")
            ключ = self.ключ(узел.слоты[1][2])
            if not isinstance(словарь_зн, dict):
                raise ОшибкаСмысла("прочитать можно только из словаря")
            if ключ not in словарь_зн:
                raise ОшибкаСмысла(
                    f"в словаре нет ключа «{как_речь(ключ)}»",
                    0, 0, "проверьте ключ или запишите значение заранее",
                )
            return словарь_зн[ключ]
        if имя == "добавить":
            _, перечень = self.значение_имени(узел.слоты[0][2], "вн")
            if not isinstance(перечень, list):
                raise ОшибкаСмысла("добавлять можно только в перечень")
            перечень.append(self.считать(узел.слоты[1][2]))
            return None
        if имя == "убрать":
            _, перечень = self.значение_имени(узел.слоты[0][2], "рд")
            номер = self.считать(узел.слоты[1][2])
            if not isinstance(перечень, list):
                raise ОшибкаСмысла("убирать можно только из перечня")
            if not isinstance(номер, (int, float)) or isinstance(номер, bool):
                raise ОшибкаСмысла("номер должен быть числом")
            if not 0 <= int(номер) < len(перечень):
                raise ОшибкаСмысла(
                    f"в перечне нет номера {int(номер)}", 0, 0,
                    f"сейчас в перечне {len(перечень)} предметов",
                )
            перечень.pop(int(номер))
            return None
        if имя == "записать":
            _, словарь_зн = self.значение_имени(узел.слоты[0][2], "вн")
            ключ = self.ключ(узел.слоты[1][2])
            if not isinstance(словарь_зн, dict):
                raise ОшибкаСмысла("записывать можно только в словарь")
            словарь_зн[ключ] = self.считать(узел.слоты[2][2])
            return None
        raise ОшибкаСмысла(f"неизвестная команда «{имя}»")

    def ключ(self, узел):
        if isinstance(узел, гр.Имя):
            try:
                return self.значение_имени(узел)[1]
            except ОшибкаСмысла:
                return узел.слово
        return self.считать(узел)

    def по_номеру(self, перечень, номер):
        if isinstance(перечень, dict):
            if номер in перечень:
                return перечень[номер]
            raise ОшибкаСмысла(f"в словаре нет ключа «{как_речь(номер)}»")
        if not isinstance(перечень, list):
            raise ОшибкаСмысла(f"взять по номеру можно из перечня, а не из {имя_вида(перечень)}")
        if not isinstance(номер, (int, float)) or isinstance(номер, bool):
            raise ОшибкаСмысла("номер должен быть числом")
        if not 0 <= int(номер) < len(перечень):
            raise ОшибкаСмысла(
                f"в перечне нет номера {int(номер)}", 0, 0,
                f"сейчас в перечне {len(перечень)} предметов, номера от нуля до {len(перечень) - 1}",
            )
        return перечень[int(номер)]

    def считать(self, узел):
        if узел is None:
            return None
        if isinstance(узел, гр.Число):
            return узел.значение
        if isinstance(узел, гр.Постоянное):
            return узел.значение
        if isinstance(узел, гр.Речь):
            куски = []
            for вид, кусок in узел.части:
                if вид == "т":
                    куски.append(кусок)
                else:
                    куски.append(как_речь(self.считать(кусок)))
            return "".join(куски)
        if isinstance(узел, гр.Имя):
            try:
                return self.значение_имени(узел)[1]
            except ОшибкаСмысла:
                if узел.слово[:1].isupper():
                    return узел.слово
                raise self.подсказать_речь(узел)
        if isinstance(узел, гр.Отрицание):
            return not self.правда(self.считать(узел.выражение))
        if isinstance(узел, гр.Действие):
            return self.действие(
                узел.знак, self.считать(узел.лево), self.считать(узел.право)
            )
        if isinstance(узел, гр.Вызов):
            return self.вызвать(узел)
        if isinstance(узел, гр.Команда):
            return self._Команда(узел)
        raise ОшибкаСмысла(f"движок не умеет считать {type(узел).__name__}")

    def подсказать_речь(self, узел):
        слово = узел.слово
        известно = False
        варианты = []
        try:
            известно = словарь.есть_словоформа(слово)
            if not известно:
                варианты = словарь.похожие_словоформы(слово, 5)
        except Exception:
            # Лексический индекс — необязательный ресурс диагностики.
            # Его недоступность не должна менять исполняемость программы.
            известно = False
            варианты = []

        if известно:
            совет = (
                f"форма «{слово}» есть в общей лексической базе, но не объявлена "
                "как имя программы; заведите имя словом «пусть» или используйте "
                f"речь {слово} конец речи"
            )
        elif варианты:
            совет = (
                "возможно, имелось в виду: "
                + ", ".join(f"«{вариант}»" for вариант in варианты)
                + "; проверьте падеж и написание"
            )
        else:
            совет = (
                f"если это просто слово, напишите речь {слово} конец речи, "
                "а если имя — заведите его словом «пусть»"
            )
        return ОшибкаСмысла(
            f"неизвестное имя «{слово}»",
            узел.строка, узел.столбец, совет,
        )

    def правда(self, значение):
        if isinstance(значение, bool):
            return значение
        if значение is None:
            return False
        if isinstance(значение, (int, float)):
            return значение != 0
        if isinstance(значение, (str, list, dict)):
            return len(значение) > 0
        return bool(значение)

    def в_число(self, значение, где="число"):
        if isinstance(значение, bool):
            return 1 if значение else 0
        if isinstance(значение, (int, float)):
            return значение
        if isinstance(значение, str):
            попытка = значение.strip().replace(",", ".")
            try:
                if "." in попытка:
                    return float(попытка)
                return int(попытка)
            except ValueError:
                raise ОшибкаСмысла(
                    f"речь «{значение}» не похожа на число",
                    0, 0, "в числе допустимы только цифры, знак минус и слово «запятая»",
                )
        raise ОшибкаСмысла(f"{где} ждёт число, а получено {имя_вида(значение)}")

    def действие(self, знак, лево, право):
        if знак == "и":
            return self.правда(лево) and self.правда(право)
        if знак == "или":
            return self.правда(лево) or self.правда(право)
        if знак == "содержит":
            if isinstance(лево, str):
                return как_речь(право) in лево
            if isinstance(лево, dict):
                return право in лево
            if isinstance(лево, list):
                return право in лево
            raise ОшибкаСмысла(f"у {имя_вида(лево)} не бывает содержимого")

        if знак in ("равно", "неравно"):
            одинаково = self.сравнить_на_равенство(лево, право)
            return одинаково if знак == "равно" else not одинаково

        if знак in ("больше", "меньше", "неменьше", "небольше"):
            л = self.в_число(лево, "сравнение")
            п = self.в_число(право, "сравнение")
            if знак == "больше":
                return л > п
            if знак == "меньше":
                return л < п
            if знак == "неменьше":
                return л >= п
            return л <= п

        if знак == "плюс":
            if isinstance(лево, str) or isinstance(право, str):
                if isinstance(лево, list) and isinstance(право, list):
                    return лево + право
                if isinstance(лево, str) or isinstance(право, str):
                    return как_речь(лево) + как_речь(право)
            if isinstance(лево, list) and isinstance(право, list):
                return лево + право
            return self.в_число(лево, "сложение") + self.в_число(право, "сложение")

        if знак in ("минус", "умножить", "разделить", "остаток", "степень"):
            л = self.в_число(лево, "вычисление")
            п = self.в_число(право, "вычисление")
            if знак == "минус":
                return л - п
            if знак == "умножить":
                return л * п
            if знак == "разделить":
                if п == 0:
                    raise ОшибкаСмысла("делить на ноль нельзя", 0, 0,
                                       "проверьте делитель до деления")
                итог = л / п
                if isinstance(итог, float) and итог.is_integer() and isinstance(л, int) and isinstance(п, int):
                    return итог if итог != int(итог) else итог
                return итог
            if знак == "остаток":
                if п == 0:
                    raise ОшибкаСмысла("остаток от деления на ноль не существует")
                return л % п
            if знак == "степень":
                return л ** п

        raise ОшибкаСмысла(f"неизвестное действие «{знак}»")

    def сравнить_на_равенство(self, лево, право):
        if isinstance(лево, bool) or isinstance(право, bool):
            return self.правда(лево) == self.правда(право)
        if isinstance(лево, (int, float)) and isinstance(право, (int, float)):
            return лево == право
        return лево == право
