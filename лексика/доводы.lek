class ОшибкаДоводов(Exception):
    pass


ОБЯЗАТЕЛЬНЫЙ = "обязательный"
НЕОБЯЗАТЕЛЬНЫЙ = "необязательный"
ХВОСТ = "хвост"
КЛЮЧ = "ключ"


class Набор:
    def __init__(self, дело=None):
        self.дело = дело
        self.справка = False
        self.остальное = []
        self.ошибка = ""

    def задать(self, имя, значение):
        setattr(self, имя, значение)

    def взять(self, имя, по_умолчанию=None):
        return getattr(self, имя, по_умолчанию)

    def __repr__(self):
        видно = {ключ: значение for ключ, значение in self.__dict__.items()}
        return "Набор(" + ", ".join(f"{ключ}={значение!r}" for ключ, значение in видно.items()) + ")"


class Разборщик:
    def __init__(self, схема, ключи=("-с", "--справка")):
        self.схема = схема
        self.ключи = ключи

    def расширение(self, дело):
        return self.схема.get(дело, [])

    def дела(self):
        return list(self.схема)

    def разобрать(self, доводы):
        доводы = list(доводы)
        набор = Набор()

        for номер, довод in enumerate(доводы):
            if довод in self.ключи:
                набор.справка = True
                del доводы[номер]
                break

        if not доводы:
            return набор
        if доводы[0].startswith("-"):
            raise ОшибкаДоводов(f"неизвестный ключ «{доводы[0]}», справка: лексус справка")

        дело = доводы.pop(0)
        if дело not in self.схема:
            raise ОшибкаДоводов(
                f"неизвестное дело «{дело}», а есть: " + ", ".join(self.дела())
                + ". Справка: лексус справка")
        набор.дело = дело

        описание = self.расширение(дело)
        значения = {}
        очередь = list(доводы)
        позиция = 0
        while очередь:
            довод = очередь.pop(0)
            if довод.startswith("--"):
                имя = довод[2:]
                вид, по_умолчанию = self._поле(описание, имя)
                if вид != КЛЮЧ:
                    raise ОшибкаДоводов(f"у дела «{дело}» нет ключа «{довод}»")
                if по_умолчанию in (True, False):
                    значения[имя] = not по_умолчанию
                elif очередь and not очередь[0].startswith("--"):
                    значения[имя] = очередь.pop(0)
                else:
                    значения[имя] = True
                continue
            имя, вид, по_умолчанию = self._следующее(описание, значения)
            if имя is None:
                raise ОшибкаДоводов(f"у дела «{дело}» лишний довод «{довод}»")
            if вид == ХВОСТ:
                значения[имя] = [довод] + очередь
                очередь = []
            else:
                значения[имя] = довод
            позиция += 1

        for имя, (вид, по_умолчанию) in self._поля(описание):
            if имя in значения:
                набор.задать(имя, значения[имя])
            elif вид == ОБЯЗАТЕЛЬНЫЙ:
                raise ОшибкаДоводов(f"у дела «{дело}» не хватает «{имя}»")
            elif вид == ХВОСТ:
                набор.задать(имя, [])
            else:
                набор.задать(имя, по_умолчанию)

        for имя, (вид, по_умолчанию) in self._поля(описание):
            if вид == КЛЮЧ and имя not in значения:
                набор.задать(имя, по_умолчанию)
        набор.остальное = list(набор.взять("остальное", []) or [])
        return набор

    def _поле(self, описание, имя):
        for поле_имя, поле_вид, поле_умолчание in описание:
            if поле_имя == имя:
                return поле_вид, поле_умолчание
        return None, None

    def _поля(self, описание):
        return [(имя, (вид, по_умолчанию)) for имя, вид, по_умолчанию in описание]

    def _следующее(self, описание, значения):
        for имя, вид, по_умолчанию in описание:
            if вид in (ОБЯЗАТЕЛЬНЫЙ, НЕОБЯЗАТЕЛЬНЫЙ, ХВОСТ) and имя not in значения:
                return имя, вид, по_умолчанию
        return None, None, None
