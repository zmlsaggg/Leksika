import os
import time
import hashlib
import urllib.parse

from . import хранение

ПАПКА = os.path.join(os.path.expanduser("~"), ".lek")
ФАЙЛ_ПОЛИТИКИ = os.environ.get(
    "ЛЕКСУС_ПОЛИТИКА",
    os.path.join(ПАПКА, "политика.без"),
)
ФАЙЛ_АУДИТА = os.environ.get(
    "ЛЕКСУС_АУДИТ",
    os.path.join(ПАПКА, "аудит.логе"),
)

ПО_УМОЛЧАНИЮ = {
    "режим": "обычный",
    "сеть": False,
    "процессы": True,
    "внешние_модули": True,
    "файлы_вне_корня": True,
    "аудит": True,
    "разрешённые_пути": [],
    "разрешённые_узлы": [],
    "разрешённые_процессы": [],
    "разрешённые_модули": [],
    "разрешённые_секреты": [],
}

ЧУВСТВИТЕЛЬНЫЕ_НАСТРОЙКИ = {
    "сеть", "процессы", "внешние_модули", "файлы_вне_корня",
    "разрешённые_пути", "разрешённые_узлы", "разрешённые_процессы",
    "разрешённые_модули", "разрешённые_секреты",
}


def _загрузить():
    настройка = dict(ПО_УМОЛЧАНИЮ)
    try:
        данные = хранение.прочитать_файл(ФАЙЛ_ПОЛИТИКИ)
        if isinstance(данные, dict):
            настройка.update(данные)
    except (OSError, ValueError):
        pass
    if настройка.get("режим") == "защищённый":
        # Защищённый режим закрывает опасные каналы, пока allowlist явно не откроет их.
        настройка["сеть"] = bool(настройка.get("сеть", False))
        настройка["процессы"] = False
        настройка["внешние_модули"] = False
        настройка["файлы_вне_корня"] = False
        настройка["аудит"] = True
    return настройка


def настройки():
    return _загрузить()


def защищённый():
    return _загрузить().get("режим") == "защищённый"


def сохранить(новые):
    os.makedirs(ПАПКА, exist_ok=True)
    текущие = _загрузить()
    текущие.update(новые)
    if текущие.get("режим") == "защищённый":
        текущие["аудит"] = True
    хранение.записать_файл(ФАЙЛ_ПОЛИТИКИ, текущие)
    записать_аудит("политика", ФАЙЛ_ПОЛИТИКИ, "разрешено", "изменение политики")
    return текущие


def _чистое(значение):
    return str(значение).replace("\t", " ").replace("\r", " ").replace("\n", " ")


def _предыдущий_хеш():
    try:
        with open(ФАЙЛ_АУДИТА, "r", encoding="utf-8") as файл:
            последний = ""
            for последний in файл:
                pass
        if последний:
            части = последний.rstrip("\n").split("\t")
            if len(части) >= 6:
                return части[5]
    except OSError:
        pass
    return "0" * 64


def записать_аудит(действие, объект, результат, причина=""):
    политика = _загрузить()
    if not политика.get("аудит", True) and политика.get("режим") != "защищённый":
        return
    папка = os.path.dirname(ФАЙЛ_АУДИТА)
    if папка:
        os.makedirs(папка, exist_ok=True)
    время = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    основа = "\t".join((
        время,
        _чистое(действие),
        _чистое(объект),
        _чистое(результат),
        _чистое(причина),
        _предыдущий_хеш(),
    ))
    хеш = hashlib.sha256(основа.encode("utf-8")).hexdigest()
    with open(ФАЙЛ_АУДИТА, "a", encoding="utf-8") as файл:
        файл.write(основа + "\t" + хеш + "\n")


def проверить_аудит():
    try:
        with open(ФАЙЛ_АУДИТА, "r", encoding="utf-8") as файл:
            строки = [строка.rstrip("\n") for строка in файл if строка.strip()]
    except OSError:
        return True, 0, "аудит пуст"

    предыдущий = "0" * 64
    for номер, строка in enumerate(строки, 1):
        части = строка.split("\t")
        if len(части) != 7:
            return False, номер, "неверное число полей"
        основа = "\t".join(части[:6])
        ожидаемый = hashlib.sha256(основа.encode("utf-8")).hexdigest()
        if части[5] != предыдущий:
            return False, номер, "разорвана цепочка предыдущего отпечатка"
        if части[6] != ожидаемый:
            return False, номер, "не совпадает SHA-256 записи"
        предыдущий = части[6]
    return True, len(строки), "цепочка цела"


def последние_события(количество=20):
    try:
        with open(ФАЙЛ_АУДИТА, "r", encoding="utf-8") as файл:
            строки = файл.readlines()
    except OSError:
        return []
    return [строка.rstrip("\n") for строка in строки[-max(1, int(количество)) :]]


def корни_доступа():
    политика = _загрузить()
    корни = [
        os.path.realpath(os.path.join(os.path.expanduser("~"), ".lek")),
        os.path.realpath(os.path.dirname(__file__)),
    ]
    программа = os.environ.get("ЛЕКСУС_КОРЕНЬ_ПРОГРАММЫ", "")
    if программа:
        корни.append(os.path.realpath(программа))
    корни.extend(
        os.path.realpath(os.path.expanduser(путь))
        for путь in политика.get("разрешённые_пути", [])
        if isinstance(путь, str) and путь
    )
    return list(dict.fromkeys(корни))


def _внутри(путь, корень):
    try:
        return os.path.commonpath([путь, корень]) == корень
    except ValueError:
        return False


def разрешить_файл(путь, действие="чтение"):
    политика = _загрузить()
    полный = os.path.abspath(os.path.expanduser(str(путь)))
    проверочный = os.path.realpath(полный)

    if политика.get("режим") != "защищённый":
        if действие in ("запись", "удаление", "дописание", "переименование",
                        "подключение", "упаковка", "распаковка", "внешняя модель"):
            записать_аудит("файл:" + действие, полный, "разрешено", "обычный режим")
        return True

    if not политика.get("файлы_вне_корня", False):
        корень_подстановки = проверочный
        if not os.path.exists(полный):
            корень_подстановки = os.path.realpath(os.path.dirname(полный) or ".")
        if not any(_внутри(корень_подстановки, корень) for корень in корни_доступа()):
            записать_аудит("файл:" + действие, полный, "запрещено", "вне разрешённых корней")
            return False

    записать_аудит("файл:" + действие, полный, "разрешено", "политика")
    return True


def разрешить_сеть(адрес):
    политика = _загрузить()
    хост = ""
    try:
        хост = urllib.parse.urlparse(адрес).hostname or ""
    except ValueError:
        pass
    if not политика.get("сеть", False):
        записать_аудит("сеть", хост or адрес, "запрещено", "сеть выключена политикой")
        return False
    узлы = политика.get("разрешённые_узлы", [])
    if политика.get("режим") == "защищённый" and not узлы:
        записать_аудит("сеть", хост or адрес, "запрещено", "в защищённом режиме нет allowlist узлов")
        return False
    if узлы and хост.lower() not in {str(узел).lower() for узел in узлы}:
        записать_аудит("сеть", хост or адрес, "запрещено", "узел не в allowlist")
        return False
    записать_аудит("сеть", хост or адрес, "разрешено", "политика")
    return True


def разрешить_процесс(команда):
    политика = _загрузить()
    имя = os.path.basename(str(команда))
    if политика.get("режим") != "защищённый":
        записать_аудит("процесс", имя, "разрешено", "обычный режим")
        return True
    разрешённые = {str(элемент).lower() for элемент in политика.get("разрешённые_процессы", [])}
    if имя.lower() not in разрешённые:
        записать_аудит("процесс", имя, "запрещено", "не входит в allowlist")
        return False
    записать_аудит("процесс", имя, "разрешено", "allowlist")
    return True


def разрешить_модуль(имя):
    политика = _загрузить()
    if политика.get("режим") != "защищённый":
        записать_аудит("модуль", имя, "разрешено", "обычный режим")
        return True
    разрешённые = {str(элемент) for элемент in политика.get("разрешённые_модули", [])}
    if имя not in разрешённые:
        записать_аудит("модуль", имя, "запрещено", "внешний модуль не разрешён")
        return False
    записать_аудит("модуль", имя, "разрешено", "allowlist")
    return True


def разрешить_внешнюю_модель(путь):
    if not путь:
        записать_аудит("модель", "нет пути", "запрещено", "внешняя модель не задана")
        return False
    if not разрешить_файл(путь, "внешняя модель"):
        return False
    политика = _загрузить()
    if политика.get("режим") != "защищённый":
        записать_аудит("модель", путь, "разрешено", "обычный режим")
        return True
    if not политика.get("внешние_модули", False):
        записать_аудит("модель", путь, "запрещено", "внешние модули выключены")
        return False
    записать_аудит("модель", путь, "разрешено", "политика")
    return True


def разрешить_секрет(имя):
    политика = _загрузить()
    if политика.get("режим") != "защищённый":
        return True
    разрешённые = {str(элемент) for элемент in политика.get("разрешённые_секреты", [])}
    разрешено = имя in разрешённые
    записать_аудит("секрет", имя, "разрешено" if разрешено else "запрещено",
                   "allowlist" if разрешено else "секрет не разрешён")
    return разрешено
