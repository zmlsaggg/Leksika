import os
import time

from . import упаковка, хранение

ПАПКА = os.path.join(os.path.expanduser("~"), ".lek")
БИБЛИОТЕКА = os.path.join(ПАПКА, "библиотека")
СПИСОК = os.path.join(ПАПКА, "патчи.список")
ВЕРСИЯ_ЯЗЫКА = "1.0"

РАСШИРЕНИЕ = ".патч"
ИМЯ_МАНИФЕСТА = "манифест.настр"


def отпечаток(путь):
    return упаковка.отпечаток_файла(путь)


def собрать(путь, имя=None, версия="0.1.0", автор="", описание="", точка_входа=None):
    путь = os.path.abspath(путь)
    if not os.path.isfile(путь):
        raise FileNotFoundError(f"нет файла {путь}")
    имя = имя or os.path.splitext(os.path.basename(путь))[0]
    точка_входа = точка_входа or os.path.basename(путь)
    основа = os.path.dirname(путь)

    файлы = []
    записи = []
    for корень, _, имена in os.walk(основа):
        for файл in sorted(имена):
            if не_наш(файл):
                continue
            полный = os.path.join(корень, файл)
            внутри = os.path.relpath(полный, основа).replace(os.sep, "/")
            файлы.append({
                "путь": внутри,
                "отпечаток": отпечаток(полный),
                "размер": os.path.getsize(полный),
            })
            записи.append(("код/" + внутри, полный))

    манифест = {
        "язык": "Лексика",
        "версия_языка": ВЕРСИЯ_ЯЗЫКА,
        "имя": имя,
        "версия": версия,
        "автор": автор,
        "описание": описание,
        "точка_входа": точка_входа,
        "собрано": time.strftime("%Y-%m-%d %H:%M:%S"),
        "файлы": файлы,
    }

    выход = имя + РАСШИРЕНИЕ
    все = [(ИМЯ_МАНИФЕСТА, хранение.записать(манифест))]
    все += записи
    все.append(("запуск", _запускающий_слой(имя)))
    все.append(("читай.lek", _образец_имени(имя)))
    упаковка.упаковать(все, выход)
    return выход, манифест


def не_наш(файл):
    return not файл.endswith(".lek")


def _запускающий_слой(имя):
    return (
        "#!/bin/sh\n"
        f'exec лексус запустить "{имя}" "$@"\n'
    )


def _образец_имени(имя):
    return (
        f"заметка заплатка «{имя}»: здесь можно описать её по-русски\n"
        f"правило приветствие принимает кто повторять\n"
        f"    вернуть речь Заплатка {имя} приветствует (кто)! конец речи.\n"
        f"конец правила.\n"
    )


def прочитать_манифест(путь):
    содержимое = упаковка.прочитать(путь, ИМЯ_МАНИФЕСТА)
    return хранение.прочитать(содержимое.decode("utf-8"))


def наложить(архив_путь, заменить=True):
    архив_путь = os.path.abspath(архив_путь)
    if not os.path.isfile(архив_путь):
        raise ValueError(f"нет файла «{архив_путь}»")
    try:
        манифест = прочитать_манифест(архив_путь)
    except (ValueError, KeyError) as ошибка:
        raise ValueError(f"«{os.path.basename(архив_путь)}» не похож на заплатку Лексика: {ошибка}")
    if манифест.get("язык") != "Лексика":
        raise ValueError("заплатка собрана не для языка Лексика")

    место = os.path.join(БИБЛИОТЕКА, манифест["имя"])
    if os.path.isdir(место) and not заменить:
        raise ValueError(f"заплатка «{манифест['имя']}» уже наложена")
    if os.path.isdir(место):
        упаковка.удалить_дерево(место)
    os.makedirs(место, exist_ok=True)

    for элемент, содержимое in упаковка.разобрать(архив_путь):
        if элемент == ИМЯ_МАНИФЕСТА:
            continue
        if элемент.startswith("код/"):
            цель = os.path.join(место, элемент[len("код/"):].replace("/", os.sep))
        else:
            цель = os.path.join(место, элемент)
        папка = os.path.dirname(цель)
        if папка:
            os.makedirs(папка, exist_ok=True)
        with open(цель, "wb") as файл:
            файл.write(содержимое)

    for файл in манифест.get("файлы", []):
        полный = os.path.join(место, файл["путь"].replace("/", os.sep))
        if not os.path.isfile(полный) or отпечаток(полный) != файл["отпечаток"]:
            raise ValueError(f"испорчен файл {файл['путь']} — наложение отменено")

    список = _список()
    список[манифест["имя"]] = {
        "версия": манифест.get("версия"),
        "точка_входа": манифест.get("точка_входа"),
        "описание": манифест.get("описание"),
        "автор": манифест.get("автор"),
        "место": место,
        "наложено": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    _сохранить_список(список)
    return манифест, место


def откатить(имя):
    список = _список()
    if имя not in список:
        raise ValueError(f"заплатка «{имя}» не наложена")
    место = список[имя]["место"]
    if os.path.isdir(место):
        упаковка.удалить_дерево(место)
    del список[имя]
    _сохранить_список(список)
    return имя


def список():
    return _список()


def путь_программы(имя):
    запись = _список().get(имя)
    if not запись:
        return None
    return os.path.join(запись["место"], запись["точка_входа"])


def _список():
    for путь in (СПИСОК, os.path.join(ПАПКА, "заплатки.json")):
        if not os.path.isfile(путь):
            continue
        try:
            данные = хранение.прочитать_файл(путь)
        except (OSError, ValueError):
            return {}
        if isinstance(данные, dict):
            return данные
        return {}
    return {}


def _сохранить_список(список):
    os.makedirs(ПАПКА, exist_ok=True)
    хранение.записать_файл(СПИСОК, список)
