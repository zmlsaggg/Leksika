"""Совместимая форма записи: русские слова, привычная блочная пунктуация.

Это не загрузчик Python/C++ и не переводчик чужих ключевых слов. Модуль
сводит несколько знакомых форм записи к общей грамматике Лексики.
"""

import re


_ИМЯ = r"[А-Яа-яЁё][А-Яа-яЁё0-9-]*"
_ТИП = r"(?:целое|число|дробь|дробное|вещественное|логическое|речь|строка|перечень|словарь|пусто)"
_КОНЦЫ = {
    "если": "если",
    "пока": "пока",
    "для": "для",
    "повторить": "повтора",
    "правило": "правила",
}


def _граница(текст, индекс, слово):
    конец = индекс + len(слово)
    if текст[индекс:конец].lower() != слово:
        return False
    слева = индекс == 0 or not (текст[индекс - 1].isalnum() or текст[индекс - 1] == "_")
    справа = конец >= len(текст) or not (текст[конец].isalnum() or текст[конец] == "_")
    return слева and справа


def _найти_закрытие(текст, начало, открытие, закрытие):
    глубина = 0
    for индекс in range(начало, len(текст)):
        if текст[индекс] == открытие:
            глубина += 1
        elif текст[индекс] == закрытие:
            глубина -= 1
            if глубина == 0:
                return индекс
    return -1


def _контекст_перечня(текст, индекс):
    if индекс == 0:
        return True
    предыдущий = текст[индекс - 1]
    return предыдущий.isspace() or предыдущий in "=,(:["


def _операторы_выражения(текст):
    """Переводит знаки выражений в уже существующие русские операции."""
    выход = []
    индекс = 0
    операторы = (
        ("==", " равно "),
        ("!=", " не равно "),
        (">=", " не меньше "),
        ("<=", " не больше "),
        ("&&", " и "),
        ("||", " или "),
        ("**", " в степени "),
        ("+", " плюс "),
        ("*", " умножить на "),
        ("/", " разделить на "),
        ("%", " остаток от "),
        ("=", " равно "),
        (">", " больше "),
        ("<", " меньше "),
    )

    while индекс < len(текст):
        знак = текст[индекс]

        if знак == "[" and _контекст_перечня(текст, индекс):
            конец = _найти_закрытие(текст, индекс, "[", "]")
            if конец >= 0:
                внутреннее = _операторы_выражения(текст[индекс + 1:конец])
                выход.append("перечень(" + внутреннее + ")")
                индекс = конец + 1
                continue

        найдено = False
        for исходный, русский in операторы:
            if текст.startswith(исходный, индекс):
                выход.append(русский)
                индекс += len(исходный)
                найдено = True
                break
        if найдено:
            continue

        if знак == ";":
            выход.append(".")
            индекс += 1
            continue

        if знак == "-":
            предыдущий = текст[индекс - 1] if индекс else ""
            следующий = текст[индекс + 1] if индекс + 1 < len(текст) else ""
            часть_имени = предыдущий.isalpha() and следующий.isalpha()
            if not часть_имени:
                выход.append(" минус ")
                индекс += 1
                continue

        выход.append(знак)
        индекс += 1

    return "".join(выход)


def _перевести_знаки(текст):
    """Не меняет обычный текст внутри «речи», но обрабатывает вставки в скобках."""
    выход = []
    индекс = 0
    в_речи = False

    while индекс < len(текст):
        if в_речи:
            if _граница(текст, индекс, "конец речи"):
                выход.append("конец речи")
                индекс += len("конец речи")
                в_речи = False
                continue

            if текст.startswith("((", индекс) or текст.startswith("))", индекс):
                выход.append(текст[индекс:индекс + 2])
                индекс += 2
                continue

            if текст[индекс] == "(":
                конец = _найти_закрытие(текст, индекс, "(", ")")
                if конец >= 0:
                    выражение = _операторы_выражения(текст[индекс + 1:конец])
                    выход.append("(" + выражение + ")")
                    индекс = конец + 1
                    continue

            выход.append(текст[индекс])
            индекс += 1
            continue

        if _граница(текст, индекс, "заметка"):
            конец = текст.find("\n", индекс)
            if конец < 0:
                выход.append(текст[индекс:])
                break
            выход.append(текст[индекс:конец])
            индекс = конец
            continue

        if _граница(текст, индекс, "речь"):
            выход.append("речь")
            индекс += len("речь")
            в_речи = True
            continue

        if текст[индекс] == "[" and _контекст_перечня(текст, индекс):
            конец = _найти_закрытие(текст, индекс, "[", "]")
            if конец >= 0:
                внутреннее = _операторы_выражения(текст[индекс + 1:конец])
                выход.append("перечень(" + внутреннее + ")")
                индекс = конец + 1
                continue

        if текст.startswith("==", индекс):
            выход.append(" равно ")
            индекс += 2
        elif текст.startswith("!=", индекс):
            выход.append(" не равно ")
            индекс += 2
        elif текст.startswith(">=", индекс):
            выход.append(" не меньше ")
            индекс += 2
        elif текст.startswith("<=", индекс):
            выход.append(" не больше ")
            индекс += 2
        elif текст.startswith("&&", индекс):
            выход.append(" и ")
            индекс += 2
        elif текст.startswith("||", индекс):
            выход.append(" или ")
            индекс += 2
        elif текст.startswith("**", индекс):
            выход.append(" в степени ")
            индекс += 2
        elif текст[индекс] == "+":
            выход.append(" плюс ")
            индекс += 1
        elif текст[индекс] == "*":
            выход.append(" умножить на ")
            индекс += 1
        elif текст[индекс] == "/":
            выход.append(" разделить на ")
            индекс += 1
        elif текст[индекс] == "%":
            выход.append(" остаток от ")
            индекс += 1
        elif текст[индекс] == "=":
            выход.append(" равно ")
            индекс += 1
        elif текст[индекс] == ">":
            выход.append(" больше ")
            индекс += 1
        elif текст[индекс] == "<":
            выход.append(" меньше ")
            индекс += 1
        elif текст[индекс] == ";":
            выход.append(".")
            индекс += 1
        elif текст[индекс] == "-":
            предыдущий = текст[индекс - 1] if индекс else ""
            следующий = текст[индекс + 1] if индекс + 1 < len(текст) else ""
            часть_имени = предыдущий.isalpha() and следующий.isalpha()
            if часть_имени:
                выход.append("-")
            else:
                выход.append(" минус ")
            индекс += 1
        else:
            выход.append(текст[индекс])
            индекс += 1

    return "".join(выход)


def _параметры(текст):
    части = []
    for часть in текст.split(","):
        часть = часть.strip()
        часть = re.sub(r"^" + _ТИП + r"\s+", "", часть, flags=re.IGNORECASE)
        if часть:
            части.append(часть)
    return ", ".join(части)


def _вид_блока(заголовок):
    текст = заголовок.strip()
    if re.match(r"^иначе\s*$", текст, re.IGNORECASE):
        return "иначе"
    if re.match(r"^(?:иначе\s+)?если\b", текст, re.IGNORECASE):
        return "если"
    if re.match(r"^пока\b", текст, re.IGNORECASE):
        return "пока"
    if re.match(r"^для\s+каждого\b", текст, re.IGNORECASE):
        return "для"
    if re.match(r"^повторить\b", текст, re.IGNORECASE):
        return "повторить"
    if re.match(r"^правило\b", текст, re.IGNORECASE):
        return "правило"
    if re.match(r"^" + _ТИП + r"\s+" + _ИМЯ + r"\s*\(", текст, re.IGNORECASE):
        return "правило"
    return None


def _заголовок(текст):
    текст = текст.strip()

    функция = re.fullmatch(
        r"правило\s+(" + _ИМЯ + r")\s*\((.*)\)", текст, re.IGNORECASE
    )
    if функция:
        параметры = _параметры(функция.group(2))
        хвост = " принимает " + параметры if параметры else ""
        return "правило " + функция.group(1) + хвост + " повторять"

    типовая_функция = re.fullmatch(
        r"(" + _ТИП + r")\s+(" + _ИМЯ + r")\s*\((.*)\)", текст, re.IGNORECASE
    )
    if типовая_функция:
        параметры = _параметры(типовая_функция.group(3))
        хвост = " принимает " + параметры if параметры else ""
        return "правило " + типовая_функция.group(2) + хвост + " повторять"

    условие = re.fullmatch(r"(иначе\s+если|если)\s*(?:\((.*)\)|(.*))", текст, re.IGNORECASE)
    if условие:
        выражение = условие.group(2) if условие.group(2) is not None else условие.group(3)
        return условие.group(1) + " " + выражение.strip() + " то"

    пока = re.fullmatch(r"пока\s*(?:\((.*)\)|(.*))", текст, re.IGNORECASE)
    if пока:
        выражение = пока.group(1) if пока.group(1) is not None else пока.group(2)
        return "пока " + выражение.strip() + " повторять"

    if re.match(r"^для\s+каждого\b", текст, re.IGNORECASE):
        текст = re.sub(r"\s+в\s+", " из ", текст, count=1, flags=re.IGNORECASE)
        if not re.search(r"\bповторять$", текст, re.IGNORECASE):
            текст += " повторять"
        return текст

    if re.match(r"^повторить\b", текст, re.IGNORECASE):
        if not re.search(r"\bраз$", текст, re.IGNORECASE):
            текст += " раз"
        return текст

    if re.fullmatch(r"правило\s+" + _ИМЯ, текст, re.IGNORECASE):
        return текст + " повторять"

    return текст


def _изменение_переменной(текст):
    изменение = re.fullmatch(
        r"(" + _ИМЯ + r")\s*(\+=|-=|\*=|/=)\s*(.+)",
        текст,
        re.IGNORECASE,
    )
    if изменение:
        действие = {
            "+=": "увеличить",
            "-=": "уменьшить",
            "*=": "умножить",
            "/=": "разделить",
        }[изменение.group(2)]
        return действие + " " + изменение.group(1) + " на " + изменение.group(3)

    шаг = re.fullmatch(r"(" + _ИМЯ + r")\s*(\+\+|--)\s*[;.!?]?", текст)
    if шаг:
        действие = "увеличить" if шаг.group(2) == "++" else "уменьшить"
        return действие + " " + шаг.group(1) + " на один"

    return текст


def _объявление(текст):
    объявление = re.match(
        r"^пусть\s+(" + _ИМЯ + r")\s*=\s*(.*)$", текст, re.IGNORECASE
    )
    if объявление:
        return "пусть " + объявление.group(1) + " равно " + объявление.group(2)

    типовое = re.match(
        r"^" + _ТИП + r"\s+(" + _ИМЯ + r")\s*=\s*(.*)$",
        текст,
        re.IGNORECASE,
    )
    if типовое:
        return "пусть " + типовое.group(1) + " равно " + типовое.group(2)

    return текст


def _это_иначе(текст):
    return bool(re.match(r"^иначе(?:\s+если)?(?:\s|\(|:|\{|$)", текст, re.IGNORECASE))


def _следующая_ветвь(строки, номер):
    for строка in строки[номер + 1:]:
        текст = строка.strip()
        if not текст or текст.startswith("заметка"):
            continue
        return _это_иначе(текст)
    return False


def _закрытие(блок):
    return "конец " + _КОНЦЫ[блок["вид"]] + "."


def _блоки(текст):
    строки = текст.splitlines()
    выход = []
    стек = []
    в_речи = False

    for номер, исходная in enumerate(строки):
        отступ_текст = исходная[:len(исходная) - len(исходная.lstrip(" \t"))]
        отступ = sum(4 if знак == "\t" else 1 for знак in отступ_текст)
        строка = исходная.strip()

        if not строка:
            выход.append("")
            continue

        if в_речи:
            закрытие_речи = re.search(r"(?<!\w)конец\s+речи(?!\w)", строка, re.IGNORECASE)
            if закрытие_речи:
                в_речи = False
                if not строка.endswith((".", "!", "?")):
                    выход.append(исходная + ".")
                else:
                    выход.append(исходная)
            else:
                выход.append(исходная)
            continue

        открытие_речи = re.search(r"(?<!\w)речь(?!\w)", строка, re.IGNORECASE)
        закрытие_речи = re.search(r"(?<!\w)конец\s+речи(?!\w)", строка, re.IGNORECASE)
        if открытие_речи and not закрытие_речи:
            в_речи = True
            выход.append(исходная)
            continue

        if re.match(r"^заметка\b", строка, re.IGNORECASE):
            выход.append(исходная)
            continue

        # Закрывающая фигурная скобка может стоять отдельно или перед «иначе».
        ветвь_после_скобки = False
        if строка.startswith("}"):
            остаток = строка[1:].strip()
            if остаток.startswith(";"):
                остаток = остаток[1:].strip()

            if остаток and _это_иначе(остаток) and стек and стек[-1]["вид"] == "если":
                строка = остаток
                ветвь_после_скобки = True
            else:
                if стек and стек[-1]["стиль"] == "фигурные":
                    блок = стек[-1]
                    if блок["вид"] == "если" and _следующая_ветвь(строки, номер):
                        строка = остаток
                        if not строка:
                            continue
                    else:
                        стек.pop()
                        выход.append(" " * отступ + _закрытие(блок))
                        строка = остаток
                        if not строка:
                            continue
                else:
                    выход.append(исходная)
                    continue

        # В Python-подобной записи окончание отступа закрывает блок.
        while стек and стек[-1]["стиль"] == "отступ" and отступ <= стек[-1]["отступ"]:
            if (_это_иначе(строка) and стек[-1]["вид"] == "если"
                    and отступ == стек[-1]["отступ"]):
                break
            блок = стек.pop()
            выход.append(" " * блок["отступ"] + _закрытие(блок))

        маркер = None
        if строка.endswith("{"):
            маркер = "фигурные"
            заголовок = строка[:-1].strip()
        elif строка.endswith(":"):
            маркер = "отступ"
            заголовок = строка[:-1].strip()
        else:
            заголовок = строка

        вид = _вид_блока(заголовок) if маркер else None
        if вид:
            выход.append(" " * отступ + _заголовок(заголовок))
            if вид == "иначе":
                continue
            ветвь_родителя = (
                _это_иначе(заголовок)
                and bool(стек)
                and стек[-1]["вид"] == "если"
                and (
                    ветвь_после_скобки
                    or (стек[-1]["стиль"] == "отступ" and отступ == стек[-1]["отступ"])
                )
            )
            if not ветвь_родителя:
                стек.append({
                    "вид": вид,
                    "стиль": маркер,
                    "отступ": отступ,
                })
            continue

        строка = _объявление(строка)
        строка = _изменение_переменной(строка)
        # В совместимой записи перевод строки тоже завершает простое действие.
        if not строка.endswith((";", ".", "!", "?")):
            if not re.match(r"^(?:иначе|правило\b.*\bповторять|если\b.*\bто|пока\b.*\bповторять|для\s+каждого\b.*\bповторять|повторить\b.*\bраз)$",
                            строка, re.IGNORECASE):
                строка += "."
        выход.append(" " * отступ + строка)

    # Отступы закрываются концом файла; фигурные блоки требуют явной «}».
    while стек and стек[-1]["стиль"] == "отступ":
        блок = стек.pop()
        выход.append(" " * блок["отступ"] + _закрытие(блок))

    return "\n".join(выход)


def _нужен_совместимый_разбор(текст):
    if re.search(r"[{}\[\]:;=+*/%<>]", текст):
        return True
    if re.search(r"\s-\s|\+\+|--|[+*/%-]=", текст):
        return True
    for строка in текст.splitlines():
        строка = строка.strip()
        if строка.endswith(")") and not строка.endswith((".", "!", "?")):
            return True
    return False


def нормализовать(текст):
    """Переводит совместимую русскую запись в базовую грамматику Лексики."""
    if not _нужен_совместимый_разбор(текст):
        return текст
    return _перевести_знаки(_блоки(текст))
