#!/usr/bin/env python3

import os
import sys


ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
КОРЕНЬ = os.path.dirname(ЗДЕСЬ)
sys.path.insert(0, КОРЕНЬ)

if not getattr(sys, "_лексика_загрузка", False):
    _загрузка = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_загрузка, encoding="utf-8") as _файл:
        exec(compile(_файл.read(), _загрузка, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _загрузка})


from лексика import словарь

ЗНАЧЕНИЯ = {
    "пусть": "завести имя: «пусть счёт равно нулю»",
    "равно": "связка имени и значения, а также сравнение «равно»",
    "положить": "положить значение во имя: «положить пять в сумму»",
    "увеличить": "прибавить к имени: «увеличить счёт на два»",
    "уменьшить": "отнять от имени: «уменьшить счёт на два»",
    "прибавить": "прибавить к имени, дополнение в дательном падеже",
    "отнять": "отнять от имени, дополнение в родительном падеже",
    "умножить": "умножить имя на значение, а также знак умножения",
    "разделить": "разделить имя на значение, а также знак деления",
    "сказать": "вывести значение в поток речи",
    "спросить": "спросить у человека строку и записать в имя",
    "если": "начало ветвления, условие стоит до слова «то»",
    "то": "отделяет условие от действий ветвления",
    "иначе": "ветвь, которая срабатывает при ложном условии",
    "конец": "закрывает составной замысел",
    "пока": "цикл с условием: «пока счёт меньше трёх повторять»",
    "повторять": "слово-открытие тела цикла",
    "раз": "счётчик повторов: «повторить три раза»",
    "для": "начало перебора: «для каждого предмета из перечня»",
    "каждый": "слово перебора",
    "правило": "объявление подпрограммы: «правило сумма принимает а, б»",
    "принимает": "вводит список имён, которые принимает правило",
    "вернуть": "вернуть значение из правила",
    "прервать": "выйти из ближайшего цикла",
    "продолжить": "перейти к следующему витку цикла",
    "подключить": "подключить словарь правил из библиотеки",
    "позвать": "вызвать правило как отдельное действие",
    "речь": "открывает строку, закрывается словами «конец речи»",
    "истина": "логическая правда",
    "ложь": "логическая ложь",
    "ничто": "пустое значение",
    "и": "логическое «и», а также склейка перечней",
    "или": "логическое «или»",
    "не": "логическое отрицание",
    "плюс": "сложение чисел или склейка речей",
    "минус": "вычитание, а также знак отрицательного числа",
    "больше": "сравнение «больше»",
    "меньше": "сравнение «меньше»",
    "содержит": "проверка, есть ли значение внутри перечня, словаря или речи",
    "остаток": "остаток от деления",
    "длина": "длина перечня, словаря или речи, имя в родительном падеже",
    "взять": "взять элемент перечня по номеру: «взять из перечня два»",
    "добавить": "добавить значение в перечень: «добавить в перечень предмет»",
    "убрать": "убрать элемент перечня по номеру",
    "записать": "записать значение в словарь по ключу",
    "прочитать": "прочитать значение из словаря по ключу",
    "ключи": "перечень ключей словаря",
    "заметка": "примечание до конца строки, движок его пропускает",
}

КАТЕГОРИИ = [
    ("Объявление и присваивание", ["пусть", "равно", "положить", "увеличить",
                                   "уменьшить", "прибавить", "отнять", "умножить",
                                   "разделить"]),
    ("Ветвление и циклы", ["если", "то", "иначе", "конец", "пока", "повторять",
                           "раз", "для", "каждый", "прервать", "продолжить"]),
    ("Подпрограммы и словари правил", ["правило", "принимает", "вернуть", "позвать",
                                       "подключить"]),
    ("Речь и значения", ["сказать", "спросить", "речь", "истина", "ложь", "ничто"]),
    ("Знаки действий", ["и", "или", "не", "плюс", "минус", "больше", "меньше",
                        "содержит", "остаток"]),
    ("Перечни и словари", ["длина", "взять", "добавить", "убрать", "записать",
                           "прочитать", "ключи"]),
    ("Знаки письма", ["заметка"]),
]


def собрать():
    строки = []
    строки.append("# Словарь языка Лексика\n")
    строки.append("Словарь собран из самого движка: запустите "
                  "`python3 лексика/собрать_словарь.lek`, и файл обновится.\n")
    строки.append("Ключевое слово узнаётся **по начальной форме**, поэтому"
                  " `сказать`, `скажи`, `сказал`, `скажет` — одно слово языка."
                  " Обычные имена движок склоняет сам, и они узнаются в любом"
                  " падеже: `сумма`, `суммы`, `сумме`, `сумму`, `суммой`.\n")

    всего = 0
    for название, леммы in КАТЕГОРИИ:
        строки.append(f"## {название}\n")
        строки.append("| слово | узнаётся как | что значит |")
        строки.append("|---|---|---|")
        for лемма in леммы:
            формы = sorted(словарь.СЛУЖЕБНЫЕ.get(лемма, {лемма}))
            всего += len(формы)
            показ = ", ".join(формы[:7]) + (" …" if len(формы) > 7 else "")
            строки.append(f"| **{лемма}** | {показ} | {ЗНАЧЕНИЯ.get(лемма, '')} |")
        строки.append("")

    строки.append("## Встроенные команды с падежным управлением\n")
    строки.append("Команда сама указывает, в каком падеже стоит имя.\n")
    строки.append("| команда | образец | что делает |")
    строки.append("|---|---|---|")
    for имя, данные in sorted(словарь.КОМАНДЫ.items()):
        строки.append(f"| **{имя}** | `{данные['пример']}` | {данные['описание']} |")
    строки.append("")

    строки.append("## Встроенные функции\n")
    строки.append("Функции узнаются по скобке после слова, поэтому имя переменной"
                  " может совпадать с их именем.\n")
    строки.append("| запись | что делает |")
    строки.append("|---|---|")
    for имя, данные in sorted(словарь.ФУНКЦИИ.items()):
        строки.append(f"| `{данные['бедно']}` | {данные['описание']} |")
    строки.append("")

    строки.append("## Предлоги и падежи\n")
    строки.append("| предлог | падеж |")
    строки.append("|---|---|")
    for предлог, падеж in sorted(словарь.ПРЕДЛОГИ.items()):
        from лексика import морфология
        строки.append(f"| {предлог} | {морфология.ПАДЕЖ_ИМЯ[падеж]} |")
    строки.append("")
    строки.append(f"Всего словоформ в служебной части словаря: **{всего}**.")
    строки.append("")
    return "\n".join(строки)


def main():
    текст = собрать()
    путь = os.path.join(КОРЕНЬ, "документы", "СЛОВАРЬ.md")
    os.makedirs(os.path.dirname(путь), exist_ok=True)
    with open(путь, "w", encoding="utf-8") as файл:
        файл.write(текст)
    print(f"словарь собран: {путь}, знаков: {len(текст)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
