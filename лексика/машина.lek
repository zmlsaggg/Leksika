from . import байткод, грамматика as гр
from .ошибки import ОшибкаСмысла
from .исполнитель import Область, как_речь

ПРЕДЕЛ_ВИТКОВ = 10_000_000
ПРЕДЕЛ_ВЛОЖЕННОСТИ = 2000


class Кадр:
    def __init__(self, возврат, имя="главная", областей=1):
        self.возврат = возврат
        self.имя = имя
        self.циклы = []
        self.областей = областей


class Цикл:
    def __init__(self, вид, конец=0):
        self.вид = вид
        self.конец = конец
        self.остаток = 0
        self.предметы = []
        self.место = 0
        self.имя = ""


class Машина:
    def __init__(self, исполнитель):
        self.и = исполнитель
        self.программа = байткод.Программа([], {}, [])
        self.указатель = 0
        self.кадры = [Кадр(None)]
        self.последнее = None
        self.вызов_дерева = исполнитель.__class__.вызвать.__get__(исполнитель)

    def кадр(self):
        return self.кадры[-1]

    def исполнить(self, узлы):
        self.программа = байткод.собрать(узлы)
        self.указатель = 0
        self.кадры = [Кадр(None, областей=len(self.и.области))]
        self.и.вызвать = self.позвать
        self.бежать()
        return self.программа

    def бежать(self, до=None):
        команды = self.программа.команды
        витков = 0
        while 0 <= self.указатель < len(команды):
            витков += 1
            if витков > ПРЕДЕЛ_ВИТКОВ:
                raise ОшибкаСмысла("программа крутится слишком долго", 0, 0,
                                   "проверьте условия замыслов")
            команда = команды[self.указатель]
            шаг = getattr(self, "_" + команда[0], None)
            if шаг is None:
                raise ОшибкаСмысла(f"машина не знает команду «{команда[0]}»")
            if шаг(команда) is False:
                return
            if до is not None and len(self.кадры) < до:
                return

    def _имя_узел(self, данные):
        return гр.Имя(данные[1], данные[2], данные[3], данные[4])

    def _восстановить_узел(self, данные):
        вид = данные[0]
        if вид == "ничто":
            return None
        if вид == "число":
            return гр.Число(данные[1])
        if вид == "постоянное":
            return гр.Постоянное(данные[1])
        if вид == "имя":
            return self._имя_узел(данные)
        if вид == "речь":
            части = []
            for вид_части, часть in данные[1]:
                if вид_части == "текст":
                    части.append(("т", часть))
                else:
                    части.append(("к", self._восстановить_узел(часть)))
            return гр.Речь(части)
        if вид == "отрицание":
            return гр.Отрицание(self._восстановить_узел(данные[1]))
        if вид == "действие":
            return гр.Действие(
                данные[1],
                self._восстановить_узел(данные[2]),
                self._восстановить_узел(данные[3]),
            )
        if вид == "вызов":
            return гр.Вызов(
                данные[1],
                [self._восстановить_узел(а) for а in данные[2]],
                данные[3], данные[4],
            )
        if вид == "команда":
            слоты = [
                (метка, падеж, self._восстановить_узел(значение))
                for метка, падеж, значение in данные[2]
            ]
            return гр.Команда(данные[1], слоты, данные[3], данные[4])
        raise ОшибкаСмысла(f"неизвестный вид временного узла «{вид}»")

    def _прочитать_имя(self, слово, лемма, строка, столбец):
        узел = гр.Имя(слово, лемма, строка, столбец)
        try:
            return self.и.значение_имени(узел)[1]
        except ОшибкаСмысла:
            if слово[:1].isupper():
                return слово
            raise self.и.подсказать_речь(узел)

    def _вычислить_код(self, код):
        стек = []
        for инструкция in код:
            вид = инструкция[0]
            if вид == "константа":
                стек.append(инструкция[1])
            elif вид == "прочитать_имя":
                стек.append(self._прочитать_имя(
                    инструкция[1], инструкция[2], инструкция[3], инструкция[4]))
            elif вид == "собрать_речь":
                части = []
                for вид_части, часть in инструкция[1]:
                    if вид_части == "текст":
                        части.append(часть)
                    else:
                        части.append(как_речь(self._вычислить_код(часть)))
                стек.append("".join(части))
            elif вид == "не":
                if not стек:
                    raise ОшибкаСмысла("повреждён стековый байткод: не хватает значения")
                стек.append(not self.и.правда(стек.pop()))
            elif вид == "действие":
                if len(стек) < 2:
                    raise ОшибкаСмысла("повреждён стековый байткод: не хватает двух значений")
                право = стек.pop()
                лево = стек.pop()
                стек.append(self.и.действие(инструкция[1], лево, право))
            elif вид == "вызвать":
                имя, аргументы, строка, столбец = инструкция[1:]
                значения = [self._вычислить_код(код_аргумента) for код_аргумента in аргументы]
                стек.append(self.позвать(имя, значения, строка, столбец))
            elif вид == "выполнить_команду":
                узел = self._восстановить_узел(инструкция[1])
                стек.append(self.и._Команда(узел))
            else:
                raise ОшибкаСмысла(f"машина не знает стековую инструкцию «{вид}»")
        if len(стек) != 1:
            raise ОшибкаСмысла(
                f"повреждён стековый байткод: после выражения осталось значений {len(стек)}")
        return стек[0]

    def считать(self, ссылка):
        if ссылка is None:
            return None
        if not isinstance(ссылка, int) or isinstance(ссылка, bool):
            raise ОшибкаСмысла("операнд байткода должен быть номером выражения")
        if not 0 <= ссылка < len(self.программа.выражения):
            raise ОшибкаСмысла("номер выражения выходит за границы таблицы байткода")
        return self._вычислить_код(self.программа.выражения[ссылка])

    def _объявить(self, команда):
        self.и.области[-1].завести(команда[1], self.считать(команда[2]))
        self.указатель += 1

    def _присвоить(self, команда):
        self.и.записать_имя(команда[1], self.считать(команда[2]))
        self.указатель += 1

    def _изменить(self, команда):
        _, старое = self.и.значение_имени(команда[1])
        прибавка = self.считать(команда[3])
        знаки = {"+": "плюс", "-": "минус", "*": "умножить", "/": "разделить"}
        новое = self.и.действие(знаки.get(команда[2], команда[2]), старое, прибавка)
        self.и.записать_имя(команда[1], новое)
        self.указатель += 1

    def _сказать(self, команда):
        self.и.вывод(как_речь(self.считать(команда[1])))
        self.указатель += 1

    def _спросить(self, команда):
        подсказка = self.считать(команда[2]) if команда[2] is not None else ""
        try:
            ответ = self.и.ввод(как_речь(подсказка) if подсказка is not None else "")
        except EOFError:
            raise ОшибкаСмысла(
                "ввод закончился, а программа ждёт ответа", 0, 0,
                "передайте данные в программу или уберите «спросить»",
            )
        self.и.области[-1].завести(команда[1], ответ)
        self.указатель += 1

    def _команда(self, команда):
        self.и.шаг(self._восстановить_узел(команда[1]))
        self.указатель += 1

    def _шаг(self, команда):
        self.и.шаг(self._восстановить_узел(команда[1]))
        self.указатель += 1

    def _подключить(self, команда):
        self.и.подключить(команда[1])
        self.указатель += 1

    def _перейти(self, команда):
        self.указатель = команда[1]

    def _если_нет(self, команда):
        if self.и.правда(self.считать(команда[1])):
            self.указатель += 1
        else:
            self.указатель = команда[2]

    def _правило(self, команда):
        self.указатель += 1

    def _позвать(self, команда):
        имя, ссылки, строка, столбец = команда[1:]
        значения = [self.считать(ссылка) for ссылка in ссылки]
        self.позвать(имя, значения, строка, столбец)
        self.указатель += 1

    def позвать(self, имя, значения=None, строка=0, столбец=0):
        if isinstance(имя, гр.Вызов):
            узел = имя
            значения_узла = [self.и.считать(аргумент) for аргумент in узел.аргументы]
            return self.позвать(узел.имя, значения_узла, узел.строка, узел.столбец)
        значения = list(значения or [])
        запись = self.программа.правила.get(имя)
        if запись is None:
            if имя in self.и.правила:
                узел = гр.Вызов(
                    имя, [гр.Постоянное(значение) for значение in значения],
                    строка, столбец,
                )
                return self.вызов_дерева(узел)
            узел = гр.Вызов(имя, [], строка, столбец)
            return self.и.встроенная(имя, значения, узел)

        адрес, параметры, _ = запись
        if len(значения) != len(параметры):
            raise ОшибкаСмысла(
                f"правило «{имя}» ждёт {len(параметры)} значений, "
                f"а получило {len(значения)}", строка, столбец)
        if len(self.кадры) > ПРЕДЕЛ_ВЛОЖЕННОСТИ:
            raise ОшибкаСмысла("слишком глубокая вложенность правил", строка, столбец)

        область = Область(self.и.области[-1], "правило " + имя)
        for параметр, значение in zip(параметры, значения):
            область.завести(параметр, значение)
        self.и.области.append(область)

        место_вызова = self.указатель
        self.кадры.append(Кадр(место_вызова + 1, имя, len(self.и.области)))
        self.указатель = адрес
        self.последнее = None
        self.бежать(до=len(self.кадры))
        self.указатель = место_вызова
        return self.последнее

    def _вернуть(self, команда):
        значение = self.считать(команда[1]) if команда[1] is not None else None
        if len(self.кадры) == 1:
            self.указатель = len(self.программа.команды)
            return
        кадр = self.кадры.pop()
        while len(self.и.области) > кадр.областей - 1:
            self.и.области.pop()
        self.последнее = значение
        self.указатель = кадр.возврат

    def _прервать(self, команда):
        цель = команда[1]
        кадр = self.кадр()
        if кадр.циклы and кадр.циклы[-1].конец == цель:
            self._взять_цикл()
        self.указатель = цель

    def _продолжить(self, команда):
        self.указатель = команда[1]

    def _повторить_начало(self, команда):
        сколько = self.считать(команда[1])
        if not isinstance(сколько, (int, float)) or isinstance(сколько, bool):
            raise ОшибкаСмысла(
                f"повторить можно только число, а получено {self.и.имя_вида(сколько)}")
        if int(сколько) <= 0:
            self.указатель = команда[2]
            return
        цикл = Цикл("повторить", конец=команда[2])
        цикл.остаток = int(сколько)
        self.кадр().циклы.append(цикл)
        self.указатель += 1

    def _повторить_шаг(self, команда):
        цикл = self.кадр().циклы[-1]
        цикл.остаток -= 1
        if цикл.остаток > 0:
            self.указатель = команда[1]
        else:
            self.кадр().циклы.pop()
            self.указатель += 1

    def _перебор_начало(self, команда):
        перечень = self.считать(команда[2])
        if isinstance(перечень, dict):
            перечень = list(перечень.keys())
        if isinstance(перечень, str):
            перечень = list(перечень)
        if not isinstance(перечень, list):
            raise ОшибкаСмысла(
                f"перебрать можно перечень, словарь или речь, а получено {self.и.имя_вида(перечень)}")
        if not перечень:
            self.указатель = команда[3]
            return
        область = Область(self.и.области[-1], "перебор")
        self.и.области.append(область)
        область.завести(команда[1], перечень[0])
        цикл = Цикл("перебор", конец=команда[3])
        цикл.предметы = перечень
        цикл.имя = команда[1]
        self.кадр().циклы.append(цикл)
        self.указатель += 1

    def _перебор_шаг(self, команда):
        цикл = self.кадр().циклы[-1]
        цикл.место += 1
        if цикл.место < len(цикл.предметы):
            self.и.области[-1].завести(цикл.имя, цикл.предметы[цикл.место])
            self.указатель = команда[1]
            return
        self.и.области.pop()
        self.кадр().циклы.pop()
        self.указатель += 1

    def _взять_цикл(self):
        if not self.кадр().циклы:
            raise ОшибкаСмысла("прервать можно только внутри замысла")
        цикл = self.кадр().циклы.pop()
        if цикл.вид == "перебор":
            self.и.области.pop()
        return цикл

    def _конец(self, команда):
        return False


def исполнить(узлы, исполнитель):
    машина = Машина(исполнитель)
    машина.исполнить(узлы)
    return машина
