from . import байткод, грамматика as гр
import math
import random
import time
from .ошибки import ОшибкаСмысла
from .исполнитель import Область, как_речь

ПРЕДЕЛ_ВИТКОВ = 10_000_000
ПРЕДЕЛ_ВЛОЖЕННОСТИ = 2000


class Кадр:
    def __init__(self, возврат, имя="главная", областей=1):
        self.возврат = возврат
        self.имя = имя
        self.циклы = []
        self.областей = областей


class Цикл:
    def __init__(self, вид, конец=0):
        self.вид = вид
        self.конец = конец
        self.остаток = 0
        self.предметы = []
        self.место = 0
        self.имя = ""


class Машина:
    def __init__(self, исполнитель):
        self.и = исполнитель
        self.программа = байткод.Программа([], {}, [])
        self.указатель = 0
        self.кадры = [Кадр(None)]
        self.последнее = None
        self.вызов_дерева = исполнитель.__class__.вызвать.__get__(исполнитель)

    def кадр(self):
        return self.кадры[-1]

    def исполнить(self, узлы):
        self.программа = байткод.собрать(узлы)
        self.указатель = 0
        self.кадры = [Кадр(None, областей=len(self.и.области))]
        self.и.вызвать = self.позвать
        self.бежать()
        return self.программа

    def бежать(self, до=None):
        команды = self.программа.команды
        витков = 0
        while 0 <= self.указатель < len(команды):
            витков += 1
            if витков > ПРЕДЕЛ_ВИТКОВ:
                raise ОшибкаСмысла("программа крутится слишком долго", 0, 0,
                                   "проверьте условия замыслов")
            команда = команды[self.указатель]
            шаг = getattr(self, "_" + команда[0], None)
            if шаг is None:
                raise ОшибкаСмысла(f"машина не знает команду «{команда[0]}»")
            if шаг(команда) is False:
                return
            if до is not None and len(self.кадры) < до:
                return

    def _прочитать_имя(self, слово, лемма, строка, столбец):
        узел = гр.Имя(слово, лемма, строка, столбец)
        try:
            return self.и.значение_имени(узел)[1]
        except ОшибкаСмысла:
            if слово[:1].isupper():
                return слово
            raise self.и.подсказать_речь(узел)

    def _имя_вида(self, значение):
        if значение is None:
            return "ничто"
        if isinstance(значение, bool):
            return "логическое значение"
        if isinstance(значение, (int, float)):
            return "число"
        if isinstance(значение, str):
            return "речь"
        if isinstance(значение, list):
            return "перечень"
        if isinstance(значение, dict):
            return "словарь"
        return "значение"

    def _правда(self, значение):
        if isinstance(значение, bool):
            return значение
        if значение is None:
            return False
        if isinstance(значение, (int, float)):
            return значение != 0
        if isinstance(значение, (str, list, dict)):
            return len(значение) > 0
        return True

    def _число(self, значение, где="вычисление"):
        if isinstance(значение, bool) or not isinstance(значение, (int, float)):
            raise ОшибкаСмысла(
                f"{где} ждёт число, а получено {self._имя_вида(значение)}")
        return значение

    def _явное_число(self, значение):
        if isinstance(значение, bool):
            return 1 if значение else 0
        if isinstance(значение, (int, float)):
            return значение
        if isinstance(значение, str):
            запись = значение.strip().replace(",", ".")
            try:
                return float(запись) if "." in запись else int(запись)
            except ValueError:
                raise ОшибкаСмысла(
                    f"речь «{значение}» не похожа на число",
                    0, 0,
                    "в числе допустимы только цифры, знак минус и слово «запятая»",
                )
        raise ОшибкаСмысла(
            f"число нельзя получить из значения вида «{self._имя_вида(значение)}»")

    def _равно(self, лево, право):
        if isinstance(лево, bool) or isinstance(право, bool):
            return isinstance(лево, bool) and isinstance(право, bool) and лево == право
        if isinstance(лево, (int, float)) or isinstance(право, (int, float)):
            return (isinstance(лево, (int, float)) and
                    not isinstance(лево, bool) and
                    isinstance(право, (int, float)) and
                    not isinstance(право, bool) and лево == право)
        if type(лево) is not type(право):
            return False
        if isinstance(лево, list):
            return (len(лево) == len(право) and
                    all(self._равно(a, b) for a, b in zip(лево, право)))
        if isinstance(лево, dict):
            return (лево.keys() == право.keys() and
                    all(self._равно(лево[k], право[k]) for k in лево))
        return лево == право

    def _действие(self, знак, лево, право):
        if знак == "и":
            return self._правда(лево) and self._правда(право)
        if знак == "или":
            return self._правда(лево) or self._правда(право)
        if знак == "содержит":
            if isinstance(лево, (str, list, dict)):
                искомое = как_речь(право) if isinstance(лево, str) else право
                return искомое in лево
            raise ОшибкаСмысла(
                f"у {self._имя_вида(лево)} не бывает содержимого")
        if знак in ("равно", "неравно"):
            одинаково = self._равно(лево, право)
            return одинаково if знак == "равно" else not одинаково
        if знак in ("больше", "меньше", "неменьше", "небольше"):
            a = self._число(лево, "сравнение")
            b = self._число(право, "сравнение")
            if знак == "больше":
                return a > b
            if знак == "меньше":
                return a < b
            if знак == "неменьше":
                return a >= b
            return a <= b
        if знак == "плюс":
            if isinstance(лево, str) and isinstance(право, str):
                return лево + право
            if isinstance(лево, list) and isinstance(право, list):
                return лево + право
            if (isinstance(лево, (int, float)) and not isinstance(лево, bool) and
                    isinstance(право, (int, float)) and not isinstance(право, bool)):
                return лево + право
            raise ОшибкаСмысла(
                f"сложение не определено для видов «{self._имя_вида(лево)}» "
                f"и «{self._имя_вида(право)}»")
        if знак in ("минус", "умножить", "разделить", "остаток", "степень"):
            a = self._число(лево)
            b = self._число(право)
            if знак == "минус":
                return a - b
            if знак == "умножить":
                return a * b
            if знак == "разделить":
                if b == 0:
                    raise ОшибкаСмысла(
                        "делить на ноль нельзя", 0, 0,
                        "проверьте делитель до деления")
                return a / b
            if знак == "остаток":
                if b == 0:
                    raise ОшибкаСмысла("остаток от деления на ноль не существует")
                return a % b
            if знак == "степень":
                return a ** b
        raise ОшибкаСмысла(f"неизвестное действие «{знак}»")

    def _по_номеру(self, перечень, номер):
        if isinstance(перечень, dict):
            if номер in перечень:
                return перечень[номер]
            raise ОшибкаСмысла(f"в словаре нет ключа «{как_речь(номер)}»")
        if not isinstance(перечень, (list, str)):
            raise ОшибкаСмысла(
                f"взять можно из перечня, речи или словаря, а получено {self._имя_вида(перечень)}")
        if isinstance(номер, bool) or not isinstance(номер, (int, float)):
            raise ОшибкаСмысла("номер элемента должен быть числом")
        номер = int(номер)
        if not 0 <= номер < len(перечень):
            raise ОшибкаСмысла(
                f"в перечне нет номера {номер}",
                0, 0,
                f"сейчас доступно элементов: {len(перечень)}")
        return перечень[номер]

    def _вычислить_код(self, код):
        стек = []
        for инструкция in код:
            вид = инструкция[0]
            if вид == "константа":
                стек.append(инструкция[1])
            elif вид == "прочитать_имя":
                стек.append(self._прочитать_имя(
                    инструкция[1], инструкция[2], инструкция[3], инструкция[4]))
            elif вид == "собрать_речь":
                части = []
                for вид_части, часть in инструкция[1]:
                    if вид_части == "текст":
                        части.append(часть)
                    else:
                        части.append(как_речь(self._вычислить_код(часть)))
                стек.append("".join(части))
            elif вид == "не":
                if not стек:
                    raise ОшибкаСмысла("повреждён стековый байткод: не хватает значения")
                стек.append(not self._правда(стек.pop()))
            elif вид == "действие":
                if len(стек) < 2:
                    raise ОшибкаСмысла("повреждён стековый байткод: не хватает двух значений")
                право = стек.pop()
                лево = стек.pop()
                стек.append(self._действие(инструкция[1], лево, право))
            elif вид == "вызвать":
                имя, аргументы, строка, столбец = инструкция[1:]
                значения = [self._вычислить_код(код_аргумента) for код_аргумента in аргументы]
                стек.append(self.позвать(имя, значения, строка, столбец))
            elif вид == "выполнить_команду":
                стек.append(self._исполнить_команду(инструкция[1]))
            else:
                raise ОшибкаСмысла(f"машина не знает стековую инструкцию «{вид}»")
        if len(стек) != 1:
            raise ОшибкаСмысла(
                f"повреждён стековый байткод: после выражения осталось значений {len(стек)}")
        return стек[0]

    def _значение_слота(self, операнд, падеж=None, ключ=False):
        вид = операнд[0]
        if вид == "код":
            return self._вычислить_код(операнд[1])
        if вид == "имя":
            слово = операнд[1]
            try:
                return self.и.значение_имени(слово, падеж)[1]
            except ОшибкаСмысла:
                if ключ or слово[:1].isupper():
                    return слово
                raise
        raise ОшибкаСмысла(f"неизвестный операнд команды «{вид}»")

    def _исполнить_команду(self, данные):
        _, имя, слоты, строка, столбец = данные

        def слот(номер):
            if not 0 <= номер < len(слоты):
                raise ОшибкаСмысла(
                    f"команда «{имя}» получила неверное число аргументов",
                    строка, столбец,
                )
            return слоты[номер]

        def значение(номер, ключ=False):
            _, падеж, операнд = слот(номер)
            return self._значение_слота(операнд, падеж, ключ)

        if имя == "длина":
            предмет = значение(0)
            if isinstance(предмет, (str, list, dict)):
                return len(предмет)
            raise ОшибкаСмысла(
                f"у {self._имя_вида(предмет)} нет длины",
                строка, столбец,
                "длина берётся у речи, перечня или словаря",
            )

        if имя == "взять":
            перечень = значение(0)
            номер = значение(1)
            return self._по_номеру(перечень, номер)

        if имя == "прочитать":
            словарь = значение(0)
            ключ = значение(1, ключ=True)
            if not isinstance(словарь, dict):
                raise ОшибкаСмысла("прочитать можно только из словаря", строка, столбец)
            if ключ not in словарь:
                raise ОшибкаСмысла(
                    f"в словаре нет ключа «{как_речь(ключ)}»",
                    строка, столбец,
                    "проверьте ключ или запишите значение заранее",
                )
            return словарь[ключ]

        if имя == "добавить":
            перечень = значение(0)
            if not isinstance(перечень, list):
                raise ОшибкаСмысла("добавлять можно только в перечень", строка, столбец)
            перечень.append(значение(1))
            return None

        if имя == "убрать":
            перечень = значение(0)
            номер = значение(1)
            if not isinstance(перечень, list):
                raise ОшибкаСмысла("убирать можно только из перечня", строка, столбец)
            if not isinstance(номер, (int, float)) or isinstance(номер, bool):
                raise ОшибкаСмысла("номер должен быть числом", строка, столбец)
            номер = int(номер)
            if not 0 <= номер < len(перечень):
                raise ОшибкаСмысла(
                    f"в перечне нет номера {номер}",
                    строка, столбец,
                    f"сейчас в перечне {len(перечень)} предметов",
                )
            перечень.pop(номер)
            return None

        if имя == "записать":
            словарь = значение(0)
            ключ = значение(1, ключ=True)
            if not isinstance(словарь, dict):
                raise ОшибкаСмысла("записывать можно только в словарь", строка, столбец)
            словарь[ключ] = значение(2)
            return None

        raise ОшибкаСмысла(f"неизвестная команда «{имя}»", строка, столбец)

    def считать(self, ссылка):
        if ссылка is None:
            return None
        if not isinstance(ссылка, int) or isinstance(ссылка, bool):
            raise ОшибкаСмысла("операнд байткода должен быть номером выражения")
        if not 0 <= ссылка < len(self.программа.выражения):
            raise ОшибкаСмысла("номер выражения выходит за границы таблицы байткода")
        return self._вычислить_код(self.программа.выражения[ссылка])

    def _объявить(self, команда):
        self.и.области[-1].завести(команда[1], self.считать(команда[2]))
        self.указатель += 1

    def _присвоить(self, команда):
        self.и.записать_имя(команда[1], self.считать(команда[2]))
        self.указатель += 1

    def _изменить(self, команда):
        _, старое = self.и.значение_имени(команда[1])
        прибавка = self.считать(команда[3])
        знаки = {"+": "плюс", "-": "минус", "*": "умножить", "/": "разделить"}
        новое = self._действие(знаки.get(команда[2], команда[2]), старое, прибавка)
        self.и.записать_имя(команда[1], новое)
        self.указатель += 1

    def _сказать(self, команда):
        self.и.вывод(как_речь(self.считать(команда[1])))
        self.указатель += 1

    def _спросить(self, команда):
        подсказка = self.считать(команда[2]) if команда[2] is not None else ""
        try:
            ответ = self.и.ввод(как_речь(подсказка) if подсказка is not None else "")
        except EOFError:
            raise ОшибкаСмысла(
                "ввод закончился, а программа ждёт ответа", 0, 0,
                "передайте данные в программу или уберите «спросить»",
            )
        self.и.области[-1].завести(команда[1], ответ)
        self.указатель += 1

    def _команда(self, команда):
        self._исполнить_команду(команда[1])
        self.указатель += 1

    def _подключить(self, команда):
        self.и.подключить(команда[1])
        self.указатель += 1

    def _перейти(self, команда):
        self.указатель = команда[1]

    def _если_нет(self, команда):
        if self._правда(self.считать(команда[1])):
            self.указатель += 1
        else:
            self.указатель = команда[2]

    def _правило(self, команда):
        self.указатель += 1

    def _позвать(self, команда):
        имя, ссылки, строка, столбец = команда[1:]
        значения = [self.считать(ссылка) for ссылка in ссылки]
        self.позвать(имя, значения, строка, столбец)
        self.указатель += 1

    def _встроенная(self, имя, значения, строка=0, столбец=0):
        """Исполняет стандартные функции из VM; AST и узлы компилятора не создаются."""
        def ждать(сколько):
            if len(значения) != сколько:
                raise ОшибкаСмысла(
                    f"встроенная функция «{имя}» ждёт {сколько} значений, "
                    f"а получено {len(значения)}", строка, столбец,
                )

        if имя == "перечень":
            return list(значения)
        if имя == "словарь":
            return {}
        if имя == "молча":
            ждать(1)
            return значения[0]
        if имя == "остаток":
            ждать(2)
            делитель = self._число(значения[1], "остаток")
            if делитель == 0:
                raise ОшибкаСмысла("остаток от деления на ноль не существует", строка, столбец)
            return self._число(значения[0], "остаток") % делитель
        if имя == "число":
            ждать(1)
            return self._явное_число(значения[0])
        if имя == "строка":
            ждать(1)
            return как_речь(значения[0])
        if имя == "модуль":
            ждать(1)
            return abs(self._число(значения[0], "модуль"))
        if имя == "корень":
            ждать(1)
            значение = self._число(значения[0], "корень")
            if значение < 0:
                raise ОшибкаСмысла("корень отрицательного числа не определён", строка, столбец)
            return math.sqrt(значение)
        if имя == "округлить":
            ждать(1)
            return round(self._число(значения[0], "округлить"))
        if имя == "целое":
            ждать(1)
            return int(self._число(значения[0], "целое"))
        if имя == "случайное":
            ждать(2)
            от = int(self._число(значения[0], "случайное"))
            до = int(self._число(значения[1], "случайное"))
            if от > до:
                raise ОшибкаСмысла("нижняя граница случайного числа больше верхней", строка, столбец)
            return random.randint(от, до)
        if имя == "ключи":
            ждать(1)
            if not isinstance(значения[0], dict):
                raise ОшибкаСмысла("ключи берутся только у словаря", строка, столбец)
            return list(значения[0].keys())
        if имя == "буквы":
            ждать(1)
            return list(как_речь(значения[0]))
        if имя == "время":
            ждать(0)
            return time.strftime("%H:%M:%S")

        # Совместимый путь оставлен только для сторонних/подключаемых функций.
        return self.и.встроенная(
            имя, значения, строка=строка, столбец=столбец,
        )

    def позвать(self, имя, значения=None, строка=0, столбец=0):
        if isinstance(имя, гр.Вызов):
            узел = имя
            значения_узла = [self.и.считать(аргумент) for аргумент in узел.аргументы]
            return self.позвать(узел.имя, значения_узла, узел.строка, узел.столбец)
        значения = list(значения or [])
        запись = self.программа.правила.get(имя)
        if запись is None:
            if имя in self.и.правила:
                узел = гр.Вызов(
                    имя, [гр.Постоянное(значение) for значение in значения],
                    строка, столбец,
                )
                return self.вызов_дерева(узел)
            return self._встроенная(имя, значения, строка, столбец)

        адрес, параметры, _ = запись
        if len(значения) != len(параметры):
            raise ОшибкаСмысла(
                f"правило «{имя}» ждёт {len(параметры)} значений, "
                f"а получило {len(значения)}", строка, столбец)
        if len(self.кадры) > ПРЕДЕЛ_ВЛОЖЕННОСТИ:
            raise ОшибкаСмысла("слишком глубокая вложенность правил", строка, столбец)

        область = Область(self.и.области[-1], "правило " + имя)
        for параметр, значение in zip(параметры, значения):
            область.завести(параметр, значение)
        self.и.области.append(область)

        место_вызова = self.указатель
        self.кадры.append(Кадр(место_вызова + 1, имя, len(self.и.области)))
        self.указатель = адрес
        self.последнее = None
        self.бежать(до=len(self.кадры))
        self.указатель = место_вызова
        return self.последнее

    def _вернуть(self, команда):
        значение = self.считать(команда[1]) if команда[1] is not None else None
        if len(self.кадры) == 1:
            self.указатель = len(self.программа.команды)
            return
        кадр = self.кадры.pop()
        while len(self.и.области) > кадр.областей - 1:
            self.и.области.pop()
        self.последнее = значение
        self.указатель = кадр.возврат

    def _прервать(self, команда):
        цель = команда[1]
        кадр = self.кадр()
        if кадр.циклы and кадр.циклы[-1].конец == цель:
            self._взять_цикл()
        self.указатель = цель

    def _продолжить(self, команда):
        self.указатель = команда[1]

    def _повторить_начало(self, команда):
        сколько = self.считать(команда[1])
        if not isinstance(сколько, (int, float)) or isinstance(сколько, bool):
            raise ОшибкаСмысла(
                f"повторить можно только число, а получено {self._имя_вида(сколько)}")
        if int(сколько) <= 0:
            self.указатель = команда[2]
            return
        цикл = Цикл("повторить", конец=команда[2])
        цикл.остаток = int(сколько)
        self.кадр().циклы.append(цикл)
        self.указатель += 1

    def _повторить_шаг(self, команда):
        цикл = self.кадр().циклы[-1]
        цикл.остаток -= 1
        if цикл.остаток > 0:
            self.указатель = команда[1]
        else:
            self.кадр().циклы.pop()
            self.указатель += 1

    def _перебор_начало(self, команда):
        перечень = self.считать(команда[2])
        if isinstance(перечень, dict):
            перечень = list(перечень.keys())
        if isinstance(перечень, str):
            перечень = list(перечень)
        if not isinstance(перечень, list):
            raise ОшибкаСмысла(
                f"перебрать можно перечень, словарь или речь, а получено {self._имя_вида(перечень)}")
        if not перечень:
            self.указатель = команда[3]
            return
        область = Область(self.и.области[-1], "перебор")
        self.и.области.append(область)
        область.завести(команда[1], перечень[0])
        цикл = Цикл("перебор", конец=команда[3])
        цикл.предметы = перечень
        цикл.имя = команда[1]
        self.кадр().циклы.append(цикл)
        self.указатель += 1

    def _перебор_шаг(self, команда):
        цикл = self.кадр().циклы[-1]
        цикл.место += 1
        if цикл.место < len(цикл.предметы):
            self.и.области[-1].завести(цикл.имя, цикл.предметы[цикл.место])
            self.указатель = команда[1]
            return
        self.и.области.pop()
        self.кадр().циклы.pop()
        self.указатель += 1

    def _взять_цикл(self):
        if not self.кадр().циклы:
            raise ОшибкаСмысла("прервать можно только внутри замысла")
        цикл = self.кадр().циклы.pop()
        if цикл.вид == "перебор":
            self.и.области.pop()
        return цикл

    def _конец(self, команда):
        return False


def исполнить(узлы, исполнитель):
    машина = Машина(исполнитель)
    машина.исполнить(узлы)
    return машина
