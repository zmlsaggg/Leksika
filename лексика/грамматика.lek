
from . import словарь, морфология
from .лексер import разобрать_текст
from .ошибки import ОшибкаГрамматики, ОшибкаПадежа



class Узел:
    __slots__ = ()


class Число(Узел):
    __slots__ = ("значение",)

    def __init__(self, значение):
        self.значение = значение


class Речь(Узел):
    __slots__ = ("части",)

    def __init__(self, части):
        self.части = части


class Имя(Узел):
    __slots__ = ("слово", "лемма", "строка", "столбец")

    def __init__(self, слово, лемма, строка=0, столбец=0):
        self.слово = слово
        self.лемма = лемма
        self.строка = строка
        self.столбец = столбец


class Постоянное(Узел):
    __slots__ = ("значение",)

    def __init__(self, значение):
        self.значение = значение


class Вызов(Узел):
    __slots__ = ("имя", "аргументы", "строка", "столбец")

    def __init__(self, имя, аргументы, строка=0, столбец=0):
        self.имя = имя
        self.аргументы = аргументы
        self.строка = строка
        self.столбец = столбец


class Действие(Узел):
    __slots__ = ("знак", "лево", "право")

    def __init__(self, знак, лево, право):
        self.знак = знак
        self.лево = лево
        self.право = право


class Отрицание(Узел):
    __slots__ = ("выражение",)

    def __init__(self, выражение):
        self.выражение = выражение


class Команда(Узел):
    __slots__ = ("имя", "слоты", "строка", "столбец")

    def __init__(self, имя, слоты, строка=0, столбец=0):
        self.имя = имя
        self.слоты = слоты
        self.строка = строка
        self.столбец = столбец



class Объявить(Узел):
    __slots__ = ("имя", "значение")

    def __init__(self, имя, значение):
        self.имя = имя
        self.значение = значение


class Присвоить(Узел):
    __slots__ = ("имя", "значение", "строка", "столбец")

    def __init__(self, имя, значение, строка=0, столбец=0):
        self.имя = имя
        self.значение = значение
        self.строка = строка
        self.столбец = столбец


class Изменить(Узел):
    __slots__ = ("имя", "знак", "значение", "строка", "столбец")

    def __init__(self, имя, знак, значение, строка=0, столбец=0):
        self.имя = имя
        self.знак = знак
        self.значение = значение
        self.строка = строка
        self.столбец = столбец


class Сказать(Узел):
    __slots__ = ("значение",)

    def __init__(self, значение):
        self.значение = значение


class Спросить(Узел):
    __slots__ = ("имя", "подсказка")

    def __init__(self, имя, подсказка=None):
        self.имя = имя
        self.подсказка = подсказка


class Если(Узел):
    __slots__ = ("ветви", "иначе")

    def __init__(self, ветви, иначе):
        self.ветви = ветви
        self.иначе = иначе


class Пока(Узел):
    __slots__ = ("условие", "тело")

    def __init__(self, условие, тело):
        self.условие = условие
        self.тело = тело


class Повторить(Узел):
    __slots__ = ("сколько", "тело")

    def __init__(self, сколько, тело):
        self.сколько = сколько
        self.тело = тело


class ДляКаждого(Узел):
    __slots__ = ("имя", "перечень", "тело")

    def __init__(self, имя, перечень, тело):
        self.имя = имя
        self.перечень = перечень
        self.тело = тело


class Правило(Узел):
    __slots__ = ("имя", "параметры", "тело", "строка", "столбец")

    def __init__(self, имя, параметры, тело, строка=0, столбец=0):
        self.имя = имя
        self.параметры = параметры
        self.тело = тело
        self.строка = строка
        self.столбец = столбец


class Вернуть(Узел):
    __slots__ = ("значение",)

    def __init__(self, значение):
        self.значение = значение


class Прервать(Узел):
    __slots__ = ()


class Продолжить(Узел):
    __slots__ = ()


class Подключить(Узел):
    __slots__ = ("имя",)

    def __init__(self, имя):
        self.имя = имя



СЛОВО_ДРОБИ = ("запятая", "запятой", "запятую")

МНОГОСЛОВНЫЕ_ЗНАКИ = [
    (("не", "равно"), "неравно"),
    (("не", "равна"), "неравно"),
    (("не", "больше"), "небольше"),
    (("не", "меньше"), "неменьше"),
    (("больше", "или", "равно"), "неменьше"),
    (("меньше", "или", "равно"), "небольше"),
    (("больше", "либо", "равно"), "неменьше"),
    (("меньше", "либо", "равно"), "небольше"),
    (("умножить", "на"), "умножить"),
    (("разделить", "на"), "разделить"),
    (("поделить", "на"), "разделить"),
    (("остаток", "от"), "остаток"),
    (("в", "степени"), "степень"),
]

МЕТКИ_СЛОВ = {
    "ключ": ("ключ", "ключу", "ключом", "ключе", "ключи", "ключей"),
    "номер": ("номер", "номеру", "номером", "номере", "номера"),
    "значение": ("значение", "значению", "значением"),
    "имя": ("имя", "имени", "именем"),
    "перечень": ("перечень", "перечня", "перечнем", "список"),
    "словарь": ("словарь", "словаря", "словарем"),
}

СОПОСТАВЛЕНИЯ = {"больше", "меньше", "равно", "неравно", "неменьше",
                 "небольше", "содержит"}


class Разбор:
    def __init__(self, текст, имя_файла="<текст>"):
        self.имя_файла = имя_файла
        self.токены = разобрать_текст(текст, имя_файла)
        self.п = 0
        self.стоп_запятая = 0
        self.правила = {}

    def текущий(self):
        return self.токены[self.п]

    def смотрю(self, сдвиг=0):
        место = self.п + сдвиг
        if место >= len(self.токены):
            return self.токены[-1]
        return self.токены[место]

    def лемма(self, сдвиг=0):
        ток = self.смотрю(сдвиг)
        if ток.вид == "слово":
            return ток.лемма
        if ток.вид == "знак":
            return tok_знак(ток)
        return ""

    def съесть(self):
        ток = self.токены[self.п]
        if ток.вид != "конец":
            self.п += 1
        return ток

    def беда(self, сообщение, подсказка="", ток=None):
        ток = ток or self.текущий()
        raise ОшибкаГрамматики(сообщение, ток.строка, ток.столбец, подсказка)

    def жду_слово(self, леммы, что="слово"):
        if self.лемма() in леммы:
            return self.съесть()
        self.беда(
            f"здесь нужно слово «{sorted(леммы)[0]}», а встретилось "
            f"«{self.текущий().текст or 'конец текста'}»",
            что,
        )

    def жду_знак(self, знак):
        if self.текущий().вид == "знак" and self.текущий().текст == знак:
            return self.съесть()
        self.беда(
            f"здесь нужен знак «{знак}», а встретилось "
            f"«{self.текущий().текст or 'конец текста'}»"
        )

    def конец_оператора(self):
        if self.текущий().вид == "конец":
            return
        if self.текущий().вид == "знак" and self.текущий().текст in ".!?":
            self.съесть()
            return
        self.беда(
            f"после законченного действия нужен знак «.» , «!» или «?», "
            f"а встретилось «{self.текущий().текст or 'конец текста'}»",
            "каждое действие языка Лексика заканчивается точкой: сказать привет.",
        )

    def запятые(self):
        if self.стоп_запятая:
            return
        while self.текущий().вид == "знак" and self.текущий().текст == ",":
            self.съесть()

    def разобрать_программу(self):
        операторы = []
        self.запятые()
        self.собрать_правила()
        while self.текущий().вид != "конец":
            if self.текущий().вид == "знак" and self.текущий().текст in ".!?":
                self.съесть()
                continue
            if self.текущий().вид == "знак" and self.текущий().текст == ",":
                self.съесть()
                continue
            операторы.append(self.оператор())
        return операторы

    def собрать_правила(self):
        i = 0
        while i < len(self.токены):
            ток = self.токены[i]
            if ток.вид == "слово" and ток.лемма == "правило":
                имя = self.токены[i + 1] if i + 1 < len(self.токены) else None
                if имя is not None and имя.вид == "слово":
                    self.правила[имя.текст.lower()] = True
            i += 1

    def тело(self, стоп_леммы):
        операторы = []
        глубина = 0
        while True:
            ток = self.текущий()
            if ток.вид == "конец":
                if глубина == 0:
                    self.беда(
                        "не закрыт составной замысел",
                        "каждый замысел закрывается словом «конец» и точкой",
                    )
                break
            if глубина == 0 and ток.вид == "слово" and ток.лемма in стоп_леммы:
                break
            if глубина == 0 and ток.вид == "знак" and ток.текст in ".!?":
                self.съесть()
                continue
            if глубина == 0 and ток.вид == "знак" and ток.текст == ",":
                self.съесть()
                continue
            операторы.append(self.оператор())
        return операторы

    def оператор(self):
        ток = self.текущий()
        if ток.вид == "знак" and ток.текст in ".!?":
            self.съесть()
            return self.оператор()
        if ток.вид == "знак" and ток.текст == ",":
            self.съесть()
            return self.оператор()
        if ток.вид != "слово":
            self.беда(
                "действие должно начинаться со слова",
                "например: сказать привет.",
            )
        лемма = ток.лемма

        if лемма == "заметка":
            self.пропустить_до_конца_строки()
            return self.оператор() if self.текущий().вид != "конец" else Прервать()

        if лемма == "если":
            return self.разобрать_если()
        if лемма == "пока":
            return self.разобрать_пока()
        if лемма == "для":
            return self.разобрать_для()
        if лемма == "повторить":
            return self.разобрать_повторить()
        if лемма == "правило":
            return self.разобрать_правило()
        if лемма == "вернуть":
            self.съесть()
            if self.текущий().вид == "знак" and self.текущий().текст in ".!?":
                значение = None
            else:
                значение = self.выражение({})
            self.конец_оператора()
            return Вернуть(значение)
        if лемма == "прервать":
            self.съесть()
            self.конец_оператора()
            return Прервать()
        if лемма == "продолжить":
            self.съесть()
            self.конец_оператора()
            return Продолжить()
        if лемма == "подключить":
            self.съесть()
            слово = self.съесть()
            self.конец_оператора()
            return Подключить(слово.текст.lower())
        if лемма == "сказать":
            self.съесть()
            значение = self.выражение({})
            self.конец_оператора()
            return Сказать(значение)
        if лемма == "спросить":
            self.съесть()
            имя = self.съесть()
            if имя.вид != "слово":
                self.беда("после «спросить» нужно имя переменной", "спросить имя.", имя)
            self.конец_оператора()
            return Спросить(имя.текст.lower())
        if лемма == "пусть":
            self.съесть()
            имя = self.съесть()
            if имя.вид != "слово":
                self.беда("после «пусть» нужно имя переменной", "пусть счёт равно пяти.", имя)
            self.жду_слово({"равно"}, "после имени идёт слово «равно»")
            значение = self.выражение({})
            self.конец_оператора()
            return Объявить(имя.текст.lower(), значение)
        if лемма in ("увеличить", "уменьшить", "умножить", "разделить"):
            знак = {"увеличить": "+", "уменьшить": "-", "умножить": "*", "разделить": "/"}[лемма]
            self.съесть()
            имя = self.съесть()
            if имя.вид != "слово":
                self.беда("после этого слова нужно имя переменной", "увеличить счёт на два.", имя)
            self.жду_слово({"на"}, "нужен предлог «на»")
            значение = self.выражение({})
            self.конец_оператора()
            return Изменить(имя.текст.lower(), знак, значение)
        if лемма == "прибавить":
            self.съесть()
            значение = self.выражение({"к"})
            self.жду_слово({"к"}, "прибавляют «к чему-то»: прибавить два к счёту.")
            имя = self.съесть()
            само = self.привести_к_имени(имя)
            self.конец_оператора()
            return Изменить(само, "+", значение)
        if лемма == "отнять":
            self.съесть()
            значение = self.выражение({"от"})
            self.жду_слово({"от"}, "отнимают «от чего-то»: отнять два от счёта.")
            имя = self.съесть()
            само = self.привести_к_имени(имя)
            self.конец_оператора()
            return Изменить(само, "-", значение)
        if лемма in словарь.КОМАНДЫ and not словарь.КОМАНДЫ[лемма]["значение"]:
            команда = self.разобрать_команду()
            self.конец_оператора()
            return команда
        if лемма == "позвать":
            ток = само = self.съесть()
            имя = self.съесть()
            if имя.вид != "слово":
                self.беда("после «позвать» нужно имя правила", "позвать приветствие с Пётр.", имя)
            аргументы = []
            if self.лемма() == "с":
                self.съесть()
                сам_стоп = self.стоп_запятая
                self.стоп_запятая += 1
                try:
                    while True:
                        аргументы.append(self.выражение({}))
                        if self.текущий().вид == "знак" and self.текущий().текст == ",":
                            self.съесть()
                            continue
                        break
                finally:
                    self.стоп_запятая = сам_стоп
            self.конец_оператора()
            return Вызов(имя.текст.lower(), аргументы, имя.строка, имя.столбец)
        if лемма == "положить":
            self.съесть()
            значение = self.выражение({"в"})
            self.жду_слово({"в"}, "кладут «во что-то»: положить пять в сумму.")
            имя = self.съесть()
            само = self.привести_к_имени(имя)
            self.конец_оператора()
            return Присвоить(само, значение)

        if (self.смотрю(0).вид == "слово" and self.смотрю(1).вид == "слово"
                and self.смотрю(1).лемма == "равно"):
            имя = self.съесть()
            self.съесть()
            значение = self.выражение({})
            self.конец_оператора()
            return Присвоить(имя.текст.lower(), значение)

        значение = self.выражение({})
        self.конец_оператора()
        return значение

    def привести_к_имени(self, ток):
        if ток.вид != "слово":
            self.беда("здесь нужно имя переменной", "", ток)
        return ток.текст.lower()

    def пропустить_до_конца_строки(self):
        строка = self.текущий().строка
        while self.текущий().вид != "конец" and self.текущий().строка == строка:
            self.съесть()

    def разобрать_если(self):
        self.жду_слово({"если"})
        ветви = []
        условие = self.выражение({"то"})
        self.жду_слово({"то"}, "после условия идёт слово «то»")
        тело = self.тело({"иначе", "конец"})
        ветви.append((условие, тело))
        иначе = None
        while self.смотрю().вид == "слово" and self.смотрю().лемма == "иначе":
            self.съесть()
            if self.смотрю().вид == "слово" and self.смотрю().лемма == "если":
                self.съесть()
                условие = self.выражение({"то"})
                self.жду_слово({"то"}, "после условия идёт слово «то»")
                тело = self.тело({"иначе", "конец"})
                ветви.append((условие, тело))
                continue
            иначе = self.тело({"конец"})
            break
        self.жду_слово({"конец"}, "замысел «если» закрывается словом «конец»")
        if self.смотрю().вид == "слово":
            self.съесть()
        self.конец_оператора()
        return Если(ветви, иначе)

    def разобрать_пока(self):
        self.жду_слово({"пока"})
        условие = self.выражение({"повторять"})
        self.жду_слово({"повторять"}, "после условия идёт слово «повторять»")
        тело = self.тело({"конец"})
        self.жду_слово({"конец"}, "замысел «пока» закрывается словом «конец»")
        if self.смотрю().вид == "слово":
            self.съесть()
        self.конец_оператора()
        return Пока(условие, тело)

    def разобрать_для(self):
        self.жду_слово({"для"})
        self.жду_слово({"каждый"}, "пишут «для каждого предмета из перечня»")
        имя = self.съесть()
        if имя.вид != "слово":
            self.беда("после «для каждого» нужно имя", "для каждого предмета из перечня.", имя)
        self.жду_слово({"из"}, "нужен предлог «из»")
        перечень = self.выражение({"повторять", "то"})
        if self.текущий().вид == "слово" and self.текущий().лемма in ("повторять", "то"):
            self.съесть()
        тело = self.тело({"конец"})
        self.жду_слово({"конец"}, "замысел «для каждого» закрывается словом «конец»")
        if self.смотрю().вид == "слово":
            self.съесть()
        self.конец_оператора()
        return ДляКаждого(имя.текст.lower(), перечень, тело)

    def разобрать_повторить(self):
        self.жду_слово({"повторить"})
        сколько = self.выражение({"раз"})
        self.жду_слово({"раз"}, "после числа идёт слово «раз»: повторить три раза")
        тело = self.тело({"конец"})
        self.жду_слово({"конец"}, "замысел «повторить» закрывается словом «конец»")
        if self.смотрю().вид == "слово":
            self.съесть()
        self.конец_оператора()
        return Повторить(сколько, тело)

    def разобрать_правило(self):
        ток = self.жду_слово({"правило"})
        имя = self.съесть()
        if имя.вид != "слово":
            self.беда("после «правило» нужно имя правила", "правило приветствие принимает имя.", имя)
        параметры = []
        if self.смотрю().вид == "слово" and self.смотрю().лемма == "принимает":
            self.съесть()
            while True:
                параметр = self.съесть()
                if параметр.вид != "слово":
                    self.беда("здесь нужно имя значения, которое принимает правило", "", параметр)
                параметры.append(имя_параметра(параметр.текст.lower()))
                if self.смотрю().вид == "знак" and self.смотрю().текст == ",":
                    self.съесть()
                    continue
                if self.смотрю().вид == "слово" and self.смотрю().лемма == "и":
                    self.съесть()
                    continue
                break
        if self.текущий().вид == "слово" and self.текущий().лемма in ("повторять", "то", "делать"):
            self.съесть()
        тело = self.тело({"конец"})
        self.жду_слово({"конец"}, "замысел «правило» закрывается словом «конец»")
        if self.смотрю().вид == "слово":
            self.съесть()
        self.конец_оператора()
        return Правило(имя.текст.lower(), параметры, тело, ток.строка, ток.столбец)

    def разобрать_команду(self, имя=None):
        ток = self.текущий()
        имя = имя or ток.лемма
        описание = словарь.КОМАНДЫ[имя]
        self.съесть()
        слоты = []
        for предлог, падеж, метка in описание["шаблон"]:
            if предлог is not None:
                if self.лемма() not in (предлог, предлог + "о"):
                    self.беда(
                        f"после «{имя}» нужен предлог «{предлог}»",
                        f"образец: {описание['пример']}",
                    )
                self.съесть()
            for метка_слово in МЕТКИ_СЛОВ.get(метка, ()):
                if self.текущий().вид == "слово" and self.текущий().текст.lower() == метка_слово:
                    self.съесть()
                    break
            if падеж is None:
                слоты.append((метка, None, self.выражение({}, нижняя=True)))
                continue
            if (self.текущий().вид == "знак" and self.текущий().текст == "("
                    and метка not in ("перечень", "словарь")):
                слоты.append((метка, None, self.выражение({}, нижняя=True)))
                continue
            слово = self.съесть()
            if слово.вид != "слово":
                self.беда(
                    f"здесь нужно имя в {морфология.ПАДЕЖ_ИМЯ[падеж]} падеже",
                    f"образец: {описание['пример']}",
                    слово,
                )
            слоты.append((метка, падеж, Имя(слово.текст, слово.лемма,
                                            слово.строка, слово.столбец)))
        return Команда(имя, слоты, ток.строка, ток.столбец)

    def выражение(self, стоп, нижняя=False):
        стоп = set(стоп)
        return self.уровень_или(стоп, нижняя)

    def _стоп(self, стоп):
        ток = self.текущий()
        if ток.вид == "конец":
            return True
        if ток.вид == "слово" and ток.лемма in стоп:
            return True
        if ток.вид == "знак" and ток.текст == ")":
            return True
        if ток.вид == "знак" and not self.стоп_запятая and ток.текст == ",":
            return False
        return False

    def уровень_или(self, стоп, нижняя=False):
        лево = self.уровень_и(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп) and self.лемма() in ("или",):
            self.съесть()
            self.запятые()
            право = self.уровень_и(стоп, нижняя)
            лево = Действие("или", лево, право)
            self.запятые()
        return лево

    def уровень_и(self, стоп, нижняя=False):
        лево = self.уровень_сравнения(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп) and self.лемма() == "и":
            self.съесть()
            self.запятые()
            право = self.уровень_сравнения(стоп, нижняя)
            лево = Действие("и", лево, право)
            self.запятые()
        return лево

    def уровень_сравнения(self, стоп, нижняя=False):
        лево = self.уровень_суммы(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп):
            знак = self.знак_сравнения()
            if знак is None:
                break
            self.запятые()
            право = self.уровень_суммы(стоп, нижняя)
            лево = Действие(знак, лево, право)
            self.запятые()
        return лево

    def знак_сравнения(self):
        if self.текущий().вид != "слово":
            return None
        for последовательность, знак in МНОГОСЛОВНЫЕ_ЗНАКИ:
            совпало = True
            for сдвиг, кусок in enumerate(последовательность):
                ток = self.смотрю(сдвиг)
                if ток.вид != "слово" or ток.лемма != кусок:
                    совпало = False
                    break
            if совпало:
                for _ in последовательность:
                    self.съесть()
                return знак
        лемма = self.лемма()
        if лемма in ("больше", "меньше", "равно", "содержит"):
            self.съесть()
            return лемма
        return None

    def уровень_суммы(self, стоп, нижняя=False):
        лево = self.уровень_произведения(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп) and self.лемма() in ("плюс", "минус"):
            знак = "плюс" if self.лемма() == "плюс" else "минус"
            self.съесть()
            self.запятые()
            право = self.уровень_произведения(стоп, нижняя)
            лево = Действие(знак, лево, право)
            self.запятые()
        return лево

    def уровень_произведения(self, стоп, нижняя=False):
        лево = self.уровень_степени(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп):
            сдвиг = self.сколько_знак_произведения()
            if not сдвиг:
                break
            знак = сдвиг[0]
            for _ in range(сдвиг[1]):
                self.съесть()
            self.запятые()
            право = self.уровень_степени(стоп, нижняя)
            лево = Действие(знак, лево, право)
            self.запятые()
        return лево

    def сколько_знак_произведения(self):
        if self.текущий().вид != "слово":
            return None
        for последовательность, знак in МНОГОСЛОВНЫЕ_ЗНАКИ:
            if знак not in ("умножить", "разделить", "остаток"):
                continue
            совпало = True
            for сдвиг, кусок in enumerate(последовательность):
                ток = self.смотрю(сдвиг)
                if ток.вид != "слово" or ток.текст.lower() != кусок:
                    совпало = False
                    break
            if совпало:
                return (знак, len(последовательность))
        return None

    def уровень_степени(self, стоп, нижняя=False):
        лево = self.уровень_унарный(стоп, нижняя)
        self.запятые()
        while not self._стоп(стоп):
            совпало = False
            for последовательность, знак in МНОГОСЛОВНЫЕ_ЗНАКИ:
                if знак != "степень":
                    continue
                if all(self.смотрю(с).вид == "слово" and self.смотрю(с).лемма == к
                       for с, к in enumerate(последовательность)):
                    совпало = True
                    for _ in последовательность:
                        self.съесть()
                    break
            if not совпало:
                break
            self.запятые()
            право = self.уровень_унарный(стоп, нижняя)
            лево = Действие("степень", лево, право)
        return лево

    def уровень_унарный(self, стоп, нижняя=False):
        if self.текущий().вид == "слово" and self.текущий().лемма in ("минус",):
            self.съесть()
            return Действие("минус", Число(0), self.уровень_унарный(стоп, нижняя))
        return self.первичное(стоп, нижняя)

    def первичное(self, стоп, нижняя=False):
        ток = self.текущий()

        if ток.вид == "число":
            self.съесть()
            целое = int(ток.текст)
            if self.текущий().вид == "слово" and self.текущий().текст.lower() in СЛОВО_ДРОБИ:
                self.съесть()
                if self.текущий().вид == "число":
                    дробь = self.съесть().текст
                    return Число(float(f"{целое}.{дробь}"))
                self.беда("после слова «запятая» нужны цифры дробной части")
            return Число(целое)

        if ток.вид == "речь":
            self.съесть()
            части = []
            for вид, кусок in ток.части:
                if вид == "т":
                    части.append(("т", кусок))
                else:
                    вставить = Разбор(кусок, self.имя_файла).выражение({})
                    части.append(("к", вставить))
            return Речь(части)

        if ток.вид == "знак" and ток.текст == "(":
            self.съесть()
            значение = self.выражение({})
            self.жду_знак(")")
            return значение

        if ток.вид != "слово":
            self.беда(
                "здесь ожидалось значение, а встретилось "
                f"«{ток.текст or 'конец текста'}»"
            )

        лемма = ток.лемма
        if лемма == "истина":
            self.съесть()
            return Постоянное(True)
        if лемма == "ложь":
            self.съесть()
            return Постоянное(False)
        if лемма == "ничто":
            self.съесть()
            return Постоянное(None)
        if лемма == "не":
            self.съесть()
            return Отрицание(self.первичное(стоп, нижняя))
        if лемма == "плюс":
            self.съесть()
            return self.первичное(стоп, нижняя)

        if self._числительное_впереди():
            слова = []
            while self.текущий().вид == "слово" and (
                self.текущий().текст.lower() in морфология.ЧИСЛИТЕЛЬНЫЕ
                or self.текущий().текст.lower() in морфология.МНОЖИТЕЛИ
            ):
                слова.append(self.съесть().текст)
            значение = морфология.числительное(слова)
            if self.текущий().вид == "слово" and self.текущий().текст.lower() in СЛОВО_ДРОБИ:
                self.съесть()
                дробь = self.первичное(стоп, нижняя)
                if isinstance(дробь, Число):
                    return Число(float(f"{int(значение)}.{int(дробь.значение)}"))
                self.беда("после слова «запятая» нужны цифры дробной части")
            return Число(значение)

        следующий = self.смотрю(1)
        if следующий.вид == "знак" and следующий.текст == "(":
            имя = self.съесть()
            self.съесть()
            аргументы = []
            сам_стоп = self.стоп_запятая
            self.стоп_запятая += 1
            try:
                if not (self.текущий().вид == "знак" and self.текущий().текст == ")"):
                    while True:
                        аргументы.append(self.выражение({}))
                        if self.текущий().вид == "знак" and self.текущий().текст == ",":
                            self.съесть()
                            continue
                        break
            finally:
                self.стоп_запятая = сам_стоп
            self.жду_знак(")")
            return Вызов(имя.текст.lower(), аргументы, имя.строка, имя.столбец)

        if лемма in словарь.КОМАНДЫ and словарь.КОМАНДЫ[лемма]["значение"]:
            return self.разобрать_команду(лемма)

        self.съесть()
        return Имя(ток.текст, ток.лемма, ток.строка, ток.столбец)

    def _числительное_впереди(self):
        if self.текущий().вид != "слово":
            return False
        слово = self.текущий().текст.lower()
        if слово not in морфология.ЧИСЛИТЕЛЬНЫЕ and слово not in морфология.МНОЖИТЕЛИ:
            return False
        следующий = self.смотрю(1)
        if следующий.вид == "знак" and следующий.текст in ".,!?)":
            return True
        if следующий.вид == "слово":
            return True
        return True


def имя_параметра(слово):
    if слово.endswith("у"):
        return слово[:-1] + "а"
    if слово.endswith("ю"):
        return слово[:-1] + "я"
    return слово


def tok_знак(ток):
    return ток.текст


def tok_лемма_без_служебных(ток):
    return ток.текст.lower()


def разобрать(текст, имя_файла="<текст>"):
    return Разбор(текст, имя_файла).разобрать_программу()
