    "умная_модель": "встроенная",
    "взрослая_лексика": False,
    "зумер_лексика": False,
    "путь_к_модели": "",
    "движок_модели": "llama.cpp",
    "проверять_падежи": True,
    "разрешить_толкование": False,
    "разрешить_поиск_в_сети": False,
    "сетевой_провайдер": "нет",
    "порог_уверенности": 0.34,
}

ПАПКА = os.path.join(os.path.expanduser("~"), ".lek")
ФАЙЛ_НАСТРОЕК = os.path.join(ПАПКА, "настройки.настр")
ФАЙЛ_СТАРЫХ = os.path.join(ПАПКА, "настройки.json")


def прочитать_настройки():
    настройки = dict(НАСТРОЙКИ_ПО_УМОЛЧАНИЮ)
    try:
        настройки.update(хранение.прочитать_файл(ФАЙЛ_НАСТРОЕК))
    except (OSError, ValueError):
        pass
    return настройки


def записать_настройки(настройки):
    os.makedirs(ПАПКА, exist_ok=True)
    хранение.записать_файл(ФАЙЛ_НАСТРОЕК, настройки)
    return настройки



ЧАСТОТЫ_ОКОНЧАНИЙ = {
    ("у", "ед"): {"дт": 0.55, "вн": 0.45},
    ("ю", "ед"): {"дт": 0.5, "вн": 0.5},
    ("а", "ед"): {"рд": 0.62, "им": 0.1},
    ("я", "ед"): {"рд": 0.6, "им": 0.1},
    ("и", "ед"): {"пр": 0.35, "рд": 0.3, "дт": 0.2},
    ("е", "ед"): {"пр": 0.7, "дт": 0.2},
    ("ом", "ед"): {"тв": 0.95},
    ("ем", "ед"): {"тв": 0.95},
    ("ой", "ед"): {"тв": 0.8, "рд": 0.1},
    ("ей", "ед"): {"тв": 0.5, "рд": 0.3},
    ("ы", "мн"): {"им": 0.6, "вн": 0.2},
    ("и", "мн"): {"им": 0.55, "вн": 0.25},
    ("ов", "мн"): {"рд": 0.9},
    ("ев", "мн"): {"рд": 0.9},
    ("ам", "мн"): {"дт": 0.85},
    ("ами", "мн"): {"тв": 0.9},
    ("ах", "мн"): {"пр": 0.9},
}

ПОДСКАЗКИ_РОДА = {
    "ость": "ж", "есть": "ж", "адь": "ж", "ель": "ж", "ыль": "ж",
    "а": "ж", "я": "ж", "о": "с", "е": "с", "мя": "с",
}


class ВстроеннаяМодель:

    имя = "встроенная"
    требует_сети = False

    def __init__(self):
        self.разум = разум.загрузить()
        if self.разум.вес():
            self.размер = "≈ 580 килобайт, своя нейронная сеть"
        else:
            self.размер = "≈ 180 килобайт, таблицы окончаний"

    @property
    def нейронная(self):
        return bool(self.разум.вес())

    def оценки(self, слово, контекст=""):
        if not self.нейронная:
            return []
        return self.разум.разобрать(слово, контекст)

    def уверенность(self, слово, падеж, число):
        оценки = self.оценки(слово)
        if оценки:
            for (_, п, ч), вес in оценки:
                if п == падеж and ч == число:
                    return вес
            return 0.02
        слово = слово.lower()
        for (окончание, ч), веса in ЧАСТОТЫ_ОКОНЧАНИЙ.items():
            if число == ч and слово.endswith(окончание):
                return веса.get(падеж, 0.05)
        return 0.1

    def выбрать(self, слово, кандидаты, контекст=""):
        if not кандидаты:
            return None, 0.0
        лучший, вес = None, -1.0
        for кандидат in кандидаты:
            падеж = кандидат[1] if len(кандидат) > 1 else None
            число = кандидат[2] if len(кандидат) > 2 else "ед"
            оценка = self.уверенность(слово, падеж, число)
            if контекст:
                for предлог, нужный in словарь_предлогов().items():
                    if предлог in контекст.lower().split() and нужный == падеж:
                        оценка += 0.25
            if оценка > вес:
                лучший, вес = кандидат, оценка
        return лучший, min(вес, 0.99)

    def род(self, слово):
        if self.нейронная:
            род = self.разум.род(слово)
            if род:
                return род
        слово = слово.lower()
        for окончание, род in ПОДСКАЗКИ_РОДА.items():
            if слово.endswith(окончание):
                return род
        return "м"

    def разобрать(self, слово, контекст=""):
        кандидаты = морфология.разобрать(слово)
        return self.выбрать(слово, кандидаты, контекст)

    def толковать(self, запрос):
        return None


def словарь_предлогов():
    from .словарь import ПРЕДЛОГИ
    return ПРЕДЛОГИ



class ВнешняяМодель:

    имя = "внешняя"
    требует_сети = False

    def __init__(self, путь, движок="llama.cpp", порог=0.34, встроенная=None):
        self.путь = путь
        self.движок = движок
        self.порог = порог
        self.встроенная = встроенная or ВстроеннаяМодель()
        self.доступна = self._проверить()

    def _проверить(self):
        if not безопасность.разрешить_внешнюю_модель(self.путь):
            return False
        if not self.путь:
            return False
        if self.движок == "onnx":
            return (
                os.path.isdir(self.путь)
                and _есть("onnxruntime")
                and _есть("numpy")
                and _есть("tokenizers")
                and безопасность.разрешить_модуль("onnxruntime")
                and безопасность.разрешить_модуль("numpy")
                and безопасность.разрешить_модуль("tokenizers")
            )
        return os.path.isfile(self.путь) and (упаковка.где("llama-cli") or _есть("llama_cpp"))

    def _зов(self, подсказка, предел=64):
        if self.движок == "onnx":
            return self._оннкс_зов(подсказка)
        if _есть("llama_cpp") and безопасность.разрешить_модуль("llama_cpp"):
            from llama_cpp import Llama
            машина = Llama(model_path=self.путь, n_ctx=512, verbose=False)
            ответ = машина(подсказка, max_tokens=предел, temperature=0.0)
            return ответ["choices"][0]["text"].strip()
        if упаковка.где("llama-cli"):
            if not безопасность.разрешить_процесс("llama-cli"):
                raise PermissionError("llama-cli запрещён политикой безопасности")
            итог = subprocess.run(
                ["llama-cli", "-m", self.путь, "-p", подсказка, "-n", str(предел),
                 "--temp", "0", "--no-display-prompt"],
                capture_output=True, text=True, timeout=120,
            )
            return итог.stdout.strip()
        raise RuntimeError("llama.cpp не найден")

    def _оннкс_зов(self, подсказка):
        try:
            import numpy as np
            import onnxruntime as ort
            from tokenizers import Tokenizer
        except ImportError:
            return None
        токенизатор = Tokenizer.from_file(os.path.join(self.путь, "tokenizer.json"))
        сессия = ort.InferenceSession(os.path.join(self.путь, "model.onnx"))
        кодировка = токенизатор.encode(подсказка)
        входы = {
            "input_ids": np.array([кодировка.ids], dtype=np.int64),
            "attention_mask": np.array([кодировка.attention_mask], dtype=np.int64),
        }
        итог = сессия.run(None, входы)[0]
        return итог.mean(axis=1)[0]

    def выбрать(self, слово, кандидаты, контекст=""):
        if not self.доступна:
            return self.встроенная.выбрать(слово, кандидаты, контекст)
        варианты = ", ".join("{} {}".format(*к[:2]) for к in кандидаты)
        подсказка = (
            "Разбери русское слово по падежам. Ответь одним словом.\n"
            f"Фраза: {контекст}\nСлово: {слово}\nВарианты: {варианты}\nОтвет:"
        )
        try:
            ответ = self._зов(подсказка, 16) or ""
        except Exception:
            return self.встроенная.выбрать(слово, кандидаты, контекст)
        for кандидат in кандидаты:
            if кандидат[1] and кандидат[1][:2] in ответ.lower():
                return кандидат, 0.8
        return self.встроенная.выбрать(слово, кандидаты, контекст)

    def разобрать(self, слово, контекст=""):
        return self.выбрать(слово, морфология.разобрать(слово), контекст)

    def толковать(self, запрос):
        if not self.доступна:
            return None
        подсказка = (
            "Ты помогаешь языку программирования Лексика. Объясни по-русски коротко.\n"
            f"Вопрос: {запрос}\nОтвет:"
        )
        try:
            return self._зов(подсказка, 200)
        except Exception as ошибка:
            return f"внешняя модель не ответила: {ошибка}"


class ВыключеннаяМодель:
    имя = "выключена"
    размер = "0 байт"
    требует_сети = False

    def выбрать(self, слово, кандидаты, контекст=""):
        return (кандидаты[0] if кандидаты else (слово, "им", "ед")), 0.5

    def разобрать(self, слово, контекст=""):
        кандидаты = морфология.разобрать(слово)
        return кандидаты[0] if кандидаты else (слово, "им", "ед"), 0.5

    def род(self, слово):
        return "м"

    def толковать(self, запрос):
        return None


def _есть(модуль):
    try:
        __import__(модуль)
    except Exception:
        return False
    return True


def собрать_модель(настройки=None):
    настройки = настройки or прочитать_настройки()
    режим = настройки.get("умная_модель", "встроенная")
    if режим == "выключена":
        return ВыключеннаяМодель()
    if режим == "табличная":
        встроенная = ВстроеннаяМодель()
        встроенная.разум = разум.Разум([], [], {}, [], [], [])
        встроенная.размер = "≈ 180 килобайт, таблицы окончаний"
        return встроенная
    if режим == "внешняя":
        встроенная = ВстроеннаяМодель()
        внешняя = ВнешняяМодель(
            настройки.get("путь_к_модели", ""),
            настройки.get("движок_модели", "llama.cpp"),
            float(настройки.get("порог_уверенности", 0.34)),
            встроенная,
        )
        внешняя.разрешить_поиск_в_сети = bool(
            настройки.get("разрешить_поиск_в_сети", False)
        )
        return внешняя if внешняя.доступна else встроенная
    return ВстроеннаяМодель()


