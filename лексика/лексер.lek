
from . import словарь
from .ошибки import ОшибкаЛексики

РАЗРЕШЁННЫЕ_ЗНАКИ = ".,!?()"
ЗАПРЕЩЁННЫЕ_ЗНАКИ = ";:[]{}<>\"'`~@#$%^&*_+=|\\/№—–…«»„“”’‘"

ОТКРЫТИЕ_РЕЧИ = "речь"
ЗАКРЫТИЕ_РЕЧИ = ("конец", "речи")


class Токен:

    __slots__ = ("вид", "текст", "лемма", "строка", "столбец", "части")

    def __init__(self, вид, текст, строка=0, столбец=0, лемма=None, части=None):
        self.вид = вид
        self.текст = текст
        self.лемма = лемма if лемма is not None else текст.lower()
        self.строка = строка
        self.столбец = столбец
        self.части = части

    def __repr__(self):
        return f"<{self.вид}:{self.текст}>"


ОБРАТНЫЙ = {}
for _лемма, _формы in словарь.СЛУЖЕБНЫЕ.items():
    for _ф in _формы:
        ОБРАТНЫЙ.setdefault(_ф.lower(), _лемма)
for _лемма in словарь.КОМАНДЫ:
    ОБРАТНЫЙ.setdefault(_лемма.lower(), _лемма)


def лемма_слова(слово):
    маленькое = слово.lower()
    if маленькое in ОБРАТНЫЙ:
        return ОБРАТНЫЙ[маленькое]
    return маленькое


def служебное(слово):
    return слово.lower() in ОБРАТНЫЙ


def разобрать_текст(текст, имя_файла="<текст>"):
    токены = []
    i, строка, столбец = 0, 1, 1
    длина = len(текст)

    def толчок(вид, слово, с_строки, с_столбца, лемма=None, части=None):
        токены.append(Токен(вид, слово, с_строки, с_столбца, лемма, части))

    while i < длина:
        знак = текст[i]

        if знак == "\n":
            i += 1
            строка += 1
            столбец = 1
            continue
        if знак in " \t\r":
            i += 1
            столбец += 1
            continue

        if знак.isalpha() and знак.lower() in "реъь" and текст[i:i + 4].lower() == "речь":
            конец_слова = i + 4
            if конец_слова >= длина or not (текст[конец_слова].isalnum() or текст[конец_слова] in "-"):
                части, i, строка, столбец = _прочитать_речь(текст, i + 4, строка, столбец, имя_файла)
                толчок("речь", "".join(ч[1] for ч in части if ч[0] == "т"), строка, столбец, "речь", части)
                continue

        if знак.isdigit():
            начало, с_столбца = i, столбец
            while i < длина and (текст[i].isdigit()):
                i += 1
            толчок("число", текст[начало:i], строка, с_столбца, None)
            столбец += i - начало
            continue

        if знак.isalpha():
            начало, с_столбца = i, столбец
            while i < длина and (текст[i].isalpha() or (текст[i] == "-" and i + 1 < длина and текст[i + 1].isalpha())):
                i += 1
            слово = текст[начало:i]
            if _латиница(слово):
                raise ОшибкаЛексики(
                    f"латинское слово «{слово}» запрещено: язык Лексика пишется только по-русски",
                    строка, с_столбца,
                    "замените латиницу русским словом",
                )
            толчок("слово", слово, строка, с_столбца, лемма_слова(слово))
            столбец += len(слово)
            continue

        if знак in РАЗРЕШЁННЫЕ_ЗНАКИ:
            толчок("знак", знак, строка, столбец, знак)
            i += 1
            столбец += 1
            continue

        if знак in ЗАПРЕЩЁННЫЕ_ЗНАКИ:
            raise ОшибкаЛексики(
                f"знак «{знак}» запрещён",
                строка, столбец,
                "в Лексика нет кавычек, скобок иных форм и префиксов: "
                "пользуйтесь словами и только знаками . , ! ? ( )",
            )

        raise ОшибкаЛексики(
            f"непонятный знак «{знак}»",
            строка, столбец,
            "разрешены только русские слова, цифры и знаки . , ! ? ( )",
        )

    токены.append(Токен("конец", "", строка, столбец, "конец"))
    return токены


def _обрезать_крайние_пробелы(части):
    if not части:
        return части
    первый_вид, первый = части[0]
    if первый_вид == "т" and первый.startswith(" "):
        части[0] = ("т", первый[1:])
    последний_вид, последний = части[-1]
    if последний_вид == "т" and последний.endswith(" "):
        части[-1] = ("т", последний[:-1])
    return части


def _латиница(слово):
    return any("a" <= с.lower() <= "z" for с in слово)


def _прочитать_речь(текст, i, строка, столбец, имя_файла):
    части = []
    буфер = []
    глубина = 0
    вложенный = []
    длина = len(текст)

    while i < длина:
        if глубина == 0:
            кусок = текст[i:i + 11].lower()
            if кусок.startswith("конец"):
                после = i + 5
                пока = после
                while пока < длина and текст[пока] in " \t":
                    пока += 1
                if текст[пока:пока + 4].lower() == "речи" and (
                    пока + 4 >= длина or not (текст[пока + 4].isalnum())
                ):
                    if буфер:
                        части.append(("т", "".join(буфер)))
                    части = _обрезать_крайние_пробелы(части)
                    return части, пока + 4, строка, столбец
            if текст[i] == ")":
                if i + 1 < длина and текст[i + 1] == ")":
                    i += 1
                    столбец += 1
                буфер.append(")")
                i += 1
                столбец += 1
                continue
            if текст[i] == "(":
                if i + 1 < длина and текст[i + 1] == "(":
                    буфер.append("(")
                    i += 2
                    столбец += 2
                    continue
                if буфер:
                    части.append(("т", "".join(буфер)))
                    буфер = []
                глубина = 1
                вложенный = []
                i += 1
                столбец += 1
                continue
            if текст[i] == "\n":
                буфер.append("\n")
                строка += 1
                столбец = 1
                i += 1
                continue
            буфер.append(текст[i])
            i += 1
            столбец += 1
            continue

        if текст[i] == "(":
            глубина += 1
            вложенный.append("(")
        elif текст[i] == ")":
            глубина -= 1
            if глубина == 0:
                части.append(("к", "".join(вложенный)))
                вложенный = []
                i += 1
                столбец += 1
                continue
            вложенный.append(")")
        else:
            if текст[i] == "\n":
                строка += 1
                столбец = 1
            вложенный.append(текст[i])
        i += 1
        столбец += 1

    raise ОшибкаЛексики("речь не закрыта", строка, столбец,
                        "закройте речь словами «конец речи»")
