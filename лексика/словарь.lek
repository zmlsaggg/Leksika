# Бинарная лексическая база LEKSLXD1.
# Загружается лениво: отсутствие индекса не запрещает новые имена и слова.
import os as _os
import struct as _struct
import zlib as _zlib

_ИНДЕКС_СЛОВОФОРМ = None
_ИНДЕКС_ПРОВЕРЕН = False
_ИНДЕКС_ОШИБКА = None
_ИНДЕКС_ПУТЬ_ПЕРЕОПРЕДЕЛЕНИЕ = None
_ИНДЕКС_МАКС_ФОРМ = 5_000_000
_ИНДЕКС_МАКС_ДАННЫХ = 128 * 1024 * 1024


def _загрузить_индекс_словоформ():
    global _ИНДЕКС_СЛОВОФОРМ, _ИНДЕКС_ПРОВЕРЕН, _ИНДЕКС_ОШИБКА
    if _ИНДЕКС_ПРОВЕРЕН:
        return _ИНДЕКС_СЛОВОФОРМ
    _ИНДЕКС_ПРОВЕРЕН = True
    корень = _os.path.dirname(_os.path.dirname(_os.path.abspath(__file__)))
    пути = (
        (_ИНДЕКС_ПУТЬ_ПЕРЕОПРЕДЕЛЕНИЕ,)
        if _ИНДЕКС_ПУТЬ_ПЕРЕОПРЕДЕЛЕНИЕ
        else (
            _os.path.join(корень, "ядро", "русские_формы.lxd"),
            _os.path.join(корень, "данные", "словарь", "русские_формы.lxd"),
            _os.path.join(корень, "русские_формы.lxd"),
        )
    )
    for путь in пути:
        try:
            with open(путь, "rb") as файл:
                данные = файл.read(_ИНДЕКС_МАКС_ДАННЫХ + 36 + 4 * (_ИНДЕКС_МАКС_ФОРМ + 1) + 1)
            if len(данные) < 36 or данные[:8] != b"LEKSLXD1":
                continue
            версия, размер_заголовка = _struct.unpack_from("<II", данные, 8)
            количество, размер_строк = _struct.unpack_from("<QQ", данные, 16)
            ожидаемая_crc, = _struct.unpack_from("<I", данные, 32)
            if версия != 1 or размер_заголовка != 36:
                raise ValueError("неподдерживаемая версия бинарного словаря")
            if not 0 < количество <= _ИНДЕКС_МАКС_ФОРМ:
                raise ValueError("недопустимое количество словоформ")
            if размер_строк > _ИНДЕКС_МАКС_ДАННЫХ:
                raise ValueError("бинарный словарь превышает допустимый размер")
            смещения_начало = 36
            строки_начало = смещения_начало + (количество + 1) * 4
            if строки_начало + размер_строк != len(данные):
                raise ValueError("размер бинарного словаря не совпадает с заголовком")
            if (_zlib.crc32(данные[36:]) & 0xFFFFFFFF) != ожидаемая_crc:
                raise ValueError("контрольная сумма бинарного словаря не совпадает")
            предыдущее = 0
            предыдущее_слово = None
            for номер in range(количество + 1):
                смещение, = _struct.unpack_from("<I", данные, смещения_начало + номер * 4)
                if номер == 0 and смещение != 0:
                    raise ValueError("таблица смещений не начинается с нуля")
                if смещение < предыдущее or смещение > размер_строк:
                    raise ValueError("таблица смещений повреждена")
                if номер:
                    if смещение <= предыдущее + 1:
                        raise ValueError("пустая или повреждённая запись словаря")
                    if данные[строки_начало + смещение - 1] != 0:
                        raise ValueError("запись словаря не завершена нулевым байтом")
                    слово = данные[строки_начало + предыдущее:строки_начало + смещение - 1]
                    if b"\0" in слово:
                        raise ValueError("внутри словоформы найден нулевой байт")
                    слово.decode("utf-8")
                    if предыдущее_слово is not None and предыдущее_слово >= слово:
                        raise ValueError("словарь не отсортирован или содержит повторы")
                    предыдущее_слово = слово
                предыдущее = смещение
            if предыдущее != размер_строк:
                raise ValueError("конечное смещение словаря не совпадает с размером")
            _ИНДЕКС_СЛОВОФОРМ = (данные, количество, смещения_начало, строки_начало)
            _ИНДЕКС_ОШИБКА = None
            return _ИНДЕКС_СЛОВОФОРМ
        except FileNotFoundError:
            continue
        except (OSError, ValueError, UnicodeDecodeError, _struct.error) as ошибка:
            _ИНДЕКС_ОШИБКА = str(ошибка)
            return None
    _ИНДЕКС_ОШИБКА = "бинарный словарь не собран"
    return None


def _нормализовать_словоформу(слово):
    return str(слово).strip().lower().encode("utf-8")


def _границы_словоформы(индекс, номер):
    данные, _, таблица, строки = индекс
    начало, = _struct.unpack_from("<I", данные, таблица + номер * 4)
    конец, = _struct.unpack_from("<I", данные, таблица + (номер + 1) * 4)
    return данные[строки + начало:строки + конец - 1]


def есть_словоформа(слово):
    индекс = _загрузить_индекс_словоформ()
    if индекс is None:
        return False
    цель = _нормализовать_словоформу(слово)
    _, количество, _, _ = индекс
    низ, верх = 0, количество
    while низ < верх:
        середина = низ + (верх - низ) // 2
        if _границы_словоформы(индекс, середина) < цель:
            низ = середина + 1
        else:
            верх = середина
    return низ < количество and _границы_словоформы(индекс, низ) == цель


def подсказки_словоформ(начало, предел=8):
    индекс = _загрузить_индекс_словоформ()
    if индекс is None or предел <= 0:
        return []
    префикс = _нормализовать_словоформу(начало)
    if not префикс:
        return []
    _, количество, _, _ = индекс
    низ, верх = 0, количество
    while низ < верх:
        середина = низ + (верх - низ) // 2
        if _границы_словоформы(индекс, середина) < префикс:
            низ = середина + 1
        else:
            верх = середина
    найдено = []
    while низ < количество and len(найдено) < min(int(предел), 32):
        слово = _границы_словоформы(индекс, низ)
        if not слово.startswith(префикс):
            break
        найдено.append(слово.decode("utf-8"))
        низ += 1
    return найдено


def похожие_словоформы(слово, предел=5):
    исходное = str(слово).strip().lower()
    if not исходное:
        return []
    найдено = []
    виденные = {исходное}
    # Удаление одной буквы помогает исправить частые опечатки без
    # тяжёлого нечёткого поиска по полуторамиллионной базе.
    for номер in range(len(исходное)):
        кандидат = исходное[:номер] + исходное[номер + 1:]
        if кандидат and кандидат not in виденные and есть_словоформа(кандидат):
            найдено.append(кандидат)
            виденные.add(кандидат)
            if len(найдено) >= предел:
                return найдено
    префикс = исходное[:min(3, len(исходное))]
    for кандидат in подсказки_словоформ(префикс, предел * 3):
        if кандидат not in виденные:
            найдено.append(кандидат)
            виденные.add(кандидат)
            if len(найдено) >= предел:
                break
    return найдено


def статистика_индекса_словоформ():
    индекс = _загрузить_индекс_словоформ()
    if индекс is None:
        return {"готов": False, "ошибка": _ИНДЕКС_ОШИБКА}
    данные, количество, _, _ = индекс
    return {"готов": True, "форм": количество, "байтов": len(данные)}
