

class ОшибкаЛексики(Exception):

    вид = "ошибка"

    def __init__(self, сообщение, строка=0, столбец=0, подсказка=""):
        self.сообщение = сообщение
        self.строка = строка
        self.столбец = столбец
        self.подсказка = подсказка
        super().__init__(сообщение)

    def __str__(self):
        место = ""
        if self.строка:
            место = f"строка {self.строка}, знак {self.столбец}: "
        текст = f"{self.вид}: {место}{self.сообщение}"
        if self.подсказка:
            текст += f"\n  подсказка: {self.подсказка}"
        return текст


class ОшибкаЛексики(ОшибкаЛексики):
    вид = "ошибка письма"


class ОшибкаГрамматики(ОшибкаЛексики):
    вид = "ошибка грамматики"


class ОшибкаСмысла(ОшибкаЛексики):
    вид = "ошибка смысла"


class ОшибкаПадежа(ОшибкаГрамматики):
    вид = "ошибка падежа"
