from . import грамматика as гр

КОМАНДЫ = (
    "объявить", "присвоить", "изменить", "сказать", "спросить", "команда",
    "шаг", "позвать", "подключить", "перейти", "если_нет", "вернуть",
    "прервать", "продолжить", "правило", "повторить_начало", "повторить_шаг",
    "перебор_начало", "перебор_шаг", "конец",
)


class Программа:
    def __init__(self, команды, правила):
        self.команды = команды
        self.правила = правила

    def размер(self):
        return len(self.команды)

    def вид(self, место):
        if 0 <= место < len(self.команды):
            return self.команды[место][0]
        return "конец"

    def текст(self):
        строки = []
        for место, команда in enumerate(self.команды):
            строки.append(f"{место:4d}  " + "  ".join(str(часть) for часть in команда))
        for имя, (адрес, параметры, конец) in self.правила.items():
            строки.append(f"правило {имя} с {', '.join(параметры)}: {адрес}..{конец}")
        return "\n".join(строки)


def собрать(узлы):
    команды = []
    правила = {}
    циклы = []

    def добавить(*команда):
        команды.append(list(команда))
        return len(команды) - 1

    def тело(список):
        for узел in список:
            один(узел)

    def один(узел):
        вид = type(узел).__name__
        if вид == "Правило":
            добавить("правило", узел.имя)
        elif вид == "Объявить":
            добавить("объявить", узел.имя, узел.значение)
        elif вид == "Присвоить":
            добавить("присвоить", узел.имя, узел.значение)
        elif вид == "Изменить":
            добавить("изменить", узел.имя, узел.знак, узел.значение)
        elif вид == "Сказать":
            добавить("сказать", узел.значение)
        elif вид == "Спросить":
            добавить("спросить", узел.имя, узел.подсказка)
        elif вид == "Подключить":
            добавить("подключить", узел.имя)
        elif вид == "Вернуть":
            добавить("вернуть", узел.значение)
        elif вид == "Прервать":
            место = добавить("прервать", 0)
            if циклы:
                циклы[-1]["выходы"].append(место)
        elif вид == "Продолжить":
            место = добавить("продолжить", 0)
            if циклы:
                циклы[-1]["продолжения"].append(место)
        elif вид == "Если":
            если(узел)
        elif вид == "Пока":
            пока(узел)
        elif вид == "Повторить":
            повторить(узел)
        elif вид == "ДляКаждого":
            перебор(узел)
        elif вид == "Вызов":
            добавить("позвать", узел)
        elif вид == "Команда":
            добавить("команда", узел)
        else:
            добавить("шаг", узел)

    def если(узел):
        концы = []
        for условие, ветка in узел.ветви:
            прыжок = добавить("если_нет", условие, 0)
            тело(ветка)
            выход = добавить("перейти", 0)
            концы.append(выход)
            команды[прыжок][2] = len(команды)
        if узел.иначе:
            тело(узел.иначе)
        for выход in концы:
            команды[выход][1] = len(команды)

    def пока(узел):
        начало = len(команды)
        прыжок = добавить("если_нет", узел.условие, 0)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        добавить("перейти", начало)
        команды[прыжок][2] = len(команды)
        for место in цикл["выходы"]:
            команды[место][1] = len(команды)
        for место in цикл["продолжения"]:
            команды[место][1] = начало

    def повторить(узел):
        место_начала = добавить("повторить_начало", узел.сколько, 0)
        начало = len(команды)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        шаг = добавить("повторить_шаг", начало)
        for место in цикл["продолжения"]:
            команды[место][1] = шаг
        for место in цикл["выходы"]:
            команды[место][1] = len(команды)
        команды[место_начала][2] = len(команды)

    def перебор(узел):
        начало = добавить("перебор_начало", узел.имя, узел.перечень, 0)
        тело_начало = len(команды)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        шаг = добавить("перебор_шаг", тело_начало)
        for место in цикл["продолжения"]:
            команды[место][1] = шаг
        for место in цикл["выходы"]:
            команды[место][1] = len(команды)
        команды[начало][3] = len(команды)

    тело(узлы)
    добавить("конец")

    for узел in узлы:
        if isinstance(узел, гр.Правило):
            начало = len(команды)
            циклы.append({"выходы": [], "продолжения": []})
            тело(узел.тело)
            цикл = циклы.pop()
            добавить("вернуть", None)
            конец = len(команды)
            for место in цикл["выходы"]:
                команды[место][1] = конец
            for место in цикл["продолжения"]:
                команды[место][1] = начало
            правила[узел.имя] = (начало, list(узел.параметры), конец)

    return Программа(команды, правила)
