from . import грамматика as гр

КОМАНДЫ = (
    "объявить", "присвоить", "изменить", "сказать", "спросить", "команда",
    "шаг", "позвать", "подключить", "перейти", "если_нет", "вернуть",
    "прервать", "продолжить", "правило", "повторить_начало", "повторить_шаг",
    "перебор_начало", "перебор_шаг", "конец",
)


def _данные_узла(узел):
    """Сериализует временный узел грамматики в кортеж из простых значений."""
    if узел is None:
        return ("ничто",)
    вид = type(узел).__name__
    if вид == "Число":
        return ("число", узел.значение)
    if вид == "Постоянное":
        return ("постоянное", узел.значение)
    if вид == "Имя":
        return ("имя", узел.слово, узел.лемма, узел.строка, узел.столбец)
    if вид == "Речь":
        части = []
        for вид_части, часть in узел.части:
            части.append(("текст", часть) if вид_части == "т"
                         else ("вставка", _данные_узла(часть)))
        return ("речь", tuple(части))
    if вид == "Отрицание":
        return ("отрицание", _данные_узла(узел.выражение))
    if вид == "Действие":
        return ("действие", узел.знак,
                _данные_узла(узел.лево), _данные_узла(узел.право))
    if вид == "Вызов":
        return ("вызов", узел.имя,
                tuple(_данные_узла(а) for а in узел.аргументы),
                узел.строка, узел.столбец)
    if вид == "Команда":
        слоты = tuple(
            (метка, падеж, _данные_узла(значение))
            for метка, падеж, значение in узел.слоты
        )
        return ("команда", узел.имя, слоты, узел.строка, узел.столбец)
    raise TypeError(f"байткод не умеет сериализовать узел {вид}")


def _код_выражения(узел):
    """Компилирует выражение в стековые инструкции без объектов AST."""
    код = []

    def один(текущий):
        if текущий is None:
            код.append(("константа", None))
            return
        вид = type(текущий).__name__
        if вид == "Число":
            код.append(("константа", текущий.значение))
        elif вид == "Постоянное":
            код.append(("константа", текущий.значение))
        elif вид == "Имя":
            код.append(("прочитать_имя", текущий.слово, текущий.лемма,
                        текущий.строка, текущий.столбец))
        elif вид == "Речь":
            части = []
            for вид_части, часть in текущий.части:
                if вид_части == "т":
                    части.append(("текст", часть))
                else:
                    части.append(("значение", _код_выражения(часть)))
            код.append(("собрать_речь", tuple(части)))
        elif вид == "Отрицание":
            один(текущий.выражение)
            код.append(("не",))
        elif вид == "Действие":
            один(текущий.лево)
            один(текущий.право)
            код.append(("действие", текущий.знак))
        elif вид == "Вызов":
            аргументы = tuple(_код_выражения(аргумент)
                              for аргумент in текущий.аргументы)
            код.append(("вызвать", текущий.имя, аргументы,
                        текущий.строка, текущий.столбец))
        elif вид == "Команда":
            код.append(("выполнить_команду", _данные_узла(текущий)))
        else:
            raise TypeError(f"выражение {вид} нельзя скомпилировать в стековый код")

    один(узел)
    return tuple(код)


class Программа:
    def __init__(self, команды, правила, выражения):
        self.команды = команды
        self.правила = правила
        self.выражения = выражения

    def размер(self):
        return len(self.команды)

    def вид(self, место):
        if 0 <= место < len(self.команды):
            return self.команды[место][0]
        return "конец"

    def текст(self):
        строки = []
        for место, команда in enumerate(self.команды):
            строки.append(f"{место:4d}  " + "  ".join(str(часть) for часть in команда))
        for номер, код in enumerate(self.выражения):
            строки.append(f"выражение {номер}: " + "  ".join(str(часть) for часть in код))
        for имя, (адрес, параметры, конец) in self.правила.items():
            строки.append(f"правило {имя} с {', '.join(параметры)}: {адрес}..{конец}")
        return "\n".join(строки)


def собрать(узлы):
    команды = []
    правила = {}
    выражения = []
    циклы = []

    def добавить(*команда):
        команды.append(tuple(команда))
        return len(команды) - 1

    def сохранить(узел):
        выражения.append(_код_выражения(узел))
        return len(выражения) - 1

    def тело(список):
        for узел in список:
            один(узел)

    def один(узел):
        вид = type(узел).__name__
        if вид == "Правило":
            добавить("правило", узел.имя)
        elif вид == "Объявить":
            добавить("объявить", узел.имя, сохранить(узел.значение))
        elif вид == "Присвоить":
            добавить("присвоить", узел.имя, сохранить(узел.значение))
        elif вид == "Изменить":
            добавить("изменить", узел.имя, узел.знак, сохранить(узел.значение))
        elif вид == "Сказать":
            добавить("сказать", сохранить(узел.значение))
        elif вид == "Спросить":
            подсказка = сохранить(узел.подсказка) if узел.подсказка is not None else None
            добавить("спросить", узел.имя, подсказка)
        elif вид == "Подключить":
            добавить("подключить", узел.имя)
        elif вид == "Вернуть":
            значение = сохранить(узел.значение) if узел.значение is not None else None
            добавить("вернуть", значение)
        elif вид == "Прервать":
            место = добавить("прервать", 0)
            if циклы:
                циклы[-1]["выходы"].append(место)
        elif вид == "Продолжить":
            место = добавить("продолжить", 0)
            if циклы:
                циклы[-1]["продолжения"].append(место)
        elif вид == "Если":
            если(узел)
        elif вид == "Пока":
            пока(узел)
        elif вид == "Повторить":
            повторить(узел)
        elif вид == "ДляКаждого":
            перебор(узел)
        elif вид == "Вызов":
            аргументы = tuple(сохранить(аргумент) for аргумент in узел.аргументы)
            добавить("позвать", узел.имя, аргументы, узел.строка, узел.столбец)
        elif вид == "Команда":
            добавить("команда", _данные_узла(узел))
        else:
            добавить("шаг", _данные_узла(узел))

    def если(узел):
        концы = []
        for условие, ветка in узел.ветви:
            прыжок = добавить("если_нет", сохранить(условие), 0)
            тело(ветка)
            выход = добавить("перейти", 0)
            концы.append(выход)
            команды[прыжок] = ("если_нет", команды[прыжок][1], len(команды))
        if узел.иначе:
            тело(узел.иначе)
        for выход in концы:
            команды[выход] = ("перейти", len(команды))

    def пока(узел):
        начало = len(команды)
        прыжок = добавить("если_нет", сохранить(узел.условие), 0)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        добавить("перейти", начало)
        команды[прыжок] = ("если_нет", команды[прыжок][1], len(команды))
        for место in цикл["выходы"]:
            команды[место] = ("прервать", len(команды))
        for место in цикл["продолжения"]:
            команды[место] = ("продолжить", начало)

    def повторить(узел):
        место_начала = добавить("повторить_начало", сохранить(узел.сколько), 0)
        начало = len(команды)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        шаг = добавить("повторить_шаг", начало)
        for место in цикл["продолжения"]:
            команды[место] = ("продолжить", шаг)
        for место in цикл["выходы"]:
            команды[место] = ("прервать", len(команды))
        команды[место_начала] = ("повторить_начало",
                                 команды[место_начала][1], len(команды))

    def перебор(узел):
        начало = добавить("перебор_начало", узел.имя, сохранить(узел.перечень), 0)
        тело_начало = len(команды)
        циклы.append({"выходы": [], "продолжения": []})
        тело(узел.тело)
        цикл = циклы.pop()
        шаг = добавить("перебор_шаг", тело_начало)
        for место in цикл["продолжения"]:
            команды[место] = ("продолжить", шаг)
        for место in цикл["выходы"]:
            команды[место] = ("прервать", len(команды))
        команды[начало] = ("перебор_начало", команды[начало][1],
                           команды[начало][2], len(команды))

    тело(узлы)
    добавить("конец")

    for узел in узлы:
        if isinstance(узел, гр.Правило):
            начало = len(команды)
            циклы.append({"выходы": [], "продолжения": []})
            тело(узел.тело)
            цикл = циклы.pop()
            добавить("вернуть", None)
            конец = len(команды)
            for место in цикл["выходы"]:
                команды[место] = ("прервать", конец)
            for место in цикл["продолжения"]:
                команды[место] = ("продолжить", начало)
            правила[узел.имя] = (начало, list(узел.параметры), конец)

    return Программа(команды, правила, выражения)
