from . import безопасность

ПРОВАЙДЕР_ПО_УМОЛЧАНИЮ = "нет"


def _провайдер():
    try:
        import os
        return os.environ.get(
            "ЛЕКСУС_СЕТЕВОЙ_ПРОВАЙДЕР",
            безопасность.настройки().get("сетевой_провайдер", ПРОВАЙДЕР_ПО_УМОЛЧАНИЮ),
        )
    except Exception:
        return ПРОВАЙДЕР_ПО_УМОЛЧАНИЮ


def искать(запрос, провайдер=None):
    выбран = провайдер or _провайдер()
    if выбран in ("нет", "выключен", ""):
        безопасность.записать_аудит("сеть", выбран or "нет", "запрещено", "сетевой провайдер не выбран")
        return []

    if выбран == "duckduckgo":
        from .провайдеры import duckduckgo
        if not безопасность.разрешить_сеть(duckduckgo.АДРЕС):
            return []
        _, результаты = duckduckgo.искать(запрос)
        return результаты

    raise ValueError("неизвестный сетевой провайдер: " + str(выбран))
