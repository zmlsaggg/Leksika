"""Игровые возможности Лексики: математика, векторы, холст и запись PNG.

Модуль подключается к исполнителю как набор встроенных действий (см.
``исполнитель.встроенная``). Он не заменяет учебную машину песочницы: здесь
работает настольный исполнитель, поэтому доступны файлы и полноценная
арифметика с плавающей точкой.

Правила модуля держатся на трёх простых значениях, которые язык уже умеет
показывать и сравнивать:

* вектор — перечень из трёх чисел ``[x, y, z]`` (плоские векторы получают z = 0);
* цвет — целое ``0xRRGGBB``;
* холст — словарь с ключами ``ширина``, ``высота``, ``пиксели`` и ``глубина``.

Глубина нужна треугольникам: без z-буфера ближние грани перекрывались бы
дальними. Холст сам решает, когда её заводить, поэтому заливка и линии
не тратят память впустую.

Модуль не рисует окно и не читает клавиатуру: у настольного исполнителя нет
графической подсистемы. Он готовит кадры и сохраняет их в PNG, а игровой цикл,
ввод и правила остаются в самой программе на Лексике. Это честная граница,
а не обещание готового движка.
"""

import math
import random
import struct
import time
import zlib

from . import файлы
from .ошибки import ОшибкаСмысла

ПРЕДЕЛ_СТОРОНЫ = 4096
ПРЕДЕЛ_ПИКСЕЛЕЙ = 16_000_000


def _ждать(значения, сколько, имя, строка=0, столбец=0, хотя_бы=False):
    """Проверяет число доводов. С хотя_бы=True последние доводы необязательны."""
    если_сколько = len(значения)
    if если_сколько == сколько or (хотя_бы and если_сколько > сколько):
        return
    if хотя_бы:
        raise ОшибкаСмысла(
            f"действие «{имя}» ждёт не меньше {сколько} значений, "
            f"а получило {если_сколько}",
            строка, столбец,
        )
    raise ОшибкаСмысла(
        f"действие «{имя}» ждёт {сколько} значений, а получило {если_сколько}",
        строка, столбец,
    )


def _число(и, значение, где, строка=0, столбец=0):
    try:
        return и.в_число(значение, где)
    except ОшибкаСмысла as ошибка:
        raise ОшибкаСмысла(ошибка.сообщение, строка or ошибка.строка,
                           столбец or ошибка.столбец, ошибка.подсказка)


def _дробное(и, значение, где, строка=0, столбец=0):
    return float(_число(и, значение, где, строка, столбец))


def _вектор(значение, где, строка=0, столбец=0):
    if isinstance(значение, (list, tuple)):
        if len(значение) == 2:
            return [float(значение[0]), float(значение[1]), 0.0]
        if len(значение) == 3:
            return [float(значение[0]), float(значение[1]), float(значение[2])]
    raise ОшибкаСмысла(
        f"{где} ждёт вектор из двух или трёх чисел, а получено "
        + ("перечень другой длины" if isinstance(значение, (list, tuple))
           else "иное значение"),
        строка, столбец,
        "создайте вектор действием «вектор(x, y, z)»",
    )


def _холст(значение, где, строка=0, столбец=0):
    if isinstance(значение, dict) and "пиксели" in значение:
        return значение
    raise ОшибкаСмысла(
        f"{где} ждёт холст, созданный действием «холст(ширина, высота)»",
        строка, столбец,
    )


def _цвет(значение, где, строка=0, столбец=0):
    if isinstance(значение, bool) or not isinstance(значение, int):
        raise ОшибкаСмысла(
            f"{где} ждёт цвет, собранный действием «цвет(красный, зелёный, синий)»",
            строка, столбец,
        )
    if not 0 <= значение <= 0xFFFFFF:
        raise ОшибкаСмысла(f"{где}: цвет должен быть от 0 до 16777215", строка, столбец)
    return значение


def _глубина(холст, ширина, высота):
    буфер = холст.get("глубина")
    if буфер is None:
        # Бесконечность — «здесь ещё ничего не нарисовано»: ближе будет любая точка.
        буфер = [float("inf")] * (ширина * высота)
        холст["глубина"] = буфер
    return буфер


def _границы(холст):
    return холст["ширина"], холст["высота"], холст["пиксели"]


# --- Математика -----------------------------------------------------------


def синус(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "синус", строка, столбец)
    return math.sin(_дробное(и, значения[0], "синус", строка, столбец))


def косинус(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "косинус", строка, столбец)
    return math.cos(_дробное(и, значения[0], "косинус", строка, столбец))


def тангенс(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "тангенс", строка, столбец)
    угол = _дробное(и, значения[0], "тангенс", строка, столбец)
    if abs(math.cos(угол)) < 1e-15:
        raise ОшибкаСмысла(
            "тангенс не определён при этом угле", строка, столбец,
            "косинус угла равен нулю, возьмите угол чуть меньше или больше",
        )
    return math.tan(угол)


def арктангенс(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "арктангенс", строка, столбец)
    у = _дробное(и, значения[0], "арктангенс", строка, столбец)
    х = _дробное(и, значения[1], "арктангенс", строка, столбец)
    return math.atan2(у, х)


def степень(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "степень", строка, столбец)
    основание = _дробное(и, значения[0], "степень", строка, столбец)
    показатель = _дробное(и, значения[1], "степень", строка, столбец)
    if основание < 0 and not float(показатель).is_integer():
        raise ОшибкаСмысла(
            "степень отрицательного числа с дробным показателем не определена",
            строка, столбец,
        )
    try:
        итог = основание ** показатель
    except (OverflowError, ZeroDivisionError):
        raise ОшибкаСмысла("степень вышла за пределы чисел", строка, столбец)
    if isinstance(итог, complex):
        raise ОшибкаСмысла("степень дала комплексное число", строка, столбец)
    return итог


def предел(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "предел", строка, столбец)
    значение = _дробное(и, значения[0], "предел", строка, столбец)
    низ = _дробное(и, значения[1], "предел", строка, столбец)
    верх = _дробное(и, значения[2], "предел", строка, столбец)
    if низ > верх:
        raise ОшибкаСмысла(
            "нижний предел больше верхнего", строка, столбец,
            "переставьте границы: сначала меньшее число",
        )
    return min(max(значение, низ), верх)


def наименьшее(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "наименьшее", строка, столбец)
    return min(_дробное(и, значения[0], "наименьшее", строка, столбец),
               _дробное(и, значения[1], "наименьшее", строка, столбец))


def наибольшее(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "наибольшее", строка, столбец)
    return max(_дробное(и, значения[0], "наибольшее", строка, столбец),
               _дробное(и, значения[1], "наибольшее", строка, столбец))


def знак(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "знак", строка, столбец)
    значение = _дробное(и, значения[0], "знак", строка, столбец)
    if значение > 0:
        return 1
    if значение < 0:
        return -1
    return 0


def пи(и, значения, строка=0, столбец=0):
    _ждать(значения, 0, "пи", строка, столбец)
    return math.pi


def миллисекунды(и, значения, строка=0, столбец=0):
    _ждать(значения, 0, "миллисекунды", строка, столбец)
    return int(time.monotonic() * 1000)


def посеять(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "посеять", строка, столбец)
    random.seed(int(_число(и, значения[0], "посеять", строка, столбец)))
    return None


def жребий(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "жребий", строка, столбец)
    от = _дробное(и, значения[0], "жребий", строка, столбец)
    до = _дробное(и, значения[1], "жребий", строка, столбец)
    if от > до:
        raise ОшибкаСмысла(
            "нижняя граница жребия больше верхней", строка, столбец,
        )
    return random.uniform(от, до)


def доля(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "доля", строка, столбец)
    начало = _дробное(и, значения[0], "доля", строка, столбец)
    конец = _дробное(и, значения[1], "доля", строка, столбец)
    вес = _дробное(и, значения[2], "доля", строка, столбец)
    return начало + (конец - начало) * вес


def плавно(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "плавно", строка, столбец)
    вес = min(max(_дробное(и, значения[0], "плавно", строка, столбец), 0.0), 1.0)
    return вес * вес * (3 - 2 * вес)


# --- Векторы --------------------------------------------------------------


def вектор(и, значения, строка=0, столбец=0):
    if len(значения) not in (2, 3):
        raise ОшибкаСмысла(
            f"вектор ждёт два или три числа, а получил {len(значения)}",
            строка, столбец,
        )

    def координата(значение, имя):
        return _дробное(и, значение, имя, строка, столбец)

    if len(значения) == 2:
        return [координата(значения[0], "вектор"), координата(значения[1], "вектор"), 0.0]
    return [координата(значения[0], "вектор"), координата(значения[1], "вектор"),
            координата(значения[2], "вектор")]


def длинавектора(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "длинавектора", строка, столбец)
    x, y, z = _вектор(значения[0], "длинавектора", строка, столбец)
    return math.sqrt(x * x + y * y + z * z)


def нормальвектора(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "нормальвектора", строка, столбец)
    x, y, z = _вектор(значения[0], "нормальвектора", строка, столбец)
    длина = math.sqrt(x * x + y * y + z * z)
    if длина == 0:
        return [0.0, 0.0, 0.0]
    return [x / длина, y / длина, z / длина]


def скалярноепроизведение(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "скалярноепроизведение", строка, столбец)
    ax, ay, az = _вектор(значения[0], "скалярноепроизведение", строка, столбец)
    bx, by, bz = _вектор(значения[1], "скалярноепроизведение", строка, столбец)
    return ax * bx + ay * by + az * bz


def векторноепроизведение(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "векторноепроизведение", строка, столбец)
    ax, ay, az = _вектор(значения[0], "векторноепроизведение", строка, столбец)
    bx, by, bz = _вектор(значения[1], "векторноепроизведение", строка, столбец)
    return [ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx]


def сложитьвекторы(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "сложитьвекторы", строка, столбец)
    ax, ay, az = _вектор(значения[0], "сложитьвекторы", строка, столбец)
    bx, by, bz = _вектор(значения[1], "сложитьвекторы", строка, столбец)
    return [ax + bx, ay + by, az + bz]


def вычестьвекторы(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "вычестьвекторы", строка, столбец)
    ax, ay, az = _вектор(значения[0], "вычестьвекторы", строка, столбец)
    bx, by, bz = _вектор(значения[1], "вычестьвекторы", строка, столбец)
    return [ax - bx, ay - by, az - bz]


def умножитьвектор(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "умножитьвектор", строка, столбец)
    x, y, z = _вектор(значения[0], "умножитьвектор", строка, столбец)
    множитель = _дробное(и, значения[1], "умножитьвектор", строка, столбец)
    return [x * множитель, y * множитель, z * множитель]


def повернутьвектор(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "повернутьвектор", строка, столбец)
    x, y, z = _вектор(значения[0], "повернутьвектор", строка, столбец)
    ox, oy, oz = _вектор(значения[1], "повернутьвектор", строка, столбец)
    угол = _дробное(и, значения[2], "повернутьвектор", строка, столбец)
    длина_оси = math.sqrt(ox * ox + oy * oy + oz * oz)
    if длина_оси == 0:
        raise ОшибкаСмысла(
            "ось поворота не может быть нулевой", строка, столбец,
            "задайте ось, например вектор(0, 0, 1) для плоского поворота",
        )
    ox, oy, oz = ox / длина_оси, oy / длина_оси, oz / длина_оси
    косинус_угла = math.cos(угол)
    синус_угла = math.sin(угол)
    # Формула Родрига: v·cos + (ось × v)·sin + ось·(ось·v)·(1 − cos).
    скаляр = ox * x + oy * y + oz * z
    return [
        x * косинус_угла + (oy * z - oz * y) * синус_угла + ox * скаляр * (1 - косинус_угла),
        y * косинус_угла + (oz * x - ox * z) * синус_угла + oy * скаляр * (1 - косинус_угла),
        z * косинус_угла + (ox * y - oy * x) * синус_угла + oz * скаляр * (1 - косинус_угла),
    ]


# --- Холст и рисование ----------------------------------------------------


def холст(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "холст", строка, столбец)
    ширина = int(_число(и, значения[0], "холст", строка, столбец))
    высота = int(_число(и, значения[1], "холст", строка, столбец))
    if ширина < 1 or высота < 1:
        raise ОшибкаСмысла("холст не может быть меньше одного пикселя", строка, столбец)
    if ширина > ПРЕДЕЛ_СТОРОНЫ or высота > ПРЕДЕЛ_СТОРОНЫ:
        raise ОшибкаСмысла(
            f"сторона холста не больше {ПРЕДЕЛ_СТОРОНЫ} пикселей", строка, столбец,
        )
    if ширина * высота > ПРЕДЕЛ_ПИКСЕЛЕЙ:
        raise ОшибкаСмысла(
            f"в холсте не больше {ПРЕДЕЛ_ПИКСЕЛЕЙ} пикселей", строка, столбец,
            "нарисуйте кадр меньшего размера",
        )
    return {
        "ширина": ширина,
        "высота": высота,
        "пиксели": bytearray(ширина * высота * 3),
        "глубина": None,
    }


def цвет(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "цвет", строка, столбец)
    части = []
    for значение, имя in zip(значения, ("красный", "зелёный", "синий")):
        канал = int(_число(и, значение, "цвет", строка, столбец))
        if not 0 <= канал <= 255:
            raise ОшибкаСмысла(f"{имя} канал должен быть от 0 до 255", строка, столбец)
        части.append(канал)
    return (части[0] << 16) | (части[1] << 8) | части[2]


def залить(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "залить", строка, столбец)
    поверхность = _холст(значения[0], "залить", строка, столбец)
    оттенок = _цвет(значения[1], "залить", строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    байт = bytes(((оттенок >> 16) & 0xFF, (оттенок >> 8) & 0xFF, оттенок & 0xFF))
    пиксели[:] = байт * (ширина * высота)
    return None


def мазок(и, значения, строка=0, столбец=0):
    _ждать(значения, 4, "мазок", строка, столбец)
    поверхность = _холст(значения[0], "мазок", строка, столбец)
    x = int(_число(и, значения[1], "мазок", строка, столбец))
    y = int(_число(и, значения[2], "мазок", строка, столбец))
    оттенок = _цвет(значения[3], "мазок", строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    if 0 <= x < ширина and 0 <= y < высота:
        место = (y * ширина + x) * 3
        пиксели[место] = (оттенок >> 16) & 0xFF
        пиксели[место + 1] = (оттенок >> 8) & 0xFF
        пиксели[место + 2] = оттенок & 0xFF
    return None


def пиксель(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "пиксель", строка, столбец)
    поверхность = _холст(значения[0], "пиксель", строка, столбец)
    x = int(_число(и, значения[1], "пиксель", строка, столбец))
    y = int(_число(и, значения[2], "пиксель", строка, столбец))
    ширина, высота, пиксели = _границы(поверхность)
    if not (0 <= x < ширина and 0 <= y < высота):
        raise ОшибкаСмысла(
            f"пикселя {x}, {y} нет на холсте {ширина}×{высота}", строка, столбец,
        )
    место = (y * ширина + x) * 3
    return (пиксели[место] << 16) | (пиксели[место + 1] << 8) | пиксели[место + 2]


def отрезок(и, значения, строка=0, столбец=0):
    _ждать(значения, 6, "отрезок", строка, столбец)
    поверхность = _холст(значения[0], "отрезок", строка, столбец)
    x1 = int(_число(и, значения[1], "отрезок", строка, столбец))
    y1 = int(_число(и, значения[2], "отрезок", строка, столбец))
    x2 = int(_число(и, значения[3], "отрезок", строка, столбец))
    y2 = int(_число(и, значения[4], "отрезок", строка, столбец))
    оттенок = _цвет(значения[5], "отрезок", строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    красный, зелёный, синий = ((оттенок >> 16) & 0xFF, (оттенок >> 8) & 0xFF, оттенок & 0xFF)
    # Целочисленный алгоритм Брезенхема: без делений с плавающей точкой в цикле.
    шаг_x = 1 if x1 < x2 else -1
    шаг_y = 1 if y1 < y2 else -1
    разница_x = abs(x2 - x1)
    разница_y = abs(y2 - y1)
    ошибка = разница_x - разница_y
    while True:
        if 0 <= x1 < ширина and 0 <= y1 < высота:
            место = (y1 * ширина + x1) * 3
            пиксели[место] = красный
            пиксели[место + 1] = зелёный
            пиксели[место + 2] = синий
        if x1 == x2 and y1 == y2:
            break
        удвоенная = ошибка * 2
        if удвоенная > -разница_y:
            ошибка -= разница_y
            x1 += шаг_x
        if удвоенная < разница_x:
            ошибка += разница_x
            y1 += шаг_y
    return None


def прямоугольник(и, значения, строка=0, столбец=0):
    _ждать(значения, 6, "прямоугольник", строка, столбец)
    поверхность = _холст(значения[0], "прямоугольник", строка, столбец)
    x = int(_число(и, значения[1], "прямоугольник", строка, столбец))
    y = int(_число(и, значения[2], "прямоугольник", строка, столбец))
    ш = int(_число(и, значения[3], "прямоугольник", строка, столбец))
    в = int(_число(и, значения[4], "прямоугольник", строка, столбец))
    оттенок = _цвет(значения[5], "прямоугольник", строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    if ш < 0 or в < 0:
        raise ОшибкаСмысла("ширина и высота прямоугольника не могут быть отрицательными",
                           строка, столбец)
    начало_x = max(0, x)
    конец_x = min(ширина, x + ш)
    начало_y = max(0, y)
    конец_y = min(высота, y + в)
    if начало_x >= конец_x or начало_y >= конец_y:
        return None
    байт = bytes(((оттенок >> 16) & 0xFF, (оттенок >> 8) & 0xFF, оттенок & 0xFF))
    полоса = байт * (конец_x - начало_x)
    for строка_холста in range(начало_y, конец_y):
        место = (строка_холста * ширина + начало_x) * 3
        пиксели[место:место + len(полоса)] = полоса
    return None


def круг(и, значения, строка=0, столбец=0):
    _ждать(значения, 5, "круг", строка, столбец)
    поверхность = _холст(значения[0], "круг", строка, столбец)
    центре_x = int(_число(и, значения[1], "круг", строка, столбец))
    центре_y = int(_число(и, значения[2], "круг", строка, столбец))
    радиус = int(_число(и, значения[3], "круг", строка, столбец))
    оттенок = _цвет(значения[4], "круг", строка, столбец)
    if радиус < 0:
        raise ОшибкаСмысла("радиус круга не может быть отрицательным", строка, столбец)
    if радиус == 0:
        return мазок(и, [поверхность, центре_x, центре_y, оттенок], строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    байт = bytes(((оттенок >> 16) & 0xFF, (оттенок >> 8) & 0xFF, оттенок & 0xFF))
    квадрат = радиус * радиус
    for смещение_y in range(-радиус, радиус + 1):
        y = центре_y + смещение_y
        if not 0 <= y < высота:
            continue
        остаток = квадрат - смещение_y * смещение_y
        полуширина = int(math.isqrt(остаток))
        начало_x = max(0, центре_x - полуширина)
        конец_x = min(ширина, центре_x + полуширина + 1)
        if начало_x >= конец_x:
            continue
        место = (y * ширина + начало_x) * 3
        пиксели[место:место + (конец_x - начало_x) * 3] = байт * (конец_x - начало_x)
    return None


def треугольник(и, значения, строка=0, столбец=0):
    """Рисует закрашенный треугольник с проверкой глубины.

    Точки задаются векторами из трёх чисел: x и y — место на холсте,
    третье число — глубина. Меньшая глубина ближе к зрителю. Яркость
    (необязательный шестой довод) затемняет цвет: так одна и та же грань
    выглядит по-разному при повороте.
    """
    if len(значения) not in (5, 6):
        raise ОшибкаСмысла(
            f"треугольник ждёт пять или шесть значений, а получил {len(значения)}",
            строка, столбец,
        )
    поверхность = _холст(значения[0], "треугольник", строка, столбец)
    точки = [_вектор(значения[номер], "треугольник", строка, столбец) for номер in (1, 2, 3)]
    оттенок = _цвет(значения[4], "треугольник", строка, столбец)
    яркость = 1.0
    if len(значения) == 6:
        яркость = min(max(_дробное(и, значения[5], "треугольник", строка, столбец), 0.0), 1.0)
    ширина, высота, пиксели = _границы(поверхность)
    буфер = _глубина(поверхность, ширина, высота)
    красный = int(((оттенок >> 16) & 0xFF) * яркость)
    зелёный = int(((оттенок >> 8) & 0xFF) * яркость)
    синий = int((оттенок & 0xFF) * яркость)

    (x1, y1, z1), (x2, y2, z2), (x3, y3, z3) = точки
    площадь = (x2 - x1) * (y3 - y1) - (x3 - x1) * (y2 - y1)
    if abs(площадь) < 1e-12:
        return None
    # Отсекаем по границам холста: перебор идёт только по видимой части.
    начало_x = max(0, int(math.floor(min(x1, x2, x3))))
    конец_x = min(ширина - 1, int(math.ceil(max(x1, x2, x3))))
    начало_y = max(0, int(math.floor(min(y1, y2, y3))))
    конец_y = min(высота - 1, int(math.ceil(max(y1, y2, y3))))
    if начало_x > конец_x or начало_y > конец_y:
        return None
    обратная = 1.0 / площадь
    for y in range(начало_y, конец_y + 1):
        смещение_y = y + 0.5 - y1
        строка_места = y * ширина
        for x in range(начало_x, конец_x + 1):
            смещение_x = x + 0.5 - x1
            вес2 = (смещение_x * (y3 - y1) - смещение_y * (x3 - x1)) * обратная
            вес3 = (смещение_y * (x2 - x1) - смещение_x * (y2 - y1)) * обратная
            вес1 = 1.0 - вес2 - вес3
            if вес1 < 0 or вес2 < 0 or вес3 < 0:
                continue
            глубина = вес1 * z1 + вес2 * z2 + вес3 * z3
            место = строка_места + x
            if глубина >= буфер[место]:
                continue
            буфер[место] = глубина
            байт = место * 3
            пиксели[байт] = красный
            пиксели[байт + 1] = зелёный
            пиксели[байт + 2] = синий
    return None


def _сжать_строки(ширина, высота, пиксели):
    шаг = ширина * 3
    готово = bytearray(высота * (шаг + 1))
    for y in range(высота):
        from_line = y * шаг
        to_line = y * (шаг + 1)
        # Нулевой байт — фильтр «без изменений»: сжатие остаётся простым.
        готово[to_line + 1:to_line + 1 + шаг] = пиксели[from_line:from_line + шаг]
    return bytes(готово)


def _кусок(вид, тело):
    return (struct.pack(">I", len(тело)) + вид + тело
            + struct.pack(">I", zlib.crc32(вид + тело) & 0xFFFFFFFF))


def _png(ширина, высота, пиксели):
    заголовок = struct.pack(">IIBBBBB", ширина, высота, 8, 2, 0, 0, 0)
    основа = _сжать_строки(ширина, высота, пиксели)
    return (b"\x89PNG\r\n\x1a\n"
            + _кусок(b"IHDR", заголовок)
            + _кусок(b"IDAT", zlib.compress(основа, 9))
            + _кусок(b"IEND", b""))


def сохранитьхолст(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "сохранитьхолст", строка, столбец)
    поверхность = _холст(значения[0], "сохранитьхолст", строка, столбец)
    путь = значения[1]
    if not isinstance(путь, str) or not путь.strip():
        raise ОшибкаСмысла("сохранитьхолст ждёт путь к файлу", строка, столбец)
    ширина, высота, пиксели = _границы(поверхность)
    данные = _png(ширина, высота, пиксели)
    try:
        файлы.записать_байты(путь, данные)
    except PermissionError:
        raise ОшибкаСмысла(
            f"запись «{путь}» запрещена политикой безопасности", строка, столбец,
            "выберите путь внутри разрешённого каталога",
        )
    except OSError as ошибка:
        raise ОшибкаСмысла(f"не удалось записать «{путь}»: {ошибка}", строка, столбец)
    return путь



def _png_прочитать(данные, где, строка=0, столбец=0):
    """Разбирает PNG на строки пикселей и возвращает (ширина, высота, пиксели)."""
    if данные[:8] != b"\x89PNG\r\n\x1a\n":
        raise ОшибкаСмысла(
            f"{где} ждёт картинку в формате PNG", строка, столбец,
            "другие форматы язык пока не читает",
        )
    место = 8
    ширина = высота = бит = вид = 0
    чересстрочно = 0
    сжатое = bytearray()
    палитра = b""
    while место + 8 <= len(данные):
        длина, имя_куска = struct.unpack(">I4s", данные[место:место + 8])
        тело = данные[место + 8:место + 8 + длина]
        место += 12 + длина
        if имя_куска == b"IHDR":
            if длина != 13:
                raise ОшибкаСмысла("заголовок картинки испорчен", строка, столбец)
            ширина, высота, бит, вид, _, _, чересстрочно = struct.unpack(">IIBBBBB", тело)
        elif имя_куска == b"PLTE":
            палитра = тело
        elif имя_куска == b"IDAT":
            сжатое += тело
        elif имя_куска == b"IEND":
            break
    каналы = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(вид)
    if not ширина or not высота:
        raise ОшибкаСмысла("в картинке нет заголовка с размером", строка, столбец)
    if каналы is None:
        raise ОшибкаСмысла(f"вид пикселей {вид} не поддерживается", строка, столбец)
    if бит not in (1, 2, 4, 8):
        raise ОшибкаСмысла(
            f"поддерживаются картинки с 1, 2, 4 или 8 битами на канал, а здесь {бит}",
            строка, столбец,
        )
    if бит != 8 and вид != 0 and вид != 3:
        raise ОшибкаСмысла(
            "цветные и прозрачные картинки читаются только с 8 битами на канал",
            строка, столбец,
        )
    if вид == 3 and not палитра:
        raise ОшибкаСмысла("в картинке с палитрой нет самой палитры", строка, столбец)
    if чересстрочно:
        raise ОшибкаСмысла("картинки с чередованием строк не поддерживаются", строка, столбец)
    if ширина > ПРЕДЕЛ_СТОРОНЫ or высота > ПРЕДЕЛ_СТОРОНЫ:
        raise ОшибкаСмысла(
            f"сторона картинки не больше {ПРЕДЕЛ_СТОРОНЫ} пикселей", строка, столбец,
        )
    if ширина * высота > ПРЕДЕЛ_ПИКСЕЛЕЙ:
        raise ОшибкаСмысла(
            f"в картинке не больше {ПРЕДЕЛ_ПИКСЕЛЕЙ} пикселей", строка, столбец,
        )
    try:
        сырое = zlib.decompress(bytes(сжатое))
    except zlib.error:
        raise ОшибкаСмысла("сжатые данные картинки испорчены", строка, столбец)
    шаг = max(1, (бит * каналы) // 8)
    ширина_строки = (ширина * каналы * бит + 7) // 8
    if len(сырое) < (ширина_строки + 1) * высота:
        raise ОшибкаСмысла("в картинке не хватает строк", строка, столбец)

    прошлое = bytearray(ширина_строки)
    пиксели = bytearray(ширина * высота * 3)
    чтение = 0
    for номер_строки in range(высота):
        фильтр = сырое[чтение]
        чтение += 1
        текущее = bytearray(сырое[чтение:чтение + ширина_строки])
        чтение += ширина_строки
        if фильтр == 1:
            for байт in range(шаг, ширина_строки):
                текущее[байт] = (текущее[байт] + текущее[байт - шаг]) & 0xFF
        elif фильтр == 2:
            for байт in range(ширина_строки):
                текущее[байт] = (текущее[байт] + прошлое[байт]) & 0xFF
        elif фильтр == 3:
            for байт in range(ширина_строки):
                левый = текущее[байт - шаг] if байт >= шаг else 0
                текущее[байт] = (текущее[байт] + ((левый + прошлое[байт]) >> 1)) & 0xFF
        elif фильтр == 4:
            for байт in range(ширина_строки):
                левый = текущее[байт - шаг] if байт >= шаг else 0
                верхний = прошлое[байт]
                левый_верхний = прошлое[байт - шаг] if байт >= шаг else 0
                предсказание = левый + верхний - левый_верхний
                разница_левого = abs(предсказание - левый)
                разница_верхнего = abs(предсказание - верхний)
                разница_угла = abs(предсказание - левый_верхний)
                if разница_левого <= разница_верхнего and разница_левого <= разница_угла:
                    добавка = левый
                elif разница_верхнего <= разница_угла:
                    добавка = верхний
                else:
                    добавка = левый_верхний
                текущее[байт] = (текущее[байт] + добавка) & 0xFF
        elif фильтр != 0:
            raise ОшибкаСмысла(f"неизвестный фильтр строки {фильтр}", строка, столбец)

        основа = номер_строки * ширина * 3
        if бит < 8:
            маска = (1 << бит) - 1
            for номер in range(ширина):
                положение = номер * бит
                сэмпл = (текущее[положение >> 3] >> (8 - бит - (положение & 7))) & маска
                куда = основа + номер * 3
                if вид == 3:
                    место_палитры = сэмпл * 3
                    if место_палитры + 2 < len(палитра):
                        пиксели[куда] = палитра[место_палитры]
                        пиксели[куда + 1] = палитра[место_палитры + 1]
                        пиксели[куда + 2] = палитра[место_палитры + 2]
                else:
                    серый = сэмпл * 255 // маска
                    пиксели[куда] = серый
                    пиксели[куда + 1] = серый
                    пиксели[куда + 2] = серый
        elif вид == 2:
            пиксели[основа:основа + ширина * 3] = текущее
        elif вид == 6:
            for пиксель_номер in range(ширина):
                откуда = пиксель_номер * 4
                куда = основа + пиксель_номер * 3
                пиксели[куда] = текущее[откуда]
                пиксели[куда + 1] = текущее[откуда + 1]
                пиксели[куда + 2] = текущее[откуда + 2]
        elif вид == 0:
            for пиксель_номер in range(ширина):
                серый = текущее[пиксель_номер]
                куда = основа + пиксель_номер * 3
                пиксели[куда] = серый
                пиксели[куда + 1] = серый
                пиксели[куда + 2] = серый
        elif вид == 4:
            for пиксель_номер in range(ширина):
                серый = текущее[пиксель_номер * 2]
                куда = основа + пиксель_номер * 3
                пиксели[куда] = серый
                пиксели[куда + 1] = серый
                пиксели[куда + 2] = серый
        else:
            for пиксель_номер in range(ширина):
                место_палитры = текущее[пиксель_номер] * 3
                куда = основа + пиксель_номер * 3
                if место_палитры + 2 < len(палитра):
                    пиксели[куда] = палитра[место_палитры]
                    пиксели[куда + 1] = палитра[место_палитры + 1]
                    пиксели[куда + 2] = палитра[место_палитры + 2]
        прошлое = текущее
    return ширина, высота, пиксели


def загрузитьхолст(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "загрузитьхолст", строка, столбец)
    путь = значения[0]
    if not isinstance(путь, str) or not путь.strip():
        raise ОшибкаСмысла("загрузитьхолст ждёт путь к файлу", строка, столбец)
    try:
        данные = файлы.прочитать_байты(путь)
    except FileNotFoundError:
        raise ОшибкаСмысла(f"файла «{путь}» нет", строка, столбец, "проверьте имя и каталог")
    except PermissionError:
        raise ОшибкаСмысла(
            f"чтение «{путь}» запрещено политикой безопасности", строка, столбец,
            "выберите путь внутри разрешённого каталога",
        )
    except OSError as ошибка:
        raise ОшибкаСмысла(f"не удалось прочитать «{путь}»: {ошибка}", строка, столбец)
    ширина, высота, пиксели = _png_прочитать(данные, "загрузитьхолст", строка, столбец)
    return {"ширина": ширина, "высота": высота, "пиксели": пиксели, "глубина": None}


def вырезать(и, значения, строка=0, столбец=0):
    _ждать(значения, 5, "вырезать", строка, столбец)
    исходный = _холст(значения[0], "вырезать", строка, столбец)
    x = int(_число(и, значения[1], "вырезать", строка, столбец))
    y = int(_число(и, значения[2], "вырезать", строка, столбец))
    ширина_куска = int(_число(и, значения[3], "вырезать", строка, столбец))
    высота_куска = int(_число(и, значения[4], "вырезать", строка, столбец))
    ширина, высота, пиксели = _границы(исходный)
    if ширина_куска < 1 or высота_куска < 1:
        raise ОшибкаСмысла("кусок картинки не может быть пустым", строка, столбец)
    if x < 0 or y < 0 or x + ширина_куска > ширина or y + высота_куска > высота:
        raise ОшибкаСмысла(
            f"куска {ширина_куска}×{высота_куска} с точкой {x}, {y} "
            f"нет на холсте {ширина}×{высота}",
            строка, столбец,
        )
    кусок = bytearray(ширина_куска * высота_куска * 3)
    for номер_строки in range(высота_куска):
        откуда = ((y + номер_строки) * ширина + x) * 3
        куда = номер_строки * ширина_куска * 3
        кусок[куда:куда + ширина_куска * 3] = пиксели[откуда:откуда + ширина_куска * 3]
    return {
        "ширина": ширина_куска,
        "высота": высота_куска,
        "пиксели": кусок,
        "глубина": None,
    }


def наложить(и, значения, строка=0, столбец=0):
    _ждать(значения, 4, "наложить", строка, столбец, хотя_бы=True)
    основа = _холст(значения[0], "наложить", строка, столбец)
    картинка = _холст(значения[1], "наложить", строка, столбец)
    сдвиг_x = int(_число(и, значения[2], "наложить", строка, столбец))
    сдвиг_y = int(_число(и, значения[3], "наложить", строка, столбец))
    своя_ширина, своя_высота, свои_пиксели = _границы(основа)
    чужая_ширина, чужая_высота, чужие_пиксели = _границы(картинка)
    прозрачный = None
    if len(значения) > 4:
        прозрачный = _цвет(значения[4], "наложить", строка, столбец)
        ключ = bytes(((прозрачный >> 16) & 0xFF, (прозрачный >> 8) & 0xFF, прозрачный & 0xFF))
        for номер_строки in range(чужая_высота):
            куда_y = сдвиг_y + номер_строки
            if not 0 <= куда_y < своя_высота:
                continue
            for номер_столбца in range(чужая_ширина):
                куда_x = сдвиг_x + номер_столбца
                if not 0 <= куда_x < своя_ширина:
                    continue
                откуда = (номер_строки * чужая_ширина + номер_столбца) * 3
                if чужие_пиксели[откуда:откуда + 3] == ключ:
                    continue
                куда = (куда_y * своя_ширина + куда_x) * 3
                свои_пиксели[куда:куда + 3] = чужие_пиксели[откуда:откуда + 3]
        return None
    for номер_строки in range(чужая_высота):
        куда_y = сдвиг_y + номер_строки
        if not 0 <= куда_y < своя_высота:
            continue
        от = 0
        до = чужая_ширина
        if сдвиг_x < 0:
            от = -сдвиг_x
        if сдвиг_x + до > своя_ширина:
            до = своя_ширина - сдвиг_x
        if до <= от:
            continue
        откуда = (номер_строки * чужая_ширина + от) * 3
        куда = (куда_y * своя_ширина + сдвиг_x + от) * 3
        пачка = (до - от) * 3
        свои_пиксели[куда:куда + пачка] = чужие_пиксели[откуда:откуда + пачка]
    return None


def смешать(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "смешать", строка, столбец)
    первый = _цвет(значения[0], "смешать", строка, столбец)
    второй = _цвет(значения[1], "смешать", строка, столбец)
    вес = _дробное(и, значения[2], "смешать", строка, столбец)
    вес = 0.0 if вес < 0 else 1.0 if вес > 1 else вес
    каналы = []
    for сдвиг in (16, 8, 0):
        а = (первый >> сдвиг) & 0xFF
        б = (второй >> сдвиг) & 0xFF
        каналы.append(int(round(а + (б - а) * вес)))
    return (каналы[0] << 16) | (каналы[1] << 8) | каналы[2]


def заменить(и, значения, строка=0, столбец=0):
    _ждать(значения, 3, "заменить", строка, столбец)
    перечень = значения[0]
    if not isinstance(перечень, list):
        raise ОшибкаСмысла(
            "заменить работает с перечнем", строка, столбец,
            "сначала заведите перечень, например перечень(1, 2, 3)",
        )
    номер = int(_число(и, значения[1], "заменить", строка, столбец))
    if not 0 <= номер < len(перечень):
        raise ОшибкаСмысла(
            f"в перечне нет номера {номер}", строка, столбец,
            f"сейчас доступно элементов: {len(перечень)}",
        )
    перечень[номер] = значения[2]
    return None


def выбрать(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "выбрать", строка, столбец)
    перечень = значения[0]
    if not isinstance(перечень, list) or not перечень:
        raise ОшибкаСмысла("выбрать ждёт непустой перечень", строка, столбец)
    return random.choice(перечень)


def перемешать(и, значения, строка=0, столбец=0):
    _ждать(значения, 1, "перемешать", строка, столбец)
    перечень = значения[0]
    if not isinstance(перечень, list):
        raise ОшибкаСмысла("перемешать работает с перечнем", строка, столбец)
    random.shuffle(перечень)
    return None


def расстояние(и, значения, строка=0, столбец=0):
    _ждать(значения, 2, "расстояние", строка, столбец)
    первый = _вектор(значения[0], "расстояние", строка, столбец)
    второй = _вектор(значения[1], "расстояние", строка, столбец)
    return math.dist(первый, второй)


