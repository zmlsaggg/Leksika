import json
import os


КОРЕНЬ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ФАЙЛ = os.path.join(КОРЕНЬ, "данные", "словарь", "разговорные_слова.json")

ПРОФИЛИ = ("взрослая_лексика", "зумер_лексика")
РОДЫ = {"м", "ж", "с"}


def _прочитать():
    try:
        with open(ФАЙЛ, encoding="utf-8") as файл:
            данные = json.load(файл)
    except FileNotFoundError as ошибка:
        raise ValueError(
            "не найден словарь разговорных профилей: " + ФАЙЛ
        ) from ошибка
    except (OSError, json.JSONDecodeError) as ошибка:
        raise ValueError("не удалось прочитать словарь профилей: " + str(ошибка)) from ошибка

    if not isinstance(данные, dict):
        raise ValueError("корень словаря языковых профилей должен быть объектом")
    if данные.get("schema") != 2 or not isinstance(данные.get("profiles"), dict):
        raise ValueError("неподдерживаемая версия словаря языковых профилей")
    for ключ in ПРОФИЛИ:
        if not isinstance(данные["profiles"].get(ключ), dict):
            raise ValueError(f"в словаре отсутствует или повреждён профиль «{ключ}»")
    return данные["profiles"]


def включённые(настройки):
    профили = _прочитать()
    return [
        (ключ, профили[ключ])
        for ключ in ПРОФИЛИ
        if настройки.get(ключ, False) is True
    ]


def названия(настройки):
    return [
        описание.get("name", ключ)
        for ключ, описание in включённые(настройки)
    ]


def алиасы_команд(настройки):
    итог = {}
    for ключ, описание in включённые(настройки):
        алиасы = описание.get("command_aliases", {})
        if not isinstance(алиасы, dict):
            raise ValueError(f"в профиле «{ключ}» повреждён список синонимов")

        for лемма, формы in алиасы.items():
            if not isinstance(лемма, str) or not isinstance(формы, list):
                raise ValueError(f"в профиле «{ключ}» неверно описаны синонимы")
            if лемма not in {"пусть", "равно", "положить", "увеличить", "уменьшить",
                              "прибавить", "отнять", "умножить", "разделить",
                              "сказать", "спросить", "если", "то", "иначе",
                              "конец", "пока", "повторять", "раз", "для",
                              "каждый", "правило", "принимает", "вернуть",
                              "прервать", "продолжить", "подключить", "позвать",
                              "речь", "истина", "ложь", "ничто", "и", "или",
                              "не", "плюс", "минус", "больше", "меньше",
                              "содержит", "остаток", "длина", "взять",
                              "добавить", "убрать", "записать", "прочитать",
                              "ключи"}:
                raise ValueError(f"в профиле «{ключ}» неизвестная команда «{лемма}»")
            for форма in формы:
                if not isinstance(форма, str) or not форма.strip():
                    raise ValueError(f"в профиле «{ключ}» найден пустой синоним")
                форма = форма.strip().lower()
                прежняя = итог.get(форма)
                if прежняя is not None and прежняя != лемма:
                    raise ValueError(
                        f"слово «{форма}» одновременно обозначает "
                        f"«{прежняя}» и «{лемма}»"
                    )
                итог[форма] = лемма
    return итог


def переменные(настройки):
    итог = {}
    for ключ, описание in включённые(настройки):
        слова = описание.get("variables", [])
        if not isinstance(слова, list):
            raise ValueError(f"в профиле «{ключ}» повреждён список имён")
        for запись in слова:
            if not isinstance(запись, dict):
                raise ValueError(f"в профиле «{ключ}» найдена неверная запись имени")
            форма = запись.get("form")
            if not isinstance(форма, str) or not форма.strip():
                raise ValueError(f"в профиле «{ключ}» найдено имя без формы")
            форма = форма.strip().lower()
            неизменяемое = запись.get("indeclinable", False)
            одушевлённое = запись.get("animate", False)
            род = запись.get("gender")
            if not isinstance(неизменяемое, bool) or not isinstance(одушевлённое, bool):
                raise ValueError(f"для имени «{форма}» неверно заданы грамматические признаки")
            if not форма.isalpha() or not any("а" <= знак <= "я" or знак == "ё" for знак in форма):
                raise ValueError(f"имя профиля «{форма}» должно быть написано кириллицей")
            if not неизменяемое and род not in РОДЫ:
                raise ValueError(f"для имени «{форма}» не указан правильный род")
            if форма in итог:
                raise ValueError(f"имя «{форма}» повторяется в активных профилях")
            итог[форма] = {
                "род": род,
                "одушевлённое": одушевлённое,
                "неизменяемое": неизменяемое,
                "описание": str(запись.get("meaning", "")),
                "профиль": ключ,
            }
    return итог


def словарь(настройки):
    итог = []
    for ключ, описание in включённые(настройки):
        for запись in описание.get("variables", []):
            итог.append((
                запись["form"],
                запись.get("meaning", ""),
                описание.get("name", ключ),
            ))
    return sorted(итог, key=lambda запись: запись[0])
