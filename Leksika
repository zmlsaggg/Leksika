#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# POSIX sh (dash) разрешает только латинские имена функций, поэтому имена
# служебных функций и переменных здесь латиницей, а сообщения — по-русски.
native_core() {
    if [ -x "$ROOT/лексус-ядро" ]; then
        printf '%s\n' "$ROOT/лексус-ядро"
    elif [ -x "$ROOT/ядро/лексус-ядро" ]; then
        printf '%s\n' "$ROOT/ядро/лексус-ядро"
    elif [ -x "$ROOT/ядро/лексус-ядро.exe" ]; then
        printf '%s\n' "$ROOT/ядро/лексус-ядро.exe"
    fi
}

# Только явный выбор: не перезапускаем программу в Python после ошибки VM.
# Русское «нативно» — основное написание, --нативно оставлено для старых ярлыков.
if [ "${1-}" = "нативно" ] || [ "${1-}" = "--нативно" ]; then
    CORE=$(native_core)
    if [ -n "$CORE" ]; then
        exec "$CORE" "$@"
    fi
    printf '%s\n' 'Лексика: нативное ядро не найдено; соберите его: make -C ядро native' >&2
    exit 127
fi

export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

# Без Python подменять дела ядра не будем: «проверить» у ядра значит проверку
# UTF-8, а у полной версии — проверку грамматики. Поэтому вместо тихой
# подмены сообщаем, что именно доступно без Python и как это вызвать.
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "Лексика: не найден Python 3.8+. Для полной версии установите Python 3.8+ или запустите установщик." >&2
    CORE=$(native_core)
    if [ -n "$CORE" ]; then
        printf '%s\n' "Без Python работает собственное ядро: Leksika нативно самопроверка | версия | проверить файл | разобрать файл | склонять слово." >&2
    else
        printf '%s\n' "Нативное ядро не собрано; его можно собрать без Python: make -C ядро native" >&2
    fi
    exit 127
fi

if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    printf '%s\n' "Лексика: нужен Python версии 3.8 или новее." >&2
    exit 2
fi

exec python3 "$ROOT/лексус.lek" "$@"
