import os
import sys

import numpy as np

ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
КОРЕНЬ = os.path.dirname(ЗДЕСЬ)


def подключить():
    _путь = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_путь, encoding="utf-8") as файл:
        exec(compile(файл.read(), _путь, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _путь})
    sys.path.insert(0, КОРЕНЬ)


подключить()

from лексика import морфология, разум  # noqa: E402

СЛОВА = {
    "м": ["стол", "дом", "кот", "пёс", "брат", "город", "человек", "мастер",
          "учитель", "корабль", "словарь", "портфель", "мяч", "ключ", "врач",
          "нож", "плащ", "товарищ", "день", "олень", "склад", "счёт", "покупка",
          "мост", "поезд", "самолёт", "прибор", "принтер", "сторож", "инженер",
          "компьютер", "экран", "столб", "циркуль", "месяц", "огурец", "комар"],
    "ж": ["книга", "рука", "земля", "страна", "школа", "работа", "сумма",
          "цена", "покупка", "картина", "сестра", "мама", "зима", "вода",
          "тетрадь", "дверь", "ночь", "лошадь", "площадь", "радость", "новость",
          "мебель", "жизнь", "неделя", "деревня", "песня", "лестница", "улица",
          "стена", "скамья", "станция", "неделя", "мысль", "цель"],
    "с": ["окно", "письмо", "море", "поле", "слово", "дело", "время", "имя",
          "здание", "условие", "знание", "упражнение", "платье", "здоровье",
          "яблоко", "колесо", "золото", "молоко", "число", "место", "лицо",
          "племя", "семя", "название", "движение", "решение"],
}

СЛОГИ = ["ба", "во", "га", "до", "же", "зи", "ко", "лу", "ми", "но", "па",
         "ро", "су", "та", "ши", "щу", "ла", "не", "пр", "ст", "кр", "мл"]

ХВОСТЫ = ["", "ь", "а", "я", "о", "е"]


def выдумать(случайный):
    куски = [СЛОГИ[случайный.integers(0, len(СЛОГИ))] for _ in range(случайный.integers(2, 5))]
    основа = "".join(с if isinstance(с, str) else с for с in куски)
    return основа + ХВОСТЫ[случайный.integers(0, len(ХВОСТЫ))]


def собрать_данные():
    случайный = np.random.default_rng(7)
    леммы = []
    for род, слова in СЛОВА.items():
        for слово in слова:
            леммы.append((слово, род))
    for _ in range(600):
        слово = выдумать(случайный)
        род = "ж" if слово.endswith(("а", "я", "ь")) else ("с" if слово.endswith(("о", "е")) else "м")
        леммы.append((слово, род))

    примеры = []
    for слово, род in леммы:
        формы = морфология.склонять(слово, род)
        for форма, метки in формы.items():
            примеры.append((форма, метки, род))
    return примеры


def признаки_к_номерам(слово):
    return sorted({разум.номер(признак) for признак in разум.признаки(слово)})


def обучить_падежи(примеры, классы):
    место = {класс: i for i, класс in enumerate(классы)}
    строки, метки = [], []
    for форма, метки_формы, _ in примеры:
        номера = признаки_к_номерам(форма)
        if not номера:
            continue
        цель = np.zeros(len(классы))
        for падеж, число in метки_формы:
            класс = падеж + ":" + число
            if класс in место:
                цель[место[класс]] = 1.0
        if цель.sum() == 0:
            continue
        цель /= цель.sum()
        строки.append(номера)
        метки.append(цель)

    веса = np.zeros((разум.РАЗМЕР, len(классы)))
    перекос = np.zeros(len(классы))
    шаг = 0.25
    for эпоха in range(60):
        порядок = np.random.default_rng(эпоха).permutation(len(строки))
        потеря = 0.0
        for номер_строки in порядок:
            номера = строки[номер_строки]
            цель = метки[номер_строки]
            значения = перекос + веса[номера].sum(axis=0)
            значения -= значения.max()
            вероятности = np.exp(значения)
            вероятности /= вероятности.sum()
            потеря += -np.log(max(вероятности[цель > 0].max(), 1e-9))
            бег = (вероятности - цель) * шаг
            перекос -= бег
            веса[номера] -= бег * 0.5
    return веса, перекос, потеря / max(len(строки), 1)


def обучить_роды(примеры, роды):
    место = {род: i for i, род in enumerate(роды)}
    строки, метки = [], []
    for форма, _, род in примеры:
        if род not in место:
            continue
        номера = признаки_к_номерам(форма)
        if not номера:
            continue
        цель = np.zeros(len(роды))
        цель[место[род]] = 1.0
        строки.append(номера)
        метки.append(цель)

    веса = np.zeros((разум.РАЗМЕР, len(роды)))
    перекос = np.zeros(len(роды))
    шаг = 0.25
    for эпоха in range(40):
        порядок = np.random.default_rng(1000 + эпоха).permutation(len(строки))
        for номер_строки in порядок:
            номера = строки[номер_строки]
            цель = метки[номер_строки]
            значения = перекос + веса[номера].sum(axis=0)
            значения -= значения.max()
            вероятности = np.exp(значения)
            вероятности /= вероятности.sum()
            бег = (вероятности - цель) * шаг
            перекос -= бег
            веса[номера] -= бег * 0.5
    return веса, перекос


def проверить(примеры, веса, перекос, классы, доля=0.15):
    место = {класс: i for i, класс in enumerate(классы)}
    отсечка = int(len(примеры) * (1 - доля))
    проверочные = примеры[отсечка:]
    верно = 0
    всего = 0
    for форма, метки, _ in проверочные:
        номера = признаки_к_номерам(форма)
        значения = перекос + веса[номера].sum(axis=0)
        лучший = int(np.argmax(значения))
        класс = классы[лучший]
        всего += 1
        for падеж, число in метки:
            if падеж + ":" + число == класс:
                верно += 1
                break
    return верно / max(всего, 1)


def записать(веса, перекос, роды_веса, роды_перекос, классы, роды, путь):
    строки = ["разум 1", "признаков " + str(разум.РАЗМЕР),
              "классы " + " ".join(классы)]
    строки.append("перекос " + " ".join("%.3f" % значение for значение in перекос))
    for номер in range(веса.shape[0]):
        строка = веса[номер]
        if float(np.abs(строка).max()) < 0.02:
            continue
        строки.append("вес %d %s" % (номер, " ".join("%.3f" % значение for значение in строка)))
    строки.append("роды " + " ".join(роды))
    строки.append("род_перекос " + " ".join("%.3f" % значение for значение in роды_перекос))
    for номер in range(роды_веса.shape[0]):
        строка = роды_веса[номер]
        if float(np.abs(строка).max()) < 0.02:
            continue
        строки.append("род_вес %d %s" % (номер, " ".join("%.3f" % значение for значение in строка)))
    with open(путь, "w", encoding="utf-8") as файл:
        файл.write("\n".join(строки) + "\n")
    return путь


def main():
    классы = [падеж + ":" + число for падеж in морфология.ПАДЕЖИ for число in ("ед", "мн")]
    роды = ["м", "ж", "с"]
    print("сборка разума Лексики")
    примеры = собрать_данные()
    print("  примеров: %d" % len(примеры))

    веса, перекос, потеря = обучить_падежи(примеры, классы)
    точность = проверить(примеры, веса, перекос, классы)
    print("  падежи и число: потеря %.3f, точность %.3f" % (потеря, точность))

    роды_веса, роды_перекос = обучить_роды(примеры, роды)
    путь = os.path.join(КОРЕНЬ, "словари", разум.СВОИ_ВЕСА)
    os.makedirs(os.path.dirname(путь), exist_ok=True)
    записать(веса, перекос, роды_веса, роды_перекос, классы, роды, путь)
    print("  веса: %s, %.0f килобайт" % (путь, os.path.getsize(путь) / 1024))
    return 0


if __name__ == "__main__":
    sys.exit(main())
