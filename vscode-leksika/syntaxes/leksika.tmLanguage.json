{
  "name": "Лексика",
  "scopeName": "source.leksika",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#speech"
    },
    {
      "name": "entity.name.function.leksika",
      "match": "(?i)(?<=правило\\s)([А-Яа-яЁё][А-Яа-яЁё0-9-]*)"
    },
    {
      "name": "storage.type.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:вещественное|логическое|перечень|дробное|словарь|список|строка|дробь|целое|число)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "storage.modifier.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:поведение|принимает|принимают|процедура|процедуры|действие|действия|объявить|получает|завести|правила|правило|правилу|требует|функции|функция|заведи|объяви|пускай|умение|берет|берёт|пусть|ждет|ждёт)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "constant.language.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:истинный|неправда|истинно|пустота|истина|кривда|ложный|ничего|правда|пустое|верно|ложно|ничто|пусто|ложь|нет|да)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "keyword.control.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:импортировать|использовать|возвратить|завершение|импортируй|остановить|подключить|продолжить|пропустить|выполнять|запустить|исполнить|используй|повторить|повторять|возврати|выполняй|миновать|наоборот|наступит|останови|ответить|повторяй|подключи|прервать|привлеки|привлечь|продолжи|пропусти|бросить|вернуть|воздать|вызвать|запусти|исполни|каждого|каждому|каждыми|крутить|позвать|вызови|дальше|делать|дотоле|каждая|каждое|каждом|каждую|каждые|каждый|каждым|каждых|любого|любому|ответь|отдать|позови|покуда|почему|прерви|брось|верни|выйди|выйти|далее|делай|ежели|иначе|когда|конец|крути|любой|минуй|отдай|разов|разом|тогда|если|иное|коли|край|пока|раза|стоп|все|всё|где|для|как|раз|то)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "keyword.operator.word.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:заключает|превышает|равняется|включает|означает|остатком|содержат|содержит|больший|вмещает|меньший|остатка|остаток|степени|больше|меньше|плюсуй|более|менее|минус|равен|равна|равно|равны|либо|плюс|или|это|не|ни|и)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "support.function.builtin.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:векторноепроизведение|скалярноепроизведение|повернутьвектор|вычестьвекторы|загрузитьхолст|нормальвектора|сложитьвекторы|сохранитьхолст|умножитьвектор|прямоугольник|длинавектора|миллисекунды|треугольник|увеличивает|арктангенс|наибольшее|наименьшее|напечатать|перемешать|прибавляет|произнести|расстояние|спрашивать|вопросить|выбросить|дополнить|нарастить|округлить|поместить|прибавить|приложить|произнеси|прочитать|разделить|случайное|спрашивай|увеличить|уменьшает|уменьшить|вставить|вырезать|говорить|добавить|заменить|записать|наложить|отнимает|отыскать|перечень|печатать|поделить|показать|положить|прочитай|размером|спросить|умножает|умножить|вопроси|вписать|выбрать|выброси|выведет|вывести|вычесть|дополни|ключами|косинус|молвить|нарасти|остаток|отрезок|печатай|пиксель|положит|помести|посеять|прибавь|приложи|раздели|скажете|скажешь|скажите|сказала|сказали|сказало|сказать|словарь|смешать|срезать|степень|тангенс|увеличь|удалить|уменьши|ввести|вектор|возьми|вставь|выведи|вырежь|говори|длиной|добавь|жребий|залить|запиши|кладём|кладёт|класть|ключам|ключей|корень|модуль|отними|отнять|плавно|подели|покажи|положи|положу|предел|размер|скажем|скажет|скажут|сказал|спроси|строка|убрать|умножь|читать|брать|буквы|введи|взять|впиши|время|вычти|делит|длина|длину|кладу|ключи|мазок|молви|молча|отыщи|синус|скажи|скажу|срежь|убери|удали|холст|целое|число|читай|бери|доля|знак|круг|цвет|что|пи)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "constant.numeric.word.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:восемьюдесятью|восемнадцатью|девятнадцатью|четырнадцатью|шестьюдесятью|восемнадцати|восемнадцать|восьмидесяти|девятнадцати|девятнадцать|одиннадцатью|пятьюдесятью|семьюдесятью|четырнадцати|четырнадцать|шестнадцатью|восемьдесят|двенадцатью|одиннадцати|одиннадцать|пятнадцатью|семнадцатью|тринадцатью|шестидесяти|шестнадцати|шестнадцать|двенадцати|двенадцать|двумястами|миллиардов|пятидесяти|пятнадцати|пятнадцать|семидесяти|семнадцати|семнадцать|тринадцати|тринадцать|четырехсот|четырёхсот|шестьдесят|восемьсот|восьмисот|двадцатью|девяноста|девяносто|девятисот|девятьсот|миллиарда|миллионам|миллионов|миллионом|пятьдесят|семьдесят|тридцатью|четыреста|двадцати|двадцать|двумстам|миллиард|миллиона|миллионе|миллиону|миллионы|тридцати|тридцать|тысячами|четырьмя|шестисот|шестьсот|восемью|двухсот|девятью|десятью|запятая|запятой|запятую|миллион|пятисот|пятьсот|семисот|семьсот|трехсот|трёхсот|тысячам|тысячах|тысячей|четырем|четырех|четырём|четырёх|восемь|восьми|двести|девяти|девять|десяти|десять|одного|одному|сорока|триста|тысяча|тысячи|тысячу|четыре|шестью|двумя|нолём|нулем|нулём|одним|одной|одною|пятью|семью|сорок|тремя|тысяч|шести|шесть|двум|двух|ноле|ноль|нолю|ноля|нуле|нуль|нулю|нуля|один|одна|одно|одну|пяти|пять|семи|семь|трем|трех|трём|трёх|два|две|ста|сто|три)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "keyword.other.leksika",
      "match": "(?i)(?<![А-Яа-яЁё0-9_-])(?:ключу|номер|речь|до|из|на|от|по|в|к|с)(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "constant.numeric.leksika",
      "match": "(?<![А-Яа-яЁё0-9_-])\\d+(?:[.,]\\d+)?(?![А-Яа-яЁё0-9_-])"
    },
    {
      "name": "keyword.operator.symbol.leksika",
      "match": "\\+=|-=|\\*=|/=|\\+\\+|--|==|!=|>=|<=|&&|\\|\\||\\*\\*|[=+*/%<>-]"
    },
    {
      "name": "punctuation.separator.leksika",
      "match": "[.,;:!?]"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.leksika",
      "begin": "(?i)(?<![А-Яа-яЁё0-9_-])(?:комментарием|комментарий|примечание|пояснение|заметка|заметку)(?![А-Яа-яЁё0-9_-])",
      "end": "$"
    },
    "speech": {
      "name": "string.unquoted.speech.leksika",
      "begin": "(?i)(?<![А-Яа-яЁё0-9_-])(?:речь)(?![А-Яа-яЁё0-9_-])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.leksika"
        }
      },
      "end": "(?i)(?<![А-Яа-яЁё0-9_-])конец[ \\t]*речи(?![А-Яа-яЁё0-9_-])",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.leksika"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.leksika",
          "match": "\\(\\(|\\)\\)"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.leksika",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}
