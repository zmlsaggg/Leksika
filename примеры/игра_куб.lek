заметка Куб, который вращается. Трёхмерная сцена без внешних библиотек.
заметка Кадр считается в холсте и сохраняется в файл картинки рядом.

пусть ширина = 320.
пусть высота = 240.
пусть фокус = 300.
пусть отдаление = 4 запятая 5.
пусть картина = холст(ширина, высота).
залить(картина, цвет(12, 14, 22)).

пусть вершины = перечень().
добавить в вершины вектор(-1, -1, -1).
добавить в вершины вектор(1, -1, -1).
добавить в вершины вектор(1, 1, -1).
добавить в вершины вектор(-1, 1, -1).
добавить в вершины вектор(-1, -1, 1).
добавить в вершины вектор(1, -1, 1).
добавить в вершины вектор(1, 1, 1).
добавить в вершины вектор(-1, 1, 1).

пусть грани = перечень().
добавить в грани перечень(0, 1, 2, 3).
добавить в грани перечень(5, 4, 7, 6).
добавить в грани перечень(4, 0, 3, 7).
добавить в грани перечень(1, 5, 6, 2).
добавить в грани перечень(3, 2, 6, 7).
добавить в грани перечень(4, 5, 1, 0).

пусть оттенки = перечень().
добавить в оттенки цвет(74, 144, 226).
добавить в оттенки цвет(242, 153, 74).
добавить в оттенки цвет(126, 200, 122).
добавить в оттенки цвет(219, 112, 147).
добавить в оттенки цвет(178, 148, 223).
добавить в оттенки цвет(226, 214, 108).

пусть уровни = перечень(1, 0 запятая 82, 0 запятая 66, 0 запятая 9, 0 запятая 74, 0 запятая 58).

пусть угол = 0 запятая 6.

правило повернутьточку(точка) {
    пусть вокруг = повернутьвектор(точка, вектор(0, 1, 0), угол).
    вернуть(повернутьвектор(вокруг, вектор(1, 0, 0), угол / 2)).
}

правило наэкран(точка) {
    пусть поиксу = взять из перечня точка номер 0.
    пусть поигреку = взять из перечня точка номер 1.
    пусть поглубине = взять из перечня точка номер 2.
    пусть экраникс = ширина / 2 + фокус * поиксу / (поглубине + отдаление).
    пусть экранигрек = высота / 2 - фокус * поигреку / (поглубине + отдаление).
    вернуть(вектор(экраникс, экранигрек, поглубине + отдаление)).
}

правило точкуэкрана(клетка) {
    пусть место = взять из перечня вершины номер клетка.
    вернуть(наэкран(повернутьточку(место))).
}

правило нарисоватьгрань(список, цветграни, яркость) {
    пусть первая = точкуэкрана(взять из перечня список номер 0).
    пусть вторая = точкуэкрана(взять из перечня список номер 1).
    пусть третья = точкуэкрана(взять из перечня список номер 2).
    пусть четвертая = точкуэкрана(взять из перечня список номер 3).
    треугольник(картина, первая, вторая, третья, цветграни, яркость).
    треугольник(картина, первая, третья, четвертая, цветграни, яркость).
}

пусть номерграни = 0.
для каждого грани из граней {
    пусть оттенок = взять из перечня оттенки номер номерграни.
    пусть яркость = взять из перечня уровни номер номерграни.
    нарисоватьгрань(грани, оттенок, яркость).
    номерграни = номерграни + 1.
}

сохранитьхолст(картина, речь игра_куб.png конец речи).
сказать(речь Кадр куба сохранён конец речи).
сказать(пиксель(картина, 160, 120)).
