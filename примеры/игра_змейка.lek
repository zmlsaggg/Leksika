заметка Змейка на карте, столкновения, поиск пути и кадр в файл картинки.
заметка Игровая логика, правила из словаря игры, рисование, встроенный холст.

подключить игры.

пусть ширинакарты = 12.
пусть высотакарты = 12.
пусть клетка = 24.
пусть картина = холст(ширинакарты * клетка, высотакарты * клетка).
залить(картина, цвет(18, 22, 30)).

заметка Собираем карту, стена это единица, пол это ноль.
пусть карта = перечень().
пусть всего = ширинакарты * высотакарты.
пусть номер = 0.
пока (номер меньше всего) {
    пусть клеткаикс = остаток(номер, ширинакарты).
    пусть клеткаигрек = целое(номер / ширинакарты).
    пусть камень = 0.
    если (клеткаикс равно 5 и клеткаигрек меньше 8) {
        камень = 1.
    }
    если (клеткаигрек равно 9 и клеткаикс больше 2) {
        камень = 1.
    }
    добавить в карта камень.
    номер = номер + 1.
}

заметка Тело змейки и еда, номера клеток считаются слева направо и сверху вниз.
пусть тело = перечень(0, 1, 2).
пусть голова = 2.
пусть еда = 23.
пусть счёт = 0.

правило столкновение(место) {
    заметка Стена или собственный хвост, обе причины завершают забег.
    если (не проходимо(карта, ширинакарты, высотакарты, место, 1)) {
        вернуть(истина).
    }
    вернуть(тело содержит место).
}

пусть ход = 0.
пока (ход меньше 40) {
    пусть дорога = путьпокарте(карта, ширинакарты, высотакарты, голова, еда, 1).
    если (длина дорога меньше двух) {
        прервать.
    }
    пусть следующий = взять из перечня дорога номер 1.
    если (столкновение(следующий)) {
        прервать.
    }
    добавить в тело следующий.
    голова = следующий.
    если (голова равно еда) {
        счёт = счёт + 1.
        заметка Еда переезжает в дальний свободный угол, чтобы забег не кончался сразу.
        еда = всего - 1 - счёт.
    } иначе {
        убрать из перечня тело номер 0.
    }
    ход = ход + 1.
}

заметка Рисуем стены, еду и змейку.
пусть место = 0.
пока (место меньше всего) {
    пусть угол = вэкран(место, ширинакарты, клетка).
    пусть экраникс = взять из перечня угол номер 0.
    пусть экранигрек = взять из перечня угол номер 1.
    пусть значение = взять из перечня карта номер место.
    если (значение равно 1) {
        прямоугольник(картина, экраникс, экранигрек, клетка, клетка, цвет(44, 52, 70)).
    }
    место = место + 1.
}

пусть едаугол = вэкран(еда, ширинакарты, клетка).
пусть едаикс = (взять из перечня едаугол номер 0) + клетка / 2.
пусть едаигрек = (взять из перечня едаугол номер 1) + клетка / 2.
круг(картина, едаикс, едаигрек, клетка / 3, цвет(238, 92, 92)).

для каждого части из тела {
    пусть частьугол = вэкран(части, ширинакарты, клетка).
    пусть частикс = (взять из перечня частьугол номер 0) + 2.
    пусть частигрек = (взять из перечня частьугол номер 1) + 2.
    прямоугольник(картина, частикс, частигрек, клетка - 4, клетка - 4, цвет(110, 220, 140)).
}

сохранитьхолст(картина, речь игра_змейка.png конец речи).
сказать(речь Счёт змейки конец речи).
сказать(счёт).
сказать(длина тела).
