заметка Спрайты и плитки, набор рисуется кодом, сохраняется, читается обратно и собирается в сцену.
заметка Так игра получает картинки из файла, режет их на куски и ставит поверх кадра.

подключить игры.

пусть клетка = 16.
пусть трава = цвет(86, 150, 74).
пусть дерево = цвет(34, 92, 52).
пусть вода = цвет(46, 96, 168).
пусть камень = цвет(120, 124, 132).

правило отметка(куда, сдвиг, порода) {
    заметка Мелкие штрихи, чтобы плитки отличались не только цветом.
    если (порода равно 0) {
        мазок(куда, сдвиг + 3, 4, цвет(120, 190, 96)).
        мазок(куда, сдвиг + 9, 11, цвет(120, 190, 96)).
    }
    если (порода равно 1) {
        прямоугольник(куда, сдвиг + 6, 5, 4, 11, цвет(70, 48, 30)).
        прямоугольник(куда, сдвиг + 4, 2, 8, 6, цвет(44, 112, 62)).
    }
    если (порода равно 2) {
        отрезок(куда, сдвиг + 2, 5, сдвиг + 12, 5, цвет(96, 150, 210)).
        отрезок(куда, сдвиг + 4, 11, сдвиг + 13, 11, цвет(96, 150, 210)).
    }
    если (порода равно 3) {
        мазок(куда, сдвиг + 4, 4, цвет(160, 164, 172)).
        мазок(куда, сдвиг + 11, 9, цвет(96, 100, 108)).
    }
}

заметка Набор из четырёх плиток в один ряд, трава, дерево, вода и камень.
пусть набор = холст(клетка * 4, клетка).
пусть номер = 0.
пока (номер меньше 4) {
    пусть краска = трава.
    если (номер равно 1) {
        краска = дерево.
    }
    если (номер равно 2) {
        краска = вода.
    }
    если (номер равно 3) {
        краска = камень.
    }
    пусть сдвиг = номер * клетка.
    прямоугольник(набор, сдвиг, 0, клетка, клетка, краска).
    отметка(набор, сдвиг, номер).
    номер = номер + 1.
}

сохранитьхолст(набор, речь игра_спрайты_плитки.png конец речи).
пусть лист = загрузитьхолст(речь игра_спрайты_плитки.png конец речи).

заметка Нарезаем загруженный лист на отдельные плитки.
пусть плитки = перечень().
пусть кусок = 0.
пока (кусок меньше 4) {
    добавить в плитки вырезать(лист, кусок * клетка, 0, клетка, клетка).
    кусок = кусок + 1.
}

заметка Карта, вода в правом верхнем углу, деревья вразброс, камень внизу.
пусть ширинакарты = 12.
пусть высотакарты = 8.
пусть карта = перечень().
пусть место = 0.
пока (место меньше ширинакарты * высотакарты) {
    пусть клеткаикс = остаток(место, ширинакарты).
    пусть клеткаигрек = целое(место / ширинакарты).
    пусть породы = 0.
    если (клеткаикс больше 8 и клеткаигрек меньше 4) {
        породы = 2.
    }
    если (остаток(клеткаикс + клеткаигрек * 2, 5) равно 2) {
        породы = 1.
    }
    если (клеткаигрек равно 7) {
        породы = 3.
    }
    добавить в карта породы.
    место = место + 1.
}
заменить(карта, 33, 1).

заметка Герой нарисован на розовом фоне, который при наложении станет прозрачным.
пусть герой = холст(10, 12).
залить(герой, цвет(255, 0, 255)).
прямоугольник(герой, 2, 2, 6, 5, цвет(232, 208, 168)).
прямоугольник(герой, 1, 7, 8, 4, цвет(64, 104, 208)).
мазок(герой, 4, 4, цвет(30, 30, 30)).
мазок(герой, 6, 4, цвет(30, 30, 30)).

пусть сцена = холст(ширинакарты * клетка, высотакарты * клетка).
пусть позиция = 0.
пока (позиция меньше длина карта) {
    пусть пара = вэкран(позиция, ширинакарты, клетка).
    пусть видплитки = взять из перечня карта номер позиция.
    пусть сдвигикс = взять из перечня пара номер 0.
    пусть сдвигигрек = взять из перечня пара номер 1.
    наложить(сцена, взять из перечня плитки номер видплитки, сдвигикс, сдвигигрек).
    позиция = позиция + 1.
}

наложить(сцена, герой, 5 * клетка + 3, 4 * клетка - 4, цвет(255, 0, 255)).
круг(сцена, 5 * клетка + 8, 4 * клетка - 10, 3, цвет(255, 230, 140)).

сохранитьхолст(сцена, речь игра_спрайты.png конец речи).
сказать(речь Ширина сцены конец речи).
сказать(прочитать из сцена по ключу ширина).
сказать(пиксель(сцена, 0, 0)).
сказать(пиксель(сцена, 5 * клетка + 4, 4 * клетка + 2)).
