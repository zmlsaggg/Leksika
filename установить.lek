#!/usr/bin/env python3

import argparse
import os
import shutil
import shlex
import stat
import subprocess
import sys

ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
ДОМ = os.path.expanduser("~")
ПО_УМОЛЧАНИЮ_ПАПКА = os.path.join(ДОМ, ".лексус")
ПО_УМОЛЧАНИЮ_КУДА = os.path.join(ДОМ, ".local", "bin")

ЧТО_СТАВИМ = ["лексус.lek", "Leksika", "лексика", "примеры", "словари", "документы",
              "значки", "ядро", "данные/словарь", "читай.lek"]

# Обёртка передаёт аргументы общему запускателю; нативный режим не требует Python.
ЯРЛЫК = "#!/bin/sh\nexec {запускатель} \"$@\"\n"


def проверить_питон():
    if sys.version_info < (3, 8):
        print("нужен python3 версии 3.8 или новее", file=sys.stderr)
        raise SystemExit(2)


ЗНАЧОК = """[Desktop Entry]
Type=Application
Name=Лексика
Name[ru]=Лексика
GenericName=Язык программирования Лексика
Comment=Русский язык программирования, движок Лексус
Exec={ярлык} %U
Icon={значок}
Terminal=true
Categories=Development;IDE;Education;
Keywords=лексика;лексус;лек;язык программирования;russian;lek;
"""


def поставить_значок(папка, ярлык):
    картинка = os.path.join(папка, "значки", "знак.png")
    if not os.path.isfile(картинка):
        return
    дом = os.path.expanduser("~")
    меню = os.path.join(дом, ".local", "share", "applications")
    try:
        os.makedirs(меню, exist_ok=True)
        with open(os.path.join(меню, "лексика.desktop"), "w", encoding="utf-8") as файл:
            файл.write(ЗНАЧОК.format(ярлык=ярлык, значок=картинка))
        print("значок поставлен в меню приложений")
    except OSError:
        pass


def поставить(папка, куда, ярлык=True):
    проверить_питон()
    папка = os.path.abspath(os.path.expanduser(папка))
    куда = os.path.abspath(os.path.expanduser(куда))

    уже_на_месте = os.path.abspath(ЗДЕСЬ) == папка
    if not уже_на_месте:
        os.makedirs(папка, exist_ok=True)
        for имя in ЧТО_СТАВИМ:
            источник = os.path.join(ЗДЕСЬ, имя)
            if not os.path.exists(источник):
                continue
            цель = os.path.join(папка, имя)
            os.makedirs(os.path.dirname(цель), exist_ok=True)
            if os.path.isdir(цель):
                shutil.rmtree(цель)
            elif os.path.isfile(цель):
                os.remove(цель)
            if os.path.isdir(источник):
                shutil.copytree(источник, цель,
                                ignore=shutil.ignore_patterns("__pycache__"))
            else:
                shutil.copy2(источник, цель)
        print(f"лексус разложен в {папка}")
    else:
        print(f"лексус уже на месте: {папка}")

    os.makedirs(os.path.join(папка, "библиотека"), exist_ok=True)

    # Необязательный нативный слой: собирается только если C-компилятор уже есть.
    # Основной интерпретатор пока остаётся Python — установка от компилятора не зависит.
    исходник_ядра = os.path.join(папка, "ядро", "лексус.c")
    компилятор = shutil.which("cc") or shutil.which("clang") or shutil.which("gcc")
    if компилятор and os.path.isfile(исходник_ядра):
        нативный = os.path.join(папка, "лексус-ядро")
        сборка = subprocess.run(
            [компилятор, "-std=c11", "-O2", "-Wall", "-Wextra",
             "-o", нативный] + [os.path.join(папка, "ядро", имя) for имя in
                              ("лексус.c", "значения.c", "словарь_индекс.c",
                               "байткод.c", "машина.c", "компилятор.c")],
            capture_output=True, text=True,
        )
        if сборка.returncode == 0:
            os.chmod(нативный, 0o755)
            print("нативная часть Лексуса собрана: " + нативный)
        else:
            print("нативная часть не собрана; Python-режим сохранён")

    if ярлык:
        os.makedirs(куда, exist_ok=True)
        путь_ярлыка = os.path.join(куда, "Leksika")
        содержимое_ярлыка = ЯРЛЫК.format(запускатель=shlex.quote(os.path.join(папка, "Leksika")))
        имена = ("leksika", "лексика", "лексус", "лек", "лекс", "лексу", "leksus", "lek", "leks")
        for имя_команды in sorted({форма for имя in имена for форма in (имя, имя.capitalize(), имя.upper())}):
            путь = os.path.join(куда, имя_команды)
            with open(путь, "w", encoding="utf-8") as файл:
                файл.write(содержимое_ярлыка)
            режим = os.stat(путь).st_mode
            os.chmod(путь, режим | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        print(f"команда Leksika установлена: {путь_ярлыка}")
        print("старое имя «лексус» оставлено как совместимый псевдоним")

        поставить_значок(папка, путь_ярлыка)

        if куда not in os.environ.get("PATH", "").split(os.pathsep):
            print()
            print("добавьте в свою оболочку одну строку:")
            print(f'  export PATH="{куда}:$PATH"')
            print()

    пробный = os.path.join(папка, "примеры", "привет.lek")
    if os.path.isfile(пробный):
        try:
            итог = subprocess.run(
                [sys.executable, os.path.join(папка, "лексус.lek"), "проверить", пробный],
                capture_output=True, text=True, timeout=60,
            )
            if итог.returncode == 0:
                print("проверка пройдена: " + итог.stdout.strip())
            else:
                print("проверка не прошла:", file=sys.stderr)
                print(итог.stderr.strip(), file=sys.stderr)
        except OSError as ошибка:
            print(f"проверку сделать не удалось: {ошибка}")

    print()
    print("готово. Начните так:")
    print("  Leksika запустить примеры/привет.lek")
    print("  Leksika справка")


def снести(папка, куда):
    for имя_команды in ("Leksika", "leksika", "Лексика", "ЛЕКСИКА", "лексика", "лексус", "Лексус", "ЛЕКСУС", "лек", "лекс", "лексу", "leksus", "lek", "leks"):
        ярлык = os.path.join(куда, имя_команды)
        if os.path.isfile(ярлык):
            os.remove(ярлык)
            print(f"команда снята: {ярлык}")
    if os.path.isdir(папка):
        shutil.rmtree(папка)
        print(f"папка движка удалена: {папка}")


def main():
    разборщик = argparse.ArgumentParser(prog="установить", add_help=True)
    разборщик.add_argument("--папка", default=ПО_УМОЛЧАНИЮ_ПАПКА)
    разборщик.add_argument("--куда", default=ПО_УМОЛЧАНИЮ_КУДА)
    разборщик.add_argument("--без-ярлыка", action="store_true")
    разборщик.add_argument("--снести", action="store_true")
    аргументы = разборщик.parse_args()
    if аргументы.снести:
        снести(os.path.expanduser(аргументы.папка), os.path.expanduser(аргументы.куда))
    else:
        поставить(аргументы.папка, аргументы.куда, not аргументы.без_ярлыка)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
