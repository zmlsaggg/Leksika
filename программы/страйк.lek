заметка Strike: разрушайте пронумерованные блоки. За новый уровень добавляется индексшара.
пусть ракетка = 130;
пусть уровень = 1;
пусть счёт = 0;
пусть шары = 1;
пусть блоки = [];
пусть иксы = [160, 160, 160];
пусть игреки = [230, 230, 230];
пусть дх = [3, -3, 2];
пусть ду = [-4, -4, -4];
правило новыекирпичи() {
    блоки = [];
    повторить 18 раз { блоки = блоки + [уровень]; }
}
правило рисовать() {
    очистить();
    пусть номер = 0;
    пока (номер < 18) {
        пусть прочность = взять(блоки, номер);
        если (прочность > 0) {
            пусть хблока = 7 + (номер % 6) * 51;
            пусть ублока = 35 + целое(номер / 6) * 27;
            пусть цвет = 4 + (прочность % 4);
            прямоугольник(хблока, ублока, 47, 22, цвет);
            надпись(строка(прочность), хблока + 19, ублока + 16, 3);
        }
        номер++;
    }
    прямоугольник(ракетка, 300, 60, 8, 3);
    номер = 0;
    пока (номер < шары) { круг(взять(иксы, номер), взять(игреки, номер), 5, 3); номер++; }
    показатьсчёт(счёт);
    надпись(речь Уровень (уровень) · Шары (шары) конец речи, 8, 18, 3);
}
правило начать() { новыекирпичи(); рисовать(); }
правило управление(кнопка) {
    если (кнопка == 1) { ракетка -= 24; если (ракетка < 0) { ракетка = 0; } }
    если (кнопка == 2) { ракетка += 24; если (ракетка > 260) { ракетка = 260; } }
    рисовать();
}
правило шаг() {
    пусть индексшара = 0;
    пока (индексшара < шары) {
        пусть х = взять(иксы, индексшара) + взять(дх, индексшара);
        пусть у = взять(игреки, индексшара) + взять(ду, индексшара);
        пусть скоростьх = взять(дх, индексшара);
        пусть скоростьу = взять(ду, индексшара);
        если (х <= 5) { х = 5; скоростьх = модуль(скоростьх); }
        если (х >= 315) { х = 315; скоростьх = -модуль(скоростьх); }
        если (у <= 5) { у = 5; скоростьу = модуль(скоростьу); }
        если (скоростьу > 0 и у >= 295 и у <= 308 и х >= ракетка и х <= ракетка + 60) { у = 295; скоростьу = -модуль(скоростьу); }
        если (у > 325) { завершить(счёт, ложь); вернуть; }
        если (у >= 35 и у < 116 и х >= 7 и х < 313) {
            пусть столбец = целое((х - 7) / 51);
            пусть строчка = целое((у - 35) / 27);
            пусть номер = строчка * 6 + столбец;
            если (номер >= 0 и номер < 18 и (х - 7) % 51 < 47 и (у - 35) % 27 < 22) {
                пусть прочность = взять(блоки, номер);
                если (прочность > 0) { заменить(блоки, номер, прочность - 1); скоростьу = -скоростьу; счёт++; }
            }
        }
        заменить(иксы, индексшара, х); заменить(игреки, индексшара, у);
        заменить(дх, индексшара, скоростьх); заменить(ду, индексшара, скоростьу);
        индексшара++;
    }
    пусть оставшиеся = 0;
    для каждого прочность из блоки { оставшиеся += прочность; }
    если (оставшиеся == 0) {
        уровень++;
        если (шары < 3) { шары++; }
        новыекирпичи();
        иксы = [160, 160, 160]; игреки = [230, 230, 230]; ду = [-4, -4, -4];
    }
    рисовать();
}
