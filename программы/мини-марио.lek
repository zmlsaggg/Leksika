заметка Самостоятельный мини платформер без оригинальных ресурсов Марио.
пусть игрок = 30;
пусть высота = 0;
пусть скорость = 0;
пусть движение = 0;
пусть очки = 0;
пусть монеты = [130, 260, 390, 520, 650];
пусть препятствия = [190, 345, 490, 605];
правило рисовать() {
    очистить();
    пусть камера = игрок - 60;
    если (камера < 0) { камера = 0; }
    прямоугольник(0, 270, 320, 50, 7);
    для каждого преграда из препятствия { прямоугольник(преграда - камера, 246, 24, 24, 6); }
    для каждого жетон из монеты { круг(жетон - камера, 235, 6, 13); }
    прямоугольник(760 - камера, 180, 4, 90, 3);
    прямоугольник(764 - камера, 180, 25, 15, 2);
    прямоугольник(игрок - камера, 244 - высота, 20, 26, 2);
    квадрат(игрок - камера + 12, 248 - высота, 4, 13);
    показатьсчёт(очки);
}
правило начать() { рисовать(); }
правило управление(кнопка) {
    если (кнопка == 1) { движение = -4; }
    если (кнопка == 2) { движение = 4; }
    если ((кнопка == 3 или кнопка == 7) и высота == 0) { скорость = 14; }
}
правило шаг() {
    игрок = игрок + движение;
    если (игрок < 0) { игрок = 0; }
    высота = высота + скорость;
    скорость = скорость - 1;
    если (высота <= 0) { высота = 0; скорость = 0; }
    для каждого преграда из препятствия {
        если (игрок + 20 > преграда и игрок < преграда + 24 и высота < 24) { завершить(очки, ложь); вернуть; }
    }
    пусть оставшиеся = [];
    для каждого жетон из монеты {
        если (игрок + 20 >= жетон и игрок <= жетон и высота < 50) { очки++; } иначе { оставшиеся = оставшиеся + [жетон]; }
    }
    монеты = оставшиеся;
    если (игрок >= 760) { завершить(очки, истина); вернуть; }
    рисовать();
}
