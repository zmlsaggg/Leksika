заметка Арифметическая игра: один правильный ответ — одно очко.
пусть счёт = 0;
пусть первое = 0;
пусть второе = 0;
правило новыйпример() {
    первое = случайное(1, 20);
    второе = случайное(1, 20);
    задание(первое, второе);
}
правило начать() { показатьсчёт(счёт); новыйпример(); }
правило ответ(числоответа) {
    если (числоответа == первое + второе) {
        счёт++;
        показатьсчёт(счёт);
        новыйпример();
    } иначе { завершить(счёт, ложь); }
}
