заметка Бесконечный бег: состояние и столкновения работают на Лексике.
пусть высота = 0;
пусть скорость = 0;
пусть кактус = 320;
пусть очки = 0;
пусть темп = 6;
правило рисовать() {
    очистить();
    прямоугольник(0, 270, 320, 3, 7);
    прямоугольник(45, 240 - высота, 22, 30, 1);
    прямоугольник(57, 234 - высота, 15, 12, 1);
    квадрат(66, 237 - высота, 3, 8);
    прямоугольник(кактус, 246, 16, 24, 2);
    прямоугольник(кактус - 4, 250, 24, 5, 2);
    показатьсчёт(очки);
}
правило начать() { рисовать(); }
правило управление(кнопка) {
    если ((кнопка == 3 или кнопка == 7) и высота == 0) { скорость = 15; }
}
правило шаг() {
    высота = высота + скорость;
    скорость = скорость - 1;
    если (высота <= 0) { высота = 0; скорость = 0; }
    кактус = кактус - темп;
    если (кактус < -20) { кактус = 320 + случайное(0, 50); очки++; если (очки % 5 == 0 и темп < 11) { темп++; } }
    если (кактус < 67 и кактус + 16 > 45 и высота < 24) { завершить(очки, ложь); вернуть; }
    рисовать();
}
