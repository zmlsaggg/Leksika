заметка Пинг-понг: состояние и правила игры написаны на Лексике.
пусть ракетка = 130;
пусть х = 160;
пусть у = 130;
пусть скоростьх = 3;
пусть скоростьу = 3;
пусть счёт = 0;
правило рисовать() {
    очистить();
    прямоугольник(ракетка, 300, 60, 8, 3);
    круг(х, у, 7, 3);
    показатьсчёт(счёт);
}
правило начать() { рисовать(); }
правило управление(кнопка) {
    если (кнопка == 1) { ракетка -= 24; если (ракетка < 0) { ракетка = 0; } }
    если (кнопка == 2) { ракетка += 24; если (ракетка > 260) { ракетка = 260; } }
    рисовать();
}
правило шаг() {
    х += скоростьх; у += скоростьу;
    если (х <= 7 или х >= 313) { скоростьх = -скоростьх; }
    если (у <= 7) { скоростьу = модуль(скоростьу); }
    если (скоростьу > 0 и у >= 293 и у <= 308 и х >= ракетка и х <= ракетка + 60) {
        скоростьу = -модуль(скоростьу); счёт++;
    }
    если (у > 327) { завершить(счёт, ложь); вернуть; }
    рисовать();
}
