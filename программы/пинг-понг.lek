заметка Пинг-понг для двух игроков за одним устройством. Игра до пяти очков.
пусть нижняя = 130;
пусть верхняя = 130;
пусть х = 160;
пусть у = 160;
пусть скоростьх = 3;
пусть скоростьу = 4;
пусть первый = 0;
пусть второй = 0;
правило рисовать() {
    очистить();
    прямоугольник(нижняя, 300, 60, 8, 3);
    прямоугольник(верхняя, 12, 60, 8, 1);
    круг(х, у, 7, 3);
    табло(первый, второй);
}
правило начать() { рисовать(); }
правило управление(кнопка) {
    если (кнопка == 1) { нижняя -= 18; если (нижняя < 0) { нижняя = 0; } }
    если (кнопка == 2) { нижняя += 18; если (нижняя > 260) { нижняя = 260; } }
    если (кнопка == 5) { верхняя -= 18; если (верхняя < 0) { верхняя = 0; } }
    если (кнопка == 6) { верхняя += 18; если (верхняя > 260) { верхняя = 260; } }
    рисовать();
}
правило новаяподача(куда) { х = 160; у = 160; скоростьх = 3; скоростьу = 4 * куда; }
правило шаг() {
    х += скоростьх; у += скоростьу;
    если (х <= 7) { х = 7; скоростьх = модуль(скоростьх); }
    если (х >= 313) { х = 313; скоростьх = -модуль(скоростьх); }
    если (скоростьу > 0 и у >= 293 и у <= 307 и х >= нижняя и х <= нижняя + 60) { у = 293; скоростьу = -модуль(скоростьу); }
    если (скоростьу < 0 и у <= 27 и у >= 13 и х >= верхняя и х <= верхняя + 60) { у = 27; скоростьу = модуль(скоростьу); }
    если (у > 327) { второй++; новаяподача(1); }
    если (у < -7) { первый++; новаяподача(-1); }
    рисовать();
    если (первый >= 5 или второй >= 5) { конецматча(первый, второй); }
}
