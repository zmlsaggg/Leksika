заметка Змейка: игровая логика выполняется учебной машиной Лексики.
пусть тело = [136, 135, 134];
пусть направление = 1;
пусть следующее = 1;
пусть еда = 0;
пусть счёт = 0;
пусть окончено = ложь;

правило новаяеда() {
    если (длина(тело) == 256) { окончено = истина; завершить(счёт, истина); вернуть; }
    пусть свободные = [];
    пусть клетка = 0;
    пока (клетка < 256) {
        если (не (тело содержит клетка)) { свободные = свободные + [клетка]; }
        клетка++;
    }
    еда = взять(свободные, случайное(0, длина(свободные) - 1));
}
правило рисовать() {
    очистить();
    для каждого клетка из тело { квадрат((клетка % 16) * 20 + 1, целое(клетка / 16) * 20 + 1, 18, 1); }
    квадрат((еда % 16) * 20 + 2, целое(еда / 16) * 20 + 2, 16, 2);
    показатьсчёт(счёт);
}
правило начать() { новаяеда(); рисовать(); }
правило управление(кнопка) {
    если (кнопка == 1 и направление != 1) { следующее = -1; }
    если (кнопка == 2 и направление != -1) { следующее = 1; }
    если (кнопка == 3 и направление != 16) { следующее = -16; }
    если (кнопка == 4 и направление != -16) { следующее = 16; }
}
правило шаг() {
    направление = следующее;
    пусть голова = взять(тело, 0);
    пусть х = голова % 16;
    пусть у = целое(голова / 16);
    если ((направление == -1 и х == 0) или (направление == 1 и х == 15) или (направление == -16 и у == 0) или (направление == 16 и у == 15)) {
        окончено = истина; завершить(счёт, ложь); вернуть;
    }
    пусть новая = голова + направление;
    пусть съедено = новая == еда;
    пусть предел = длина(тело);
    если (не съедено) { предел--; }
    пусть индекс = 0;
    пока (индекс < предел) {
        если (взять(тело, индекс) == новая) { окончено = истина; завершить(счёт, ложь); вернуть; }
        индекс++;
    }
    пусть новое = [новая];
    индекс = 0;
    пока (индекс < предел) { новое = новое + [взять(тело, индекс)]; индекс++; }
    тело = новое;
    если (съедено) { счёт++; новаяеда(); }
    если (не окончено) { рисовать(); }
}
