#!/usr/bin/env python3

import io
import json
import os
import runpy
import shutil
import sys
import tempfile

ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
КОРЕНЬ = os.path.dirname(ЗДЕСЬ)
sys.path.insert(0, КОРЕНЬ)

if not getattr(sys, "_лексика_загрузка", False):
    _загрузка = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_загрузка, encoding="utf-8") as _файл:
        exec(compile(_файл.read(), _загрузка, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _загрузка})



from лексика import (байткод, грамматика, доводы, загрузка, исполнитель,  # noqa: E402
                     лексер, машина, модель, морфология, патчи, разум,
                     упаковка, файлы, форматы, хранение, профили)
from лексика.ошибки import ОшибкаЛексики, ОшибкаГрамматики, ОшибкаСмысла

ПРОЙДЕНО = 0
ПРОВАЛЕНО = 0


def проверить(название, условие, подробности=""):
    global ПРОЙДЕНО, ПРОВАЛЕНО
    if условие:
        ПРОЙДЕНО += 1
        print(f"  верно   {название}")
    else:
        ПРОВАЛЕНО += 1
        print(f"  ОШИБКА  {название} {подробности}")


def исполнить(код, вход=""):
    строки = []
    очередь = list(вход.split("\n")) if вход else []

    def ввод(_подсказка=""):
        if not очередь:
            raise EOFError()
        return очередь.pop(0)

    дерево = грамматика.разобрать(код)
    и = исполнитель.Исполнитель(вывод=строки.append, ввод=ввод)
    и.исполнить(дерево)
    return строки


def ждём_ошибку(код, вид):
    try:
        исполнить(код)
    except вид as ошибка:
        return True, str(ошибка)
    except Exception as ошибка:
        return False, f"не та ошибка: {type(ошибка).__name__}: {ошибка}"
    return False, "ошибки не было"



def проверки_письма():
    print("Письмо")
    токены = лексер.разобрать_текст("сказать речь Привет, мир! конец речи.")
    проверить("слово узнаётся", токены[0].вид == "слово" and токены[0].лемма == "сказать")
    проверить("речь собирается целиком",
              any(т.вид == "речь" and "Привет" in т.текст for т in токены))

    for знак in ('"', "[", "]", "{", "}", ":", ";", "_", "@", "#", "/", "<", ">"):
        try:
            лексер.разобрать_текст(f"сказать {знак}.")
            проверить(f"знак {знак} запрещён", False)
        except ОшибкаЛексики:
            проверить(f"знак {знак} запрещён", True)

    try:
        лексер.разобрать_текст("пусть имя равно hello.")
        проверить("латиница запрещена", False)
    except ОшибкаЛексики:
        проверить("латиница запрещена", True)

    проверить("точка и запятая разрешены",
              len(лексер.разобрать_текст("сказать раз, два, три.")) > 3)


def проверки_морфологии():
    print("Морфология")
    формы = морфология.склонять("сумма")
    проверить("сумму узнаём как винительный", ("вн", "ед") in формы.get("сумму", []))
    проверить("суммой узнаём как творительный", ("тв", "ед") in формы.get("суммой", []))
    формы = морфология.склонять("счётчик")
    проверить("счётчику — дательный", ("дт", "ед") in формы.get("счётчику", []))
    формы = морфология.склонять("покупки")
    проверить("покупок — родительный множественного",
              ("рд", "мн") in формы.get("покупок", []))
    формы = морфология.склонять("перечень")
    проверить("перечня — родительный (беглая гласная)",
              ("рд", "ед") in формы.get("перечня", []))

    проверить("двадцать пять", морфология.числительное(["двадцать", "пять"]) == 25)
    проверить("сто двадцать три",
              морфология.числительное(["сто", "двадцать", "три"]) == 123)
    проверить("две тысячи пятьсот",
              морфология.числительное(["две", "тысячи", "пятьсот"]) == 2500)
    проверить("прописью 42", морфология.прописью(42) == "сорок два")


def проверки_падежей():
    print("Падежное управление")
    строки = исполнить("пусть сумма равно пяти.\n"
                       "положить десять в сумму.\n"
                       "сказать сумму.\n"
                       "прибавить два к сумме.\n"
                       "сказать сумму.")
    проверить("положить в сумму", строки == ["10", "12"], строки)

    строки = исполнить("пусть счётчик равно нулю.\n"
                       "увеличить счётчик на три.\n"
                       "сказать счётчик.\n"
                       "отнять один от счётчика.\n"
                       "сказать счётчик.")
    проверить("увеличить и отнять", строки == ["3", "2"], строки)

    строки = исполнить("пусть слова равно перечень().\n"
                       "добавить в слова Хлеб.\n"
                       "добавить в слова Соль.\n"
                       "сказать длина слов.\n"
                       "сказать взять из слов ноль.")
    проверить("добавить в перечень и длина", строки == ["2", "Хлеб"], строки)

    ok, текст = ждём_ошибку("сказать безымянное.", ОшибкаСмысла)
    проверить("неизвестное имя объясняется", ok and "речь" in текст, текст)


def проверки_смысла():
    print("Смысл и вычисления")
    строки = исполнить("сказать два плюс три умножить на четыре.")
    проверить("приоритет умножения", строки == ["14"], строки)
    строки = исполнить("сказать (два плюс три) умножить на четыре.")
    проверить("скобки законны", строки == ["20"], строки)
    строки = исполнить("сказать семь остаток от двух.")
    проверить("остаток", строки == ["1"], строки)
    строки = исполнить("сказать три запятая пять плюс один.")
    проверить("дробь словом «запятая»", строки == ["4,5"], строки)
    строки = исполнить("сказать истина и не ложь.")
    проверить("истина и не ложь", строки == ["да"], строки)
    ok, текст = ждём_ошибку("сказать десять разделить на ноль.", ОшибкаСмысла)
    проверить("делить на ноль нельзя", ok and "ноль" in текст, текст)


def проверки_замыслов():
    print("Замыслы и правила")
    строки = исполнить("пусть с равно нулю.\n"
                       "пока с меньше трёх повторять\n"
                       "    увеличить с на один.\n"
                       "конец пока.\n"
                       "сказать с.")
    проверить("пока", строки == ["3"], строки)

    строки = исполнить("повторить три раза сказать речь ура конец речи. конец повтора.")
    проверить("повторить три раза", строки == ["ура"] * 3, строки)

    строки = исполнить("пусть п равно перечень(один, два, три).\n"
                       "для каждого числа из п повторять\n"
                       "    если число больше двух то прервать. конец если.\n"
                       "    сказать число.\n"
                       "конец для.")
    проверить("прервать внутри для каждого", строки == ["1", "2"], строки)

    строки = исполнить("правило факториал принимает величину повторять\n"
                       "    если величина не больше одного то вернуть один. конец если.\n"
                       "    вернуть величина умножить на факториал(величина минус один).\n"
                       "конец правила.\n"
                       "сказать факториал(пять).")
    проверить("правило с возвратом и вложенностью", строки == ["120"], строки)

    строки = исполнить("правило удвоить принимает число повторять\n"
                       "    сказать число умножить на два.\n"
                       "конец правила.\n"
                       "как удвоить с двадцать один.")
    проверить("естественная форма «как» вызывает правило с аргументом",
              строки == ["42"], строки)

    строки = исполнить("если ложь то сказать да. иначе если истина то сказать Может. "
                       "иначе сказать нет. конец если.")
    проверить("иначе если", строки == ["Может"], строки)


def проверки_совместимого_синтаксиса():
    print("Совместимая русская запись")

    строки = исполнить(
        "пусть значение = 4;\n"
        "если (значение >= 4) {\n"
        "    сказать(значение + 1);\n"
        "} иначе {\n"
        "    сказать(0);\n"
        "}\n"
    )
    проверить("фигурные блоки, скобки и знаки действий",
              строки == ["5"], строки)

    строки = исполнить(
        "пусть значение = 2\n"
        "если (значение < 3):\n"
        "    сказать(значение)\n"
        "иначе:\n"
        "    сказать(0)\n"
    )
    проверить("блоки по отступам и ветвь иначе",
              строки == ["2"], строки)

    строки = исполнить(
        "целое сумма(целое первое, целое второе) {\n"
        "    вернуть(первое + второе);\n"
        "}\n"
        "сказать(сумма(2, 3));\n"
    )
    проверить("объявление типового правила и возврат в скобках",
              строки == ["5"], строки)

    строки = исполнить(
        "пусть результат = (2 + 3) * 4;\n"
        "сказать(результат);\n"
    )
    проверить("группировка выражений и приоритет действий",
              строки == ["20"], строки)

    строки = исполнить(
        "пусть числа = [1, 2, 3];\n"
        "сказать(числа);\n"
    )
    проверить("квадратная запись перечня",
              строки == ["перечень(1, 2, 3)"], строки)

    строки = исполнить(
        "пусть счёт = 0;\n"
        "счёт += 2;\n"
        "счёт++;\n"
        "счёт -= 1;\n"
        "сказать(счёт);\n"
    )
    проверить("составные присваивания и увеличение на единицу",
              строки == ["2"], строки)


