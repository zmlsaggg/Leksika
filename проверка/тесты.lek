                            ОшибкаСмысла)
    проверить("нет такого номера", ok and "номера" in текст, текст)


def проверки_заплаток():
    print("Заплатки")
    было = патчи.ПАПКА
    временно = tempfile.mkdtemp(prefix="лексус-проверка-")
    патчи.ПАПКА = временно
    патчи.БИБЛИОТЕКА = os.path.join(временно, "библиотека")
    патчи.СПИСОК = os.path.join(временно, "патчи.список")
    try:
        папка = os.path.join(временно, "исходники")
        os.makedirs(папка)
        исходник = os.path.join(папка, "проба.lek")
        with open(исходник, "w", encoding="utf-8") as файл:
            файл.write("сказать речь проба конец речи.\n")
        выход, манифест = патчи.собрать(исходник, "проба", "1.0.0", "проверка")
        проверить("заплатка собрана", os.path.isfile(выход))
        проверить("в манифесте есть отпечатки", манифест["файлы"][0]["отпечаток"])
        манифест2, место = патчи.наложить(выход)
        проверить("заплатка наложена", os.path.isdir(место))
        проверить("заплатка видна в списке", "проба" in патчи.список())
        проверить("точка входа находится", патчи.путь_программы("проба") is not None)
        патчи.откатить("проба")
        проверить("заплатка снята", "проба" not in патчи.список())
        if os.path.isfile(выход):
            os.unlink(выход)
    finally:
        патчи.ПАПКА = было
        патчи.БИБЛИОТЕКА = os.path.join(было, "библиотека")
        патчи.СПИСОК = os.path.join(было, "патчи.список")
        shutil.rmtree(временно, ignore_errors=True)


def проверки_своего():
    print("Своё хранение, упаковка и форматы")
    данные = {"имя": "проба", "числа": [1, 2.5], "флаг": True, "пусто": None,
              "вложено": {"ключ": "значение с \"кавычкой\""}}
    текст = хранение.записать(данные)
    проверить("своё хранение пишет и читает", хранение.прочитать(текст) == данные)
    проверить("значения по-русски", "истина" in текст and "ничто" in текст)

    проба = tempfile.NamedTemporaryFile(suffix=".патч", delete=False)
    проба.close()
    try:
        упаковка.упаковать([("а.текст", "привет".encode("utf-8")), ("папка/б.текст", "пока")], проба.name)
        проверить("упаковка читает свои имена",
                  упаковка.имена(проба.name) == ["а.текст", "папка/б.текст"])
        проверить("упаковка отдаёт те же байты",
                  упаковка.прочитать(проба.name, "а.текст") == "привет".encode("utf-8"))
    finally:
        os.unlink(проба.name)

    проверить("отпечаток устойчив",
              упаковка.отпечаток("привет".encode("utf-8")) == упаковка.отпечаток("привет".encode("utf-8")))
    проверить("отпечаток ловит правку",
              упаковка.отпечаток("привет".encode("utf-8")) != упаковка.отпечаток("привет!".encode("utf-8")))

    проверить("формат переводится на русское", форматы.перевод("склад.png") == "склад.пнг")
    проверить("формат возвращается обратно", форматы.обратно("склад.пнг") == "склад.png")
    проверить("расширение заплатки короткое", патчи.РАСШИРЕНИЕ == ".патч")
    проверить("толк формата находится", форматы.толк("песня.mp3") == "звук")
    проверить("незнакомый формат не трогается", форматы.перевод("проба.лек") == "проба.лек")


def проверить_машину(код, вход=""):
    дерево = грамматика.разобрать(код)
    а, б = [], []
    очередь_а = list(вход.split("\n")) if вход else []
    очередь_б = list(вход.split("\n")) if вход else []
    исполнитель.Исполнитель(вывод=а.append,
                            ввод=lambda п="": очередь_а.pop(0)).исполнить(дерево)
    машина.исполнить(дерево, исполнитель.Исполнитель(
        вывод=б.append, ввод=lambda п="": очередь_б.pop(0)))
    return а, б


def проверки_машины():
    print("Байткод и машина")
    программа = байткод.собрать(грамматика.разобрать("сказать речь привет конец речи.\n"))
    проверить("байткод собирается", программа.размер() >= 2)
    проверить("в байткоде есть конец", программа.вид(программа.размер() - 1) == "конец")
    проверить("есть таблица стековых выражений", len(программа.выражения) > 0)

    def только_данные(значение):
        if isinstance(значение, грамматика.Узел):
            return False
        if isinstance(значение, (tuple, list)):
            return all(только_данные(часть) for часть in значение)
        if isinstance(значение, dict):
            return all(только_данные(ключ) and только_данные(часть)
                       for ключ, часть in значение.items())
        return True

    дерево = грамматика.разобрать(
        "пусть сумма равно два плюс три.\n"
        "сказать речь Значение (сумма) конец речи.\n"
        "если сумма больше два то сказать истина. конец если.\n"
    )
    стековая_программа = байткод.собрать(дерево)
    проверить("команды и выражения не содержат объектов AST",
              только_данные((стековая_программа.команды,
                             стековая_программа.выражения,
                             стековая_программа.правила)))

    код = """правило шаг принимает число повторять
    пусть итог равно нулю.
    пока итог меньше число повторять
        увеличить итог на один.
        если итог равно два то
            продолжить.
        конец если.
        если итог больше трёх то
            прервать.
        конец если.
    конец пока.
    вернуть итог.
конец правила.
сказать речь Шаг: (шаг(десять)). конец речи.
для каждого предмет из перечень(Хлеб, Сыр) повторять
    сказать речь Предмет: (предмет) конец речи.
конец для.
повторить два раза
    сказать речь Ещё раз. конец речи.
конец повтора.
"""
    а, б = проверить_машину(код)
    проверить("машина считает как дерево", а == б, f"{а} ≠ {б}")
    проверить("машина видит прерывание", "Шаг: 4." in б, str(б))

    а, б = проверить_машину(
        "правило сумма принимает первое и второе повторять\n"
        "    вернуть первое плюс второе.\n"
        "конец правила.\n"
        "пусть числа равно перечень().\n"
        "добавить в числа сумма(два, три).\n"
        "сказать длина чисел.\n"
    )
    проверить("встроенная команда вызывает скомпилированное правило",
              а == б and б == ["1"], f"{а} ≠ {б}")

    а, б = проверить_машину("пусть число равно семи.\n"
                            "если число больше пяти то\n"
                            "    сказать речь Больше. конец речи.\n"
                            "иначе\n"
                            "    сказать речь Меньше. конец речи.\n"
                            "конец если.\n")
    проверить("машина разбирает если и иначе", а == б and б == ["Больше."])

    а, б = проверить_машину("спросить имя.\nсказать речь Привет, (имя)! конец речи.\n", "мир")
    проверить("машина спрашивает", а == б and б == ["Привет, мир!"])


def проверки_разума():
    print("Разум языка")
    мозг = разум.загрузить()
    проверить("веса на месте", мозг.вес() > 0)
    проверить("классов двенадцать", len(мозг.классы) == 12)
    лучший = мозг.разобрать("книгами", "")[0]
    проверить("творительный падеж узнан", (лучший[0][1], лучший[0][2]) == ("тв", "мн"),
              str(лучший))
    лучший = мозг.разобрать("столе", "")[0]
    проверить("предложный падеж узнан", лучший[0][1] == "пр", str(лучший))
    проверить("род узнан", мозг.род("тетрадь") == "ж" and мозг.род("окно") == "с")

    своя = модель.собрать_модель({"умная_модель": "встроенная"})
    проверить("модель берёт свою сеть", своя.нейронная)
    табличная = модель.собрать_модель({"умная_модель": "табличная"})
    проверить("табличная модель осталась", not табличная.нейронная)


def проверки_доводов():
    print("Разбор доводов и файлы")
    схема = {
        "запустить": [("файл", доводы.ОБЯЗАТЕЛЬНЫЙ, None),
                      ("остальное", доводы.ХВОСТ, None),
                      ("молча", доводы.КЛЮЧ, False)],
        "словарь": [("слово", доводы.НЕОБЯЗАТЕЛЬНЫЙ, None)],
    }
    разборщик = доводы.Разборщик(схема)
    набор = разборщик.разобрать(["запустить", "файл.lek", "--молча", "раз", "два"])
    проверить("доводы читают дело", набор.дело == "запустить")
    проверить("доводы читают ключ", набор.молча is True)
    проверить("доводы читают файл", набор.файл == "файл.lek")
    проверить("доводы читают хвост", набор.остальное == ["раз", "два"])
    проверить("необязательный остаётся пустым",
              разборщик.разобрать(["словарь"]).слово is None)
    try:
        разборщик.разобрать(["нетакого"])
        проверить("чужое дело отвергается", False)
    except доводы.ОшибкаДоводов:
        проверить("чужое дело отвергается", True)
    набор = разборщик.разобрать(["--справка"])
    проверить("справка поднимается", набор.справка)

    временно = tempfile.mkdtemp(prefix="лексус-файлы-")
    try:
        путь = os.path.join(временно, "папка", "проба.текст")
        файлы.записать(путь, "привет")
        проверить("свой слой пишет файл", файлы.прочитать(путь) == "привет")
        проверить("свой слой видит каталог", файлы.каталог(os.path.dirname(путь)))
        проверить("свой слой меняет конец", файлы.конец(путь) == "текст")
        файлы.копировать(путь, os.path.join(временно, "копия.текст"))
        проверить("свой слой копирует",
                  файлы.прочитать(os.path.join(временно, "копия.текст")) == "привет")
        файлы.удалить_дерево(временно)
        проверить("свой слой удаляет дерево", not файлы.есть(временно))
    finally:
        if os.path.isdir(временно):
            файлы.удалить_дерево(временно)


def проверки_вопросов():
    print("Короткие вопросы")
    модуль = runpy.run_path(os.path.join(КОРЕНЬ, "лексус.lek"))
    ответить = модуль["_ответить_на_вопрос"]
    выключена = модель.ВыключеннаяМодель()
    проверить("президент отвечает без модели", ответить("кто президент", выключена) == "Путин")
    проверить("самый богатый отвечает без модели", ответить("кто самый богатый", выключена) == "Маск")
    проверить("владелец Meta распознаётся", ответить("кто мета", выключена) == "Цукерберг")
    проверить("Facebook распознаётся", ответить("кто фейсбук", выключена) == "Цукерберг")
    цены = ответить("цена рубль доллар газ нефть", выключена) or ""
    проверить("офлайн-цены содержат валюту, газ и нефть",
              "90 ₽" in цены and "MMBtu" in цены and "баррель" in цены)
    проверить("ценовой фолбек помечен как ориентир", "не актуальные" in цены)
    проверить("префикс самый требует внешнюю модель",
              "Внешняя LLM выключена" in (ответить("самый расскажи о космосе", выключена) or ""))

    class ЛокальнаяМодель:
        имя = "внешняя"
        доступна = True
        разрешить_поиск_в_сети = False
        def толковать(self, запрос):
            return "локальный ответ"

    старый_поиск = ответить.__globals__["_поиск_в_сети"]
    вызовы = []
    def пробный_поиск(запрос):
        вызовы.append(запрос)
        return []
    ответить.__globals__["_поиск_в_сети"] = пробный_поиск
    try:
        ответить("самый объясни локальную обработку", ЛокальнаяМодель())
        проверить("онлайн-поиск выключен без явного разрешения", not вызовы)
        локальная = ЛокальнаяМодель()
        локальная.разрешить_поиск_в_сети = True
        ответить("самый объясни локальную обработку", локальная)
        проверить("онлайн-поиск включается только по разрешению", len(вызовы) == 1)
    finally:
        ответить.__globals__["_поиск_в_сети"] = старый_поиск


def проверки_примеров():
    print("Примеры")
    папка = os.path.join(КОРЕНЬ, "примеры")
    for имя in sorted(os.listdir(папка)):
        if not имя.endswith(".lek"):
            continue
        with open(os.path.join(папка, имя), encoding="utf-8") as файл:
            текст = файл.read()
        try:
            грамматика.разобрать(текст, имя)
            проверить(f"пример {имя} разбирается", True)
        except Exception as ошибка:
            проверить(f"пример {имя} разбирается", False, f"{ошибка}")


def проверки_загрузчика():
    print("загрузчик частей")
    проверить("загрузчик частей поднят", загрузка is not None)
    проверить("искатель стоит первым",
              type(sys.meta_path[0]).__name__ == "Искатель")
    проба = tempfile.NamedTemporaryFile("w", suffix=".lek", delete=False,
                                        encoding="utf-8")
    проба.write("ЗНАЧЕНИЕ = 42\n")
    проба.close()
    часть = загрузка.загрузить(проба.name, "проба")
    проверить("часть грузится без импорта", getattr(часть, "ЗНАЧЕНИЕ", 0) == 42)
    os.unlink(проба.name)
    файл, места = загрузка.найти("лексика", [КОРЕНЬ])
    проверить("пакет находится по путям поиска",
              файл is not None and места == [os.path.join(КОРЕНЬ, "лексика")])
    проверить("чужие имена не трогаются",
              загрузка.найти("json", [os.path.dirname(json.__file__)])[0] is None)


def main():
    проверки_письма()
    проверки_морфологии()
    проверки_падежей()
    проверки_смысла()
    проверки_замыслов()
    проверки_совместимого_синтаксиса()
    проверки_речи()
    проверки_словарей()
    проверки_заплаток()
    проверки_примеров()
    проверки_загрузчика()
    проверки_своего()
    проверки_машины()
    проверки_разума()
    проверки_доводов()
    проверки_вопросов()
    print()
    print(f"пройдено: {ПРОЙДЕНО}, провалено: {ПРОВАЛЕНО}")
    return 0 if ПРОВАЛЕНО == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
