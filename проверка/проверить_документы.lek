#!/usr/bin/env python3

import os
import re
import sys


ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
КОРЕНЬ = os.path.dirname(ЗДЕСЬ)
sys.path.insert(0, КОРЕНЬ)

if not getattr(sys, "_лексика_загрузка", False):
    _загрузка = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_загрузка, encoding="utf-8") as _файл:
        exec(compile(_файл.read(), _загрузка, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _загрузка})


from лексика import грамматика, лексер, профили

КУСОК = re.compile(r"```лексика\n(.*?)```", re.S)
# Все профили, которые лексер умеет включать. Кусок документа проверяется в
# каждом режиме: читатель может включить 18+ или зумер и получить другой язык.
ВСЕ_ПРОФИЛИ = (
    {},
    {"взрослая_лексика": True},
    {"зумер_лексика": True},
    {"взрослая_лексика": True, "зумер_лексика": True},
)


последняя_ошибка = [""]


def проверить_кусок(кусок, имя):
    """Возвращает режимы, в которых кусок разбирается; запоминает ошибку."""
    годных = []
    for режим in ВСЕ_ПРОФИЛИ:
        try:
            лексер.установить_профильные_алиасы(профили.алиасы_команд(режим))
            грамматика.разобрать(кусок, имя)
            годных.append(режим)
        except Exception as ошибка:  # noqa: BLE001 — нужен текст для отчёта
            последняя_ошибка[0] = str(ошибка)
    лексер.установить_профильные_алиасы({})
    return годных


def main():
    папка = os.path.join(КОРЕНЬ, "документы")
    файлы = [os.path.join(КОРЕНЬ, "читай.lek")]
    файлы += [os.path.join(папка, имя) for имя in sorted(os.listdir(папка))
              if имя.endswith(".md")]
    файлы += [os.path.join(КОРЕНЬ, "README.md")]

    всего, ошибок, профильных = 0, 0, 0
    for путь in файлы:
        if not os.path.isfile(путь):
            continue
        with open(путь, encoding="utf-8") as файл:
            текст = файл.read()
        куски = КУСКИ = КУСОК.findall(текст) if путь.endswith(".md") else [текст]
        for номер, кусок in enumerate(КУСКИ, 1):
            if "..." in кусок:
                continue
            всего += 1
            # Кусок может быть написан на профильном наречии. Тогда он обязан
            # разбираться хотя бы в одном режиме, а режим указывается в отчёте:
            # молча пропускать такие куски значило бы не проверять документацию.
            годных = проверить_кусок(кусок, f"{os.path.basename(путь)}#{номер}")
            if all(режим for режим in годных):
                профильных += 1
            if not годных:
                ошибок += 1
                ошибка = последняя_ошибка[0]
                print(f"  ОШИБКА  {os.path.basename(путь)} кусок {номер}: {ошибка}")
    print(f"проверено кусков: {всего}, ошибок: {ошибок}, из них только в разговорном профиле: {профильных}")
    return 0 if ошибок == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
