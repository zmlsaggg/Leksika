#!/usr/bin/env python3

import os
import re
import sys


ЗДЕСЬ = os.path.dirname(os.path.abspath(__file__))
КОРЕНЬ = os.path.dirname(ЗДЕСЬ)
sys.path.insert(0, КОРЕНЬ)

if not getattr(sys, "_лексика_загрузка", False):
    _загрузка = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_загрузка, encoding="utf-8") as _файл:
        exec(compile(_файл.read(), _загрузка, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _загрузка})


from лексика import грамматика

КУСОК = re.compile(r"```лексика\n(.*?)```", re.S)
# Все режимы, в которые читатель может попасть: базовый и три разговорных.
# Кусок документа обязан разбираться хотя бы в одном, а отчёт честно называет
# те, что годны только с профилем, — молча пропускать их нельзя.
ВСЕ_ПРОФИЛИ = (
    {},
    {"взрослая_лексика": True},
    {"зумер_лексика": True},
    {"взрослая_лексика": True, "зумер_лексика": True},
)


def проверить_кусок(кусок, имя):
    """Возвращает список режимов, в которых кусок разбирается."""
    годных = []
    for режим in ВСЕ_ПРОФИЛИ:
        try:
            грамматика.разобрать(кусок, имя, профильные_алиасы=режим)
            годных.append(режим)
        except Exception:  # noqa: BLE001 — ошибка нужна только для отчёта ниже
            pass
    return годных


def ошибка_куска(кусок, имя):
    try:
        грамматика.разобрать(кусок, имя)
    except Exception as ошибка:  # noqa: BLE001
        return str(ошибка)
    return "неизвестная ошибка"


def main():
    папка = os.path.join(КОРЕНЬ, "документы")
    файлы = [os.path.join(КОРЕНЬ, "читай.lek")]
    файлы += [os.path.join(папка, имя) for имя in sorted(os.listdir(папка))
              if имя.endswith(".md")]
    файлы += [os.path.join(КОРЕНЬ, "README.md")]

    всего, ошибок, профильных = 0, 0, 0
    for путь in файлы:
        if not os.path.isfile(путь):
            continue
        with open(путь, encoding="utf-8") as файл:
            текст = файл.read()
        куски = КУСОК.findall(текст) if путь.endswith(".md") else [текст]
        for номер, кусок in enumerate(куски, 1):
            if "..." in кусок:
                continue
            всего += 1
            имя = f"{os.path.basename(путь)}#{номер}"
            годных = проверить_кусок(кусок, имя)
            if not годных:
                ошибок += 1
                print(f"  ОШИБКА  {os.path.basename(путь)} кусок {номер}: {ошибка_куска(кусок, имя)}")
            elif all(годных):
                профильных += 1
    print(f"проверено кусков: {всего}, ошибок: {ошибок}, "
          f"из них только в разговорном профиле: {профильных}")
    return 0 if ошибок == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
