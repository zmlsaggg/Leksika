#!/usr/bin/env python3

import os
import tempfile
import sys

КОРЕНЬ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, КОРЕНЬ)
if not getattr(sys, "_лексика_загрузка", False):
    _путь = os.path.join(КОРЕНЬ, "лексика", "загрузка.lek")
    with open(_путь, encoding="utf-8") as _файл:
        exec(compile(_файл.read(), _путь, "exec"),
             {"__name__": "лексика.загрузка", "__file__": _путь})

from лексика import безопасность, секреты


def проверка(название, условие):
    if not условие:
        raise AssertionError("провалена проверка: " + название)
    print("  верно:", название)


def main():
    with tempfile.TemporaryDirectory(prefix="лексус-безопасность-") as каталог:
        безопасность.ПАПКА = каталог
        безопасность.ФАЙЛ_ПОЛИТИКИ = os.path.join(каталог, "политика.без")
        безопасность.ФАЙЛ_АУДИТА = os.path.join(каталог, "аудит.логе")

        безопасность.сохранить({
            "режим": "защищённый",
            "сеть": False,
            "разрешённые_пути": [каталог],
            "разрешённые_секреты": ["ЛЕКСУС_ТЕСТОВЫЙ_СЕКРЕТ"],
            "аудит": True,
        })

        открытый = os.path.join(каталог, "разрешённый.txt")
        закрытый = os.path.join(os.path.dirname(каталог), "запрещённый.txt")
        with open(открытый, "w", encoding="utf-8") as файл:
            файл.write("тест")

        проверка("защищённый режим включён", безопасность.защищённый())
        проверка("файл внутри корня разрешён",
                 безопасность.разрешить_файл(открытый, "чтение"))
        проверка("файл вне корня запрещён",
                 not безопасность.разрешить_файл(закрытый, "чтение"))
        проверка("сеть по умолчанию запрещена",
                 not безопасность.разрешить_сеть("https://bank.example/api"))
        безопасность.сохранить({"сеть": True})
        проверка("защищённая сеть без allowlist запрещена",
                 not безопасность.разрешить_сеть("https://bank.example/api"))
        безопасность.сохранить({"разрешённые_узлы": ["bank.example"]})
        проверка("разрешённый узел проходит сетевой allowlist",
                 безопасность.разрешить_сеть("https://bank.example/api"))
        проверка("неразрешённый процесс запрещён",
                 not безопасность.разрешить_процесс("curl"))
        проверка("процесс без allowlist запрещён",
                 not безопасность.разрешить_процесс("llama-cli"))
        безопасность.сохранить({"разрешённые_процессы": ["llama-cli"]})
        проверка("разрешённый процесс проходит allowlist",
                 безопасность.разрешить_процесс("llama-cli"))
        проверка("внешний модуль без разрешения запрещён",
                 not безопасность.разрешить_модуль("numpy"))
        проверка("внешний модуль без allowlist запрещён",
                 not безопасность.разрешить_модуль("llama_cpp"))
        безопасность.сохранить({"разрешённые_модули": ["llama_cpp"]})
        проверка("разрешённый внешний модуль проходит allowlist",
                 безопасность.разрешить_модуль("llama_cpp"))
        проверка("секрет без раскрытия значения",
                 not секреты.есть("НЕСУЩЕСТВУЮЩИЙ_СЕКРЕТ"))
        os.environ["ЛЕКСУС_ТЕСТОВЫЙ_СЕКРЕТ"] = "секретное-значение"
        проверка("разрешённый секрет доступен",
                 секреты.получить("ЛЕКСУС_ТЕСТОВЫЙ_СЕКРЕТ") == "секретное-значение")
        del os.environ["ЛЕКСУС_ТЕСТОВЫЙ_СЕКРЕТ"]

        события = безопасность.последние_события(100)
        проверка("аудит записывается", len(события) >= 8)
        хеш = события[-1].split("\t")[-1]
        проверка("последний аудит имеет SHA-256 цепочку",
                 len(хеш) == 64 and all(знак in "0123456789abcdef" for знак in хеш))
        цел, количество, сообщение = безопасность.проверить_аудит()
        проверка("аудит проходит внутреннюю проверку", цел and количество >= 8)
        with open(безопасность.ФАЙЛ_АУДИТА, encoding="utf-8") as файл:
            журнал = файл.read()
        with open(безопасность.ФАЙЛ_АУДИТА, "w", encoding="utf-8") as файл:
            файл.write(журнал.replace("разрешено", "изменено", 1))
        проверка("изменение записи обнаруживается", not безопасность.проверить_аудит()[0])

    print("пройдено: защита, allowlist, секреты и аудит")


if __name__ == "__main__":
    main()
